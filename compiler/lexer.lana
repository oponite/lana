fn token(kind, text, line, column) { return [kind, text, line, column]; }

fn lex_error(line, column, message) {
    let location = string_concat("lex error at line ", number_to_string(line));
    location = string_concat(location, " column ");
    location = string_concat(location, number_to_string(column));
    assert(false, string_concat(location, string_concat(": ", message)));
    return null;
}

fn is_space(byte) {
    if (byte == 32) { return true; }
    if (byte == 9) { return true; }
    if (byte == 10) { return true; }
    if (byte == 13) { return true; }
    return false;
}

fn is_digit(byte) { if (byte < 48) { return false; } if (byte > 57) { return false; } return true; }

fn is_letter(byte) {
    if (byte == 95) { return true; }
    if (byte >= 65) { if (byte <= 90) { return true; } }
    if (byte >= 97) { if (byte <= 122) { return true; } }
    return false;
}

// The scanners below run once per source byte, so they keep their loops minimal:
// columns are derived from the byte offset when a scan ends, and the loop flag
// carries the bounds check (the language has no `break`).
fn skip_comment(source, offset, column) {
    let length = string_length(source); let start = offset; let scanning = offset < length;
    while (scanning) {
        if (string_byte_at(source, offset) == 10) { scanning = false; } else { offset = offset + 1; scanning = offset < length; }
    }
    return [offset, column + offset - start];
}

fn scan_identifier(source, offset, line, column, classes) {
    let length = string_length(source); let start = offset;
    offset = offset + 1; let scanning = offset < length;
    while (scanning) {
        if (classes[string_byte_at(source, offset)] >= 2) { offset = offset + 1; scanning = offset < length; } else { scanning = false; }
    }
    return [offset, column + offset - start, token("identifier", string_slice(source, start, offset), line, column)];
}

fn scan_number(source, offset, line, column, classes) {
    let length = string_length(source); let start = offset;
    let seen_dot = false; let scanning = true;
    while (scanning) {
        if (offset >= length) { scanning = false; } else {
            let byte = string_byte_at(source, offset);
            if (classes[byte] == 2) { offset = offset + 1; } else {
                if (byte == 46) {
                    if (seen_dot) { scanning = false; } else { seen_dot = true; offset = offset + 1; }
                } else { scanning = false; }
            }
        }
    }
    if (offset < length) {
        let marker = string_byte_at(source, offset);
        let exponent = false;
        if (marker == 69) { exponent = true; }
        if (marker == 101) { exponent = true; }
        if (exponent) {
            offset = offset + 1;
            if (offset < length) {
                let sign = string_byte_at(source, offset);
                if (sign == 43) { offset = offset + 1; }
                else { if (sign == 45) { offset = offset + 1; } }
            }
            if (offset >= length) { lex_error(line, column, "expected exponent digits"); }
            if (!is_digit(string_byte_at(source, offset))) { lex_error(line, column, "expected exponent digits"); }
            let scanning_exponent = true;
            while (scanning_exponent) {
                if (offset >= length) { scanning_exponent = false; }
                else {
                    if (is_digit(string_byte_at(source, offset))) { offset = offset + 1; }
                    else { scanning_exponent = false; }
                }
            }
        }
    }
    return [offset, column + offset - start, token("number", string_slice(source, start, offset), line, column)];
}

fn scan_string(source, offset, line, column) {
    let length = string_length(source); let start = offset;
    offset = offset + 1; let content_start = offset;
    let escaped = false; let scanning = true; let value = "";
    while (scanning) {
        if (offset >= length) { lex_error(line, column, "unterminated string literal"); }
        let byte = string_byte_at(source, offset);
        if (escaped) { escaped = false; } else {
            if (byte == 92) { escaped = true; } else {
                if (byte == 34) {
                    value = string_unescape(string_slice(source, content_start, offset));
                    scanning = false;
                } else { if (byte == 10) { lex_error(line, column, "unterminated string literal"); } }
            }
        }
        offset = offset + 1;
    }
    return [offset, column + offset - start, token("string", value, line, column)];
}

fn lex_utf8_width(byte) {
    if (byte >= 240) { return 4; }
    if (byte >= 224) { return 3; }
    if (byte >= 192) { return 2; }
    return 1;
}

fn scan_symbol(source, offset, line, column) {
    let length = string_length(source); let text = string_slice(source, offset, offset + 1);
    // Every two-character operator ends in '=' or '>'; checking that byte first skips
    // the pair slice for other symbols and never splits a multi-byte character.
    let pairable = false;
    if (offset + 1 < length) {
        let next = string_byte_at(source, offset + 1);
        if (next == 61) { pairable = true; } if (next == 62) { pairable = true; }
    }
    if (pairable) {
        let pair = string_slice(source, offset, offset + 2);
        if (pair == "->") { text = pair; } if (pair == "==") { text = pair; }
        if (pair == "!=") { text = pair; } if (pair == "<=") { text = pair; } if (pair == ">=") { text = pair; }
        if (pair == "=>") { text = pair; }
    }
    let size = string_length(text);
    return [offset + size, column + size, token("symbol", text, line, column)];
}

fn lex(source) {
    let classes = byte_classes();
    let tokens = array_new(0); let length = string_length(source); let offset = 0; let line = 1; let column = 1;
    while (offset < length) {
        let byte = string_byte_at(source, offset);
        let kind = classes[byte];
        if (byte == 32) {
            // Indentation dominates whitespace; consume a run of spaces in one tight loop.
            let start = offset; offset = offset + 1; let spacing = offset < length;
            while (spacing) {
                if (string_byte_at(source, offset) == 32) { offset = offset + 1; spacing = offset < length; } else { spacing = false; }
            }
            column = column + offset - start;
        } else { if (kind == 1) {
            if (byte == 10) { line = line + 1; column = 1; } else { column = column + 1; }
            offset = offset + 1;
        } else {
            let comment = false;
            if (byte == 35) { comment = true; }
            if (byte == 47) { if (offset + 1 < length) { if (string_byte_at(source, offset + 1) == 47) { comment = true; } } }
            if (comment) {
                let skipped = skip_comment(source, offset, column); offset = skipped[0]; column = skipped[1];
            } else {
                let scanned = null;
                if (kind == 3) { scanned = scan_identifier(source, offset, line, column, classes); } else {
                    if (kind == 2) { scanned = scan_number(source, offset, line, column, classes); } else {
                        if (byte == 34) { scanned = scan_string(source, offset, line, column); }
                        else {
                            if (byte >= 128) {
                                let character = string_slice(source, offset, offset + lex_utf8_width(byte));
                                lex_error(line, column, string_concat("unexpected character '", string_concat(character, "'")));
                            }
                            scanned = scan_symbol(source, offset, line, column);
                        }
                    }
                }
                offset = scanned[0]; column = scanned[1]; array_push(tokens, scanned[2]);
            }
        } }
    }
    array_push(tokens, token("eof", "<eof>", line, column)); return tokens;
}

fn byte_classes() {
    let classes = array_new(0); let byte = 0;
    while (byte < 256) {
        let kind = 0;
        if (is_space(byte)) { kind = 1; }
        if (is_digit(byte)) { kind = 2; }
        if (is_letter(byte)) { kind = 3; }
        array_push(classes, kind); byte = byte + 1;
    }
    return classes;
}
