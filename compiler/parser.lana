import "./lexer.lana" as lexer;
import "./syntax.lana" as syntax;

fn parser_new(source) {
    let tokens = lexer.lex(source);
    return [tokens, 0, tokens[0]];
}
fn current(parser) { return parser[2]; }
fn current_text(parser) { return current(parser)[1]; }
fn current_line(parser) { return current(parser)[2]; }
fn current_column(parser) { return current(parser)[3]; }
fn matches(parser, text) {
    let value = current(parser);
    if (value[0] == "string") { return false; }
    return value[1] == text;
}

fn take(parser) {
    let value = current(parser);
    parser[1] = parser[1] + 1;
    if (parser[1] < array_length(parser[0])) { parser[2] = parser[0][parser[1]]; }
    return value;
}

fn parse_error(token, message) {
    let location = string_concat("parse error at line ", number_to_string(token[2]));
    location = string_concat(location, " column ");
    location = string_concat(location, number_to_string(token[3]));
    assert(false, string_concat(location, string_concat(": ", message)));
    return null;
}

fn expect_token(parser, text) {
    let value = take(parser);
    if (value[1] != text) {
        parse_error(value, string_concat("expected ", string_concat(text, string_concat(", got ", value[1]))));
    }
    return value;
}

fn parse_call_arguments(parser, name) {
    let allowed = named_arg_for(name);
    let values = array_new(0); expect_token(parser, "(");
    while (!matches(parser, ")")) {
        let token = current(parser);
        if (token[0] == "eof") { parse_error(token, "expected argument or closing parenthesis"); }
        if (parser[0][parser[1] + 1][1] == ":") {
            if (allowed == null) { parse_error(token, "named arguments are not supported for this call"); }
            if (token[0] != "identifier") { parse_error(token, string_concat("expected ", string_concat(allowed, string_concat(": for this call")))); }
            if (token[1] != allowed) { parse_error(token, string_concat("expected ", string_concat(allowed, string_concat(": for this call")))); }
            if (array_length(values) != named_arg_position(name)) {
                let ordinal = "second";
                if (named_arg_position(name) == 2) { ordinal = "third"; }
                parse_error(token, string_concat(allowed, string_concat(": must be the ", string_concat(ordinal, string_concat(" and final argument")))));
            }
            take(parser); take(parser);
            array_push(values, parse_expression(parser));
            if (!matches(parser, ")")) { parse_error(current(parser), string_concat(allowed, string_concat(": must be the final argument"))); }
        } else { array_push(values, parse_expression(parser)); }
        if (!matches(parser, ")")) { expect_token(parser, ",");
            if (matches(parser, ")")) { parse_error(current(parser), "expected argument after comma"); }
        }
    }
    expect_token(parser, ")"); return values;
}

fn parse_arguments(parser) { return parse_call_arguments(parser, null); }
fn is_tensor_reduction(name) {
    if (name == "sum") { return true; } if (name == "mean") { return true; }
    if (name == "max") { return true; } return name == "min";
}
fn named_arg_for(name) {
    if (is_tensor_reduction(name)) { return "axis"; }
    if (name == "tensor") { return "dtype"; }
    if (name == "zeros") { return "dtype"; }
    if (name == "ones") { return "dtype"; }
    if (name == "eye") { return "dtype"; }
    if (name == "matmul") { return "out_dtype"; }
    return null;
}

// Number of positional arguments that must precede the named argument. Most
// named-arg calls take one positional (the value); matmul takes two (a, b).
fn named_arg_position(name) {
    if (name == "matmul") { return 2; }
    return 1;
}

fn parse_named_values(parser, closing) {
    let entries = array_new(0);
    while (!matches(parser, closing)) {
        let name = take(parser); expect_token(parser, ":");
        array_push(entries, [name[1], parse_expression(parser)]);
        if (!matches(parser, ",")) { return entries; }
        take(parser);
    }
    return entries;
}

fn is_joint_product_kind(kind) { if (kind == "independent") { return true; } return kind == "conditional"; }
fn is_join_operation(text) { if (text == "join") { return true; } return text == "join_all"; }
fn is_history_operation(text) { if (text == "previous") { return true; } if (text == "change") { return true; } return text == "velocity"; }
fn is_information_operation(text) {
    if (text == "append") { return true; } if (text == "sample") { return true; }
    if (text == "project") { return true; } if (text == "condition") { return true; }
    if (text == "resolve") { return true; } if (text == "rename") { return true; }
    if (text == "possibility") { return true; } if (text == "observe") { return true; }
    if (text == "evidence") { return true; } if (text == "assume") { return true; }
    if (text == "derivation") { return true; } return text == "explain";
}

fn parse_correlated(parser, line, column) {
    expect_token(parser, "("); let arguments = array_new(0);
    array_push(arguments, parse_expression(parser));
    while (matches(parser, ",")) { take(parser); array_push(arguments, parse_expression(parser)); }
    expect_token(parser, ")");
    if (matches(parser, "with")) {
        expect_token(parser, "with"); expect_token(parser, "support"); expect_token(parser, ":");
        let names = array_new(0); let index = 0;
        while (index < array_length(arguments)) {
            assert(arguments[index][0] == 21, "correlated finite-law form requires variable names");
            array_push(names, arguments[index][1]); index = index + 1;
        }
        return syntax.finite_joint_node(names, parse_expression(parser), line, column);
    }
    assert(array_length(arguments) == 3, "correlated coefficient form requires exactly three arguments");
    return syntax.correlated_node(arguments[0], arguments[1], arguments[2], line, column);
}

fn parse_joint(parser, line, column) {
    let kind = take(parser)[1]; let names = array_new(0); let values = array_new(0);
    if (kind == "correlated") { return parse_correlated(parser, line, column); }
    assert(is_joint_product_kind(kind), "joint kind must be independent, correlated, or conditional");
    expect_token(parser, "{"); let entries = parse_named_values(parser, "}"); expect_token(parser, "}");
    let index = 0; while (index < array_length(entries)) {
        array_push(names, entries[index][0]); array_push(values, entries[index][1]); index = index + 1;
    }
    assert(array_length(names) > 0, "a joint cannot be empty");
    return syntax.joint_node(kind, names, values, line, column);
}

fn parse_measure(parser, line, column) {
    let source = take(parser)[1]; let basis = ""; let mode = "distribution";
    if (matches(parser, "in")) { take(parser); basis = take(parser)[1]; }
    if (matches(parser, "as")) { take(parser); mode = take(parser)[1]; }
    return syntax.measure_node(source, basis, mode, line, column);
}

fn parse_estimate_measure(parser, line, column) {
    let source = take(parser)[1]; expect_token(parser, "in"); let basis = take(parser)[1];
    expect_token(parser, "as"); let mode = take(parser)[1]; expect_token(parser, "with"); expect_token(parser, "samples"); expect_token(parser, ":");
    return syntax.estimate_measure_node(source, basis, mode, take(parser)[1], line, column);
}

fn parse_attenuate(parser, line, column) {
    let source = parse_expression(parser); expect_token(parser, "by"); let factor = parse_expression(parser);
    return syntax.call_node("attenuate", [source, factor], line, column);
}

fn parse_trace_distance(parser, line, column) {
    let left = parse_expression(parser); let right = parse_expression(parser);
    return syntax.call_node("trace_distance", [left, right], line, column);
}

fn is_append_mode(mode) {
    if (mode == "independent") { return true; }
    if (mode == "redundant") { return true; }
    if (mode == "full_redundancy") { return true; }
    return mode == "complementary";
}

fn parse_append_relationship(parser, line, column) {
    let left = parse_expression(parser); expect_token(parser, "with"); let right = parse_expression(parser);
    expect_token(parser, "as"); let mode = take(parser)[1];
    assert(is_append_mode(mode), "append mode must be independent, redundant, full_redundancy, or complementary");
    let operation = "append";
    if (mode == "redundant") { operation = "append_redundant"; }
    if (mode == "full_redundancy") { operation = "append_full_redundancy"; }
    if (mode == "complementary") { operation = "append_complementary"; }
    let arguments = [left, right];
    if (mode == "redundant") { array_push(arguments, parse_expression(parser)); }
    if (mode == "complementary") { array_push(arguments, parse_expression(parser)); }
    return syntax.information_node(operation, arguments, line, column);
}

fn parse_keyword_primary(parser, text, line, column) {
    if (text == "attenuate") { return parse_attenuate(parser, line, column); }
    if (text == "trace_distance") { return parse_trace_distance(parser, line, column); }
    if (text == "append") { if (!matches(parser, "(")) { return parse_append_relationship(parser, line, column); } }
    if (text == "measure") { if (!matches(parser, "(")) { return parse_measure(parser, line, column); } }
    if (text == "estimate_measure") { return parse_estimate_measure(parser, line, column); }
    if (text == "joint") { return parse_joint(parser, line, column); }
    if (text == "correlated") { return parse_correlated(parser, line, column); }
    if (text == "fork") { let name = take(parser)[1]; return syntax.fork_node(name, parse_arguments(parser), line, column); }
    if (is_join_operation(text)) {
        expect_token(parser, "("); let first = parse_expression(parser);
        // `join(ds, other, key)` is the dataset equi-join; `join(task)` is the
        // task join. Disambiguate by whether a second argument follows.
        if (text == "join") {
            if (matches(parser, ",")) {
                take(parser); let second = parse_expression(parser);
                expect_token(parser, ","); let key = parse_expression(parser);
                expect_token(parser, ")");
                return syntax.call_node("join", [first, second, key], line, column);
            }
        }
        expect_token(parser, ")"); return syntax.join_node(text, first, line, column);
    }
    if (text == "join_timeout") {
        expect_token(parser, "("); let task = parse_expression(parser); expect_token(parser, ","); let timeout = parse_expression(parser); expect_token(parser, ")");
        return syntax.join_timeout_node(task, timeout, line, column);
    }
    if (is_history_operation(text)) { expect_token(parser, "("); let source = take(parser)[1]; expect_token(parser, ")"); return syntax.history_value_node(text, source, line, column); }
    if (is_information_operation(text)) {
        if (matches(parser, "(")) { return syntax.information_node(text, parse_arguments(parser), line, column); }
    }
    if (text == "await") { return syntax.await_node(parse_expression(parser), line, column); }
    return null;
}

fn parse_pattern(parser) {
    if (matches(parser, "_")) { take(parser); return syntax.pattern_wildcard(); }
    if (matches(parser, "unknown")) { take(parser); return syntax.pattern_unknown(); }
    let name = take(parser)[1]; let bindings = array_new(0);
    if (matches(parser, "(")) {
        take(parser);
        if (!matches(parser, ")")) {
            array_push(bindings, take(parser)[1]);
            while (matches(parser, ",")) { take(parser); array_push(bindings, take(parser)[1]); }
        }
        expect_token(parser, ")");
    }
    return syntax.pattern_variant(name, bindings);
}

fn parse_match(parser, line, column) {
    let value = parse_expression(parser); expect_token(parser, "{");
    let arms = array_new(0);
    while (!matches(parser, "}")) {
        let pattern = parse_pattern(parser); expect_token(parser, "=>");
        array_push(arms, syntax.match_arm(pattern, parse_expression(parser)));
        if (matches(parser, ",")) { take(parser); }
    }
    expect_token(parser, "}"); return syntax.match_node(value, arms, line, column);
}

fn parse_shape_dim(parser) {
    let token = take(parser);
    if (token[0] == "number") { return token[1]; }
    return token[1];
}

fn parse_shape_spec(parser) {
    if (matches(parser, "Dynamic")) { take(parser); return ["shape_dynamic"]; }
    if (matches(parser, "[")) {
        take(parser); let dims = array_new(0);
        if (!matches(parser, "]")) {
            array_push(dims, parse_shape_dim(parser));
            while (matches(parser, ",")) { take(parser); array_push(dims, parse_shape_dim(parser)); }
        }
        expect_token(parser, "]"); return ["shape_spec", dims];
    }
    let name = take(parser)[1]; return ["shape_var", name];
}

fn parse_type(parser) {
    let token = take(parser); let text = token[1];
    if (text == "Tensor") {
        expect_token(parser, "<"); let spec = parse_shape_spec(parser); expect_token(parser, ">");
        return ["tensor", spec];
    }
    if (text == "Shape") { return ["shape"]; }
    if (text == "Dynamic") { return ["dynamic"]; }
    return ["named", text];
}

fn parse_variant(parser) {
    let name_token = take(parser); let name = name_token[1]; let fields = array_new(0);
    if (matches(parser, "(")) {
        take(parser);
        if (!matches(parser, ")")) {
            let field_name = take(parser)[1]; let field_type = null;
            if (matches(parser, ":")) { take(parser); field_type = parse_type(parser); }
            array_push(fields, syntax.variant_field(field_name, field_type));
            while (matches(parser, ",")) {
                take(parser); let next_name = take(parser)[1]; let next_type = null;
                if (matches(parser, ":")) { take(parser); next_type = parse_type(parser); }
                array_push(fields, syntax.variant_field(next_name, next_type));
            }
        }
        expect_token(parser, ")");
    }
    return syntax.variant_node(name, fields, name_token[2], name_token[3]);
}

fn parse_type_declaration(parser, line, column) {
    take(parser); let name = take(parser)[1]; let params = array_new(0);
    if (matches(parser, "<")) {
        take(parser); array_push(params, take(parser)[1]);
        while (matches(parser, ",")) { take(parser); array_push(params, take(parser)[1]); }
        expect_token(parser, ">");
    }
    expect_token(parser, "="); let variants = array_new(0);
    array_push(variants, parse_variant(parser));
    while (matches(parser, "|")) { take(parser); array_push(variants, parse_variant(parser)); }
    expect_token(parser, ";"); return syntax.type_node(name, params, variants, line, column);
}

fn parse_basic_primary(parser, value) {
    let text = value[1]; let line = value[2]; let column = value[3];
    if (text == "(") { let node = parse_expression(parser); expect_token(parser, ")"); return node; }
    if (text == "[") {
        if (matches(parser, "]")) { expect_token(parser, "]"); return syntax.array_node(array_new(0), line, column); }
        let first = parse_expression(parser);
        if (matches(parser, "for")) {
            take(parser); let binding = take(parser)[1]; expect_token(parser, "in"); let iterable = parse_expression(parser);
            let filter = null; if (matches(parser, "if")) { take(parser); filter = parse_expression(parser); }
            expect_token(parser, "]"); return syntax.comprehension_node("list", first, null, binding, null, iterable, filter, line, column);
        }
        let items = array_new(0);
        array_push(items, first);
        while (matches(parser, ",")) { take(parser); array_push(items, parse_expression(parser)); }
        expect_token(parser, "]"); return syntax.array_node(items, line, column);
    }
    if (text == "{") {
        if (matches(parser, "}")) { expect_token(parser, "}"); return syntax.map_node(array_new(0), line, column); }
        let first = parse_expression(parser);
        if (matches(parser, "for")) {
            take(parser); let binding = take(parser)[1]; expect_token(parser, "in"); let iterable = parse_expression(parser);
            let filter = null; if (matches(parser, "if")) { take(parser); filter = parse_expression(parser); }
            expect_token(parser, "}"); return syntax.comprehension_node("set", first, null, binding, null, iterable, filter, line, column);
        }
        if (matches(parser, ":")) {
            take(parser); let map_value = parse_expression(parser);
            if (matches(parser, "for")) {
                take(parser); let key_binding = take(parser)[1]; expect_token(parser, ","); let value_binding = take(parser)[1];
                expect_token(parser, "in"); let iterable = parse_expression(parser);
                let filter = null; if (matches(parser, "if")) { take(parser); filter = parse_expression(parser); }
                expect_token(parser, "}"); return syntax.comprehension_node("map", first, map_value, key_binding, value_binding, iterable, filter, line, column);
            }
            let entries = array_new(0);
            // A string-literal key parses to a literal node [20, "string", value, ...];
            // use its value, not its kind. Identifier keys are name nodes [21, name, ...].
            let first_key = first[1];
            if (first[0] == 20) { first_key = first[2]; }
            array_push(entries, [first_key, map_value]);
            while (matches(parser, ",")) { take(parser); let name = take(parser); expect_token(parser, ":"); array_push(entries, [name[1], parse_expression(parser)]); }
            expect_token(parser, "}"); return syntax.map_node(entries, line, column);
        }
        parse_error(current(parser), "expected ':' or 'for' in map or set literal");
    }
    if (value[0] != "identifier") {
        parse_error(value, string_concat("expected expression, got ", string_concat(value[0], string_concat(" ", value[1]))));
    }
    if (matches(parser, "(")) { return syntax.call_node(text, parse_call_arguments(parser, text), line, column); }
    return syntax.name_node(text, line, column);
}

// Parse the comma-separated positions inside brackets: each position is an
// * expression, optionally `start : end` for a slice. The brackets themselves
// * are consumed by the caller.
fn parse_index_positions(parser) {
    let positions = array_new(0);
    if (matches(parser, "]")) { parse_error(current(parser), "expected index position"); }
    let done = false;
    while (!done) {
        let start = parse_expression(parser);
        if (matches(parser, ":")) {
            let colon = take(parser);
            array_push(positions, syntax.slice_node(start, parse_expression(parser), colon[2], colon[3]));
        } else { array_push(positions, start); }
        if (!matches(parser, ",")) { done = true; } else { take(parser); }
    }
    return positions;
}

fn parse_primary(parser) {
    let value = take(parser); let text = value[1]; let line = value[2]; let column = value[3]; let node = null;
    if (value[0] == "number") { node = syntax.literal_node("number", text, line, column); }
    else { if (value[0] == "string") { node = syntax.literal_node("string", text, line, column); }
    else { if (text == "true") { node = syntax.literal_node("bool", true, line, column); }
    else { if (text == "false") { node = syntax.literal_node("bool", false, line, column); }
    else { if (text == "null") { node = syntax.literal_node("null", null, line, column); }
    else { if (text == "unknown") { node = syntax.unknown_node(line, column); }
    else { if (text == "match") { node = parse_match(parser, line, column); }
    else { node = parse_keyword_primary(parser, text, line, column); if (node == null) { node = parse_basic_primary(parser, value); } }
    } } }
    } } }
    let postfix = true;
    while (postfix) {
        if (matches(parser, "[")) {
            take(parser); let positions = parse_index_positions(parser); expect_token(parser, "]"); node = syntax.index_node(node, positions, line, column);
        } else {
            if (matches(parser, ".")) {
                take(parser); let field = take(parser)[1];
                if (matches(parser, "(")) {
                    assert(node[0] == 21, "invalid qualified function call");
                    node = syntax.call_node(string_concat(node[1], ".", field), parse_arguments(parser), line, column);
                } else { node = syntax.field_node(node, field, line, column); }
            } else { postfix = false; }
        }
    }
    return node;
}

fn parse_unary(parser) {
    if (matches(parser, "!")) { let op = take(parser); return syntax.unary_node(op[1], parse_unary(parser), op[2], op[3]); }
    if (matches(parser, "-")) { let op = take(parser); return syntax.unary_node(op[1], parse_unary(parser), op[2], op[3]); }
    return parse_primary(parser);
}

fn parse_factor(parser) {
    let value = parse_unary(parser); let scanning = true;
    while (scanning) {
        if (matches(parser, "*")) { let op = take(parser); value = syntax.binary_node(op[1], value, parse_unary(parser), op[2], op[3]); }
        else { if (matches(parser, "/")) { let op = take(parser); value = syntax.binary_node(op[1], value, parse_unary(parser), op[2], op[3]); } else { scanning = false; } }
    }
    return value;
}

fn parse_term(parser) {
    let value = parse_factor(parser); let scanning = true;
    while (scanning) {
        if (matches(parser, "+")) { let op = take(parser); value = syntax.binary_node(op[1], value, parse_factor(parser), op[2], op[3]); }
        else { if (matches(parser, "-")) { let op = take(parser); value = syntax.binary_node(op[1], value, parse_factor(parser), op[2], op[3]); } else { scanning = false; } }
    }
    return value;
}

fn is_comparison(text) {
    if (text == "==") { return true; } if (text == "!=") { return true; }
    if (text == "<") { return true; } if (text == "<=") { return true; }
    if (text == ">") { return true; } if (text == ">=") { return true; } return false;
}

fn parse_expression(parser) {
    let value = parse_term(parser);
    while (is_comparison(current_text(parser))) {
        let op = take(parser); value = syntax.binary_node(op[1], value, parse_term(parser), op[2], op[3]);
    }
    return value;
}

fn parse_block(parser) {
    let body = array_new(0); expect_token(parser, "{");
    while (!matches(parser, "}")) { array_push(body, parse_statement(parser)); }
    expect_token(parser, "}"); return body;
}

fn parse_function(parser) {
    let is_async = false;
    if (matches(parser, "async")) { take(parser); is_async = true; }
    expect_token(parser, "fn"); let name_token = take(parser); let name = name_token[1]; let type_params = array_new(0);
    if (matches(parser, "<")) {
        take(parser); array_push(type_params, take(parser)[1]);
        while (matches(parser, ",")) { take(parser); array_push(type_params, take(parser)[1]); }
        expect_token(parser, ">");
    }
    let parameters = array_new(0);
    expect_token(parser, "(");
    if (!matches(parser, ")")) {
        array_push(parameters, take(parser)[1]);
        while (matches(parser, ",")) { take(parser); array_push(parameters, take(parser)[1]); }
    }
    expect_token(parser, ")"); return syntax.function_node(name, type_params, parameters, parse_block(parser), name_token[2], name_token[3], is_async);
}

fn parse_state_statement(parser, line, column) {
    take(parser); let name = take(parser)[1]; expect_token(parser, "=");
    let constructor = take(parser)[1];
    if (constructor == "probability") {
        expect_token(parser, "("); let p = parse_expression(parser); expect_token(parser, ")"); expect_token(parser, ";");
        return syntax.state_node(name, [["p", p], ["d", syntax.literal_node("number", "0.0", line, column)]], line, column);
    }
    assert(constructor == "state", "expected state or probability constructor");
    let closing = "}"; if (matches(parser, "(")) { closing = ")"; }
    if (closing == ")") { expect_token(parser, "("); } else { expect_token(parser, "{"); }
    let fields = parse_named_values(parser, closing); expect_token(parser, closing); expect_token(parser, ";"); return syntax.state_node(name, fields, line, column);
}

fn parse_if_statement(parser, line, column) {
    take(parser); expect_token(parser, "("); let predicate = parse_expression(parser); expect_token(parser, ")");
    let then_body = parse_block(parser); let else_body = array_new(0);
    if (matches(parser, "else")) { take(parser); else_body = parse_block(parser); }
    return syntax.if_node(predicate, then_body, else_body, line, column);
}

fn parse_transform_statement(parser, line, column) {
    take(parser); let target = take(parser)[1]; expect_token(parser, "with"); let name = take(parser)[1];
    let arguments = parse_arguments(parser); assert(array_length(arguments) == 0, "core transforms take no arguments"); expect_token(parser, ";");
    return syntax.transform_node(target, name, line, column);
}

fn parse_statement(parser) {
    let line = current_line(parser); let column = current_column(parser);
    if (matches(parser, "state")) { return parse_state_statement(parser, line, column); }
    if (matches(parser, "history")) { take(parser); let target = take(parser)[1]; let policy = take(parser)[1]; let amount = parse_expression(parser); expect_token(parser, ";"); return syntax.history_node(target, policy, amount, line, column); }
    if (matches(parser, "let")) { take(parser); let name_token = take(parser); let name = name_token[1]; let annotation = null; if (matches(parser, ":")) { take(parser); annotation = parse_type(parser); } expect_token(parser, "="); let value = parse_expression(parser); expect_token(parser, ";"); return syntax.let_node(name, annotation, value, name_token[2], name_token[3]); }
    if (matches(parser, "if")) { return parse_if_statement(parser, line, column); }
    if (matches(parser, "while")) { take(parser); expect_token(parser, "("); let predicate = parse_expression(parser); expect_token(parser, ")"); return syntax.while_node(predicate, parse_block(parser), line, column); }
    if (matches(parser, "for")) { take(parser); let binding = take(parser)[1]; expect_token(parser, "in"); let iterable = parse_expression(parser); return syntax.for_node(binding, iterable, parse_block(parser), line, column); }
    if (matches(parser, "transform")) { return parse_transform_statement(parser, line, column); }
    if (matches(parser, "taskgroup")) { take(parser); return syntax.taskgroup_node(parse_block(parser), line, column); }
    if (matches(parser, "cancel")) { take(parser); expect_token(parser, "("); let task = parse_expression(parser); expect_token(parser, ")"); expect_token(parser, ";"); return syntax.cancel_node(task, line, column); }
    if (matches(parser, "yield")) { take(parser); let value = parse_expression(parser); expect_token(parser, ";"); return syntax.yield_node(value, line, column); }
    if (matches(parser, "return")) { take(parser); let value = parse_expression(parser); expect_token(parser, ";"); return syntax.return_node(value, line, column); }
    if (matches(parser, "print")) { take(parser); expect_token(parser, "("); let value = parse_expression(parser); expect_token(parser, ")"); expect_token(parser, ";"); return syntax.print_node(value, line, column); }
    if (matches(parser, "match")) { take(parser); return syntax.expression_node(parse_match(parser, line, column), line, column); }
    let target = parse_expression(parser);
    if (matches(parser, "=")) { take(parser); let value = parse_expression(parser); expect_token(parser, ";"); return syntax.assign_node(target, value, line, column); }
    expect_token(parser, ";"); return syntax.expression_node(target, line, column);
}

fn parse(source) {
    let parser = parser_new(source); let functions = array_new(0); let statements = array_new(0); let imports = array_new(0); let types = array_new(0);
    while (matches(parser, "import")) {
        let start = take(parser); let path = take(parser); assert(path[0] == "string", "import path must be a quoted string");
        expect_token(parser, "as"); let alias = take(parser)[1]; expect_token(parser, ";"); array_push(imports, [path[1], alias, start[2]]);
    }
    while (!matches(parser, "<eof>")) {
        assert(!matches(parser, "import"), "imports must precede functions and statements");
        if (matches(parser, "fn")) { array_push(functions, parse_function(parser)); }
        else { if (matches(parser, "async")) { array_push(functions, parse_function(parser)); }
        else { if (matches(parser, "type")) { array_push(types, parse_type_declaration(parser, current_line(parser), current_column(parser))); }
        else { array_push(statements, parse_statement(parser)); } } }
    }
    return syntax.program(functions, statements, imports, types);
}
