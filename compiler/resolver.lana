fn type_ordinary(name) {
    if (name == "array") { return ["array", ["ordinary", "unknown"]]; }
    return ["ordinary", name];
}
fn type_information(value_type) { return ["information", value_type]; }
fn type_claim(value_type, proposition) { return ["claim", value_type, proposition]; }
fn type_sample(value_type, dependency, operation) {
    return ["sample", value_type, ["dependency", dependency], ["seed_lineage", "task"], ["operation", operation], ["revision", "current"]];
}
fn type_planned_effect(result_type, effect_kind) { return ["planned_effect", result_type, effect_kind]; }
fn type_task_handle(result_type, capabilities) { return ["task_handle", result_type, capabilities]; }
fn type_capability(name) { return ["capability", name]; }
fn type_shared_capability(value_type, permission) { return ["shared_capability", value_type, permission]; }
fn type_result(ok_type, error_type) { return ["result", ok_type, error_type]; }
fn type_generator(element_type) { return ["generator", element_type]; }
fn type_future(element_type) { return ["future", element_type]; }
fn type_set(element_type) { return ["set", element_type]; }
fn type_tensor(shape) { return ["tensor", shape]; }
fn type_uncertain(value_type) { return ["uncertain", value_type]; }
fn type_layer(in_shape, out_shape) { return ["layer", in_shape, out_shape]; }
fn shape_literal(dims) { return ["shape", dims]; }
fn shape_var(name) { return ["shape_var", name]; }
fn shape_dynamic() { return ["shape_dynamic"]; }
fn type_unknown() { return type_ordinary("unknown"); }
fn type_tag(value_type) { return value_type[0]; }
fn shared_permission_valid(permission) {
    if (permission == "read") { return true; }
    if (permission == "observe") { return true; }
    return permission == "admin";
}
fn information_value_type(value_type) {
    if (type_tag(value_type) == "information") { return value_type[1]; }
    return value_type;
}

fn type_compatible(left, right) {
    if (type_tag(left) == "ordinary") {
        if (left[1] == "unknown") { return true; }
        if (type_tag(right) == "ordinary") {
            if (right[1] == "unknown") { return true; }
            return left[1] == right[1];
        }
        if (left[1] == "tensor") { if (type_tag(right) == "tensor") { return true; } }
        if (left[1] == "Layer") { if (type_tag(right) == "layer") { return true; } }
        return false;
    }
    if (type_tag(right) == "ordinary") {
        if (right[1] == "unknown") { return true; }
        if (right[1] == "tensor") { if (type_tag(left) == "tensor") { return true; } }
        if (right[1] == "Layer") { if (type_tag(left) == "layer") { return true; } }
        return false;
    }
    if (type_tag(left) != type_tag(right)) { return false; }
    if (type_tag(left) == "array") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "information") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "claim") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "sample") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "planned_effect") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "task_handle") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "capability") { return left[1] == right[1]; }
    if (type_tag(left) == "shared_capability") {
        if (left[2] != right[2]) { return false; }
        return type_compatible(left[1], right[1]);
    }
    if (type_tag(left) == "result") {
        if (!type_compatible(left[1], right[1])) { return false; }
        return type_compatible(left[2], right[2]);
    }
    if (type_tag(left) == "generator") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "future") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "set") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "tensor") { return shape_compatible(left[1], right[1]); }
    if (type_tag(left) == "uncertain") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "layer") {
        if (!shape_compatible(left[1], right[1])) { return false; }
        return shape_compatible(left[2], right[2]);
    }
    return false;
}

fn shape_compatible(left, right) {
    if (left[0] == "shape_dynamic") { return true; }
    if (right[0] == "shape_dynamic") { return true; }
    if (left[0] == "shape_var") { return true; }
    if (right[0] == "shape_var") { return true; }
    if (left[0] == "shape") { if (right[0] == "shape") { return shape_dims_equal(left[1], right[1]); } }
    return false;
}

fn shape_dims_equal(left, right) {
    if (array_length(left) != array_length(right)) { return false; }
    let index = 0;
    while (index < array_length(left)) {
        if (left[index] != right[index]) { return false; }
        index = index + 1;
    }
    return true;
}

fn shape_concat(left, right) {
    if (left[0] != "shape") { return shape_dynamic(); }
    if (right[0] != "shape") { return shape_dynamic(); }
    let dims = array_new(0); let index = 0;
    while (index < array_length(left[1])) { array_push(dims, left[1][index]); index = index + 1; }
    index = 0;
    while (index < array_length(right[1])) { array_push(dims, right[1][index]); index = index + 1; }
    return shape_literal(dims);
}

fn shape_of_expression(resolved) {
    let node = resolved[3];
    if (node[0] == 25) {
        let dims = array_new(0); let index = 0;
        while (index < array_length(node[1])) {
            let item = node[1][index];
            if (item[0] == 20) { if (item[1] == "number") { array_push(dims, item[2]); index = index + 1; } else { return shape_dynamic(); } }
            else { return shape_dynamic(); }
        }
        return shape_literal(dims);
    }
    if (node[0] == 21) { return shape_var(node[1]); }
    return shape_dynamic();
}

fn tensor_shape_of_type(value_type) {
    if (type_tag(value_type) == "tensor") { return value_type[1]; }
    if (type_tag(value_type) == "uncertain") { return tensor_shape_of_type(value_type[1]); }
    if (type_tag(value_type) == "ordinary") { if (value_type[1] == "tensor") { return shape_dynamic(); } }
    return shape_dynamic();
}

fn tensor_shape_of(resolved) { return tensor_shape_of_type(resolved[1]); }

fn array_literal_shape(node) {
    if (node[0] == 25) {
        let items = node[1];
        if (array_length(items) == 0) { return shape_dynamic(); }
        let inner = array_literal_shape(items[0]);
        if (inner[0] != "shape") { return shape_dynamic(); }
        let dims = array_new(0); array_push(dims, number_to_string(array_length(items)));
        let index = 0;
        while (index < array_length(inner[1])) { array_push(dims, inner[1][index]); index = index + 1; }
        return shape_literal(dims);
    }
    if (node[0] == 20) { if (node[1] == "number") { return shape_literal(array_new(0)); } }
    return shape_dynamic();
}

fn matmul_shape(left, right) {
    if (left[0] != "shape") { return shape_dynamic(); }
    if (right[0] != "shape") { return shape_dynamic(); }
    let a = left[1]; let b = right[1];
    let la = array_length(a); let lb = array_length(b);
    if (la == 2) { if (lb == 2) {
        if (a[1] == b[0]) { return shape_literal([a[0], b[1]]); }
        return shape_dynamic();
    } }
    if (la == 1) { if (lb == 2) {
        if (a[0] == b[0]) { return shape_literal([b[1]]); }
        return shape_dynamic();
    } }
    if (la == 2) { if (lb == 1) {
        if (a[1] == b[0]) { return shape_literal([a[0]]); }
        return shape_dynamic();
    } }
    if (la == 1) { if (lb == 1) {
        if (a[0] == b[0]) { return shape_literal(array_new(0)); }
        return shape_dynamic();
    } }
    return shape_dynamic();
}

fn elementwise_shape(left, right) {
    if (left[0] != "shape") { return shape_dynamic(); }
    if (right[0] != "shape") { return shape_dynamic(); }
    if (shape_dims_equal(left[1], right[1])) { return left; }
    return shape_dynamic();
}

fn is_tensor_type(value_type) {
    if (type_tag(value_type) == "tensor") { return true; }
    if (type_tag(value_type) == "ordinary") { if (value_type[1] == "tensor") { return true; } }
    return false;
}

fn is_state_value_type(value_type) {
    if (type_tag(value_type) == "information") { return true; }
    if (type_tag(value_type) == "ordinary") {
        if (value_type[1] == "state") { return true; }
        if (value_type[1] == "nqubit_state") { return true; }
    }
    return false;
}

fn is_uncertain_type(value_type) { return type_tag(value_type) == "uncertain"; }

fn is_uncertain_tensor_type(value_type) {
    if (type_tag(value_type) != "uncertain") { return false; }
    return is_tensor_type(value_type[1]);
}

fn uncertain_inner_type(value_type) { return value_type[1]; }

fn require_certain_tensor(value_type, operation, node) {
    if (is_uncertain_tensor_type(value_type)) {
        type_error(node, string_concat(operation, " requires a certain Tensor (extract .prediction first)"));
    }
    return value_type;
}

fn shape_to_string(shape) {
    if (shape[0] == "shape_dynamic") { return "Dynamic"; }
    if (shape[0] == "shape_var") { return shape[1]; }
    if (shape[0] == "shape") { return string_concat("[", string_concat(string_join(shape[1], ", "), "]")); }
    return "unknown";
}

fn resolve_shape_spec(spec) {
    if (spec[0] == "shape_dynamic") { return shape_dynamic(); }
    if (spec[0] == "shape_var") { return shape_var(spec[1]); }
    if (spec[0] == "shape_spec") { return shape_literal(spec[1]); }
    return shape_dynamic();
}

fn resolve_type_annotation(annotation, environment) {
    if (annotation[0] == "tensor") { return type_tensor(resolve_shape_spec(annotation[1])); }
    if (annotation[0] == "shape") { return type_ordinary("Shape"); }
    if (annotation[0] == "dynamic") { return type_ordinary("Dynamic"); }
    if (annotation[0] == "named") { return type_ordinary(annotation[1]); }
    return type_unknown();
}

fn layer_variants() { return ["Dense", "Conv", "Relu"]; }

fn effect_kind_valid(kind) {
    if (kind == "pure") { return true; }
    if (kind == "observation") { return true; }
    if (kind == "stochastic") { return true; }
    if (kind == "io") { return true; }
    if (kind == "mutation") { return true; }
    if (kind == "task") { return true; }
    return kind == "external_call";
}

fn effects(kind) {
    if (!effect_kind_valid(kind)) { assert(false, string_concat("unknown effect kind ", kind)); }
    return ["effects", [kind]];
}

fn effects_contains(value, kind) {
    let index = 0;
    while (index < array_length(value[1])) {
        if (value[1][index] == kind) { return true; }
        index = index + 1;
    }
    return false;
}

fn effects_add(value, kind) {
    if (!effect_kind_valid(kind)) { assert(false, string_concat("unknown effect kind ", kind)); }
    if (kind == "pure") { return value; }
    if (effects_contains(value, kind)) { return value; }
    let kinds = array_new(0); let index = 0;
    while (index < array_length(value[1])) {
        if (kind == "pure") { array_push(kinds, value[1][index]); }
        else { if (value[1][index] != "pure") { array_push(kinds, value[1][index]); } }
        index = index + 1;
    }
    if (array_length(kinds) == 0) { array_push(kinds, kind); }
    else { if (!effects_contains(["effects", kinds], kind)) { array_push(kinds, kind); } }
    return ["effects", kinds];
}

fn effects_combine(left, right) {
    if (array_length(right[1]) == 1) { if (right[1][0] == "pure") { return left; } }
    if (array_length(left[1]) == 1) { if (left[1][0] == "pure") { return right; } }
    let result = left; let index = 0;
    while (index < array_length(right[1])) { result = effects_add(result, right[1][index]); index = index + 1; }
    return result;
}

fn effects_external(value) {
    if (effects_contains(value, "io")) { return true; }
    if (effects_contains(value, "mutation")) { return true; }
    if (effects_contains(value, "task")) { return true; }
    if (effects_contains(value, "external_call")) { return true; }
    return effects_contains(value, "observation");
}

fn effects_is_pure(value) {
    if (effects_contains(value, "observation")) { return false; }
    if (effects_contains(value, "stochastic")) { return false; }
    if (effects_contains(value, "io")) { return false; }
    if (effects_contains(value, "mutation")) { return false; }
    if (effects_contains(value, "task")) { return false; }
    if (effects_contains(value, "external_call")) { return false; }
    return true;
}

fn typed(node, value_type, effect_value) { return [node[0], value_type, effect_value, node]; }

