fn oo_validate(objects, functions) {
    let names = map_keys(objects); let index = 0;
    while (index < array_length(names)) {
        let object = objects[names[index]]; let methods = object["methods"]; let member = 0;
        if (!map_has(object, "imported")) {
        while (member < array_length(methods)) {
            let method = methods[member]; let prior = 0;
            if (method["is_init"]) {
                let effect = method["inferred"]; let names = ["observation","stochastic","io","task","external_call"]; let effect_index = 0;
                while (effect_index < array_length(names)) { if (effects_contains(effect, names[effect_index])) { oo_error(method, "init may only initialize its own fields and contained objects"); } effect_index = effect_index + 1; }
            }
            while (prior < member) {
                let other = methods[prior];
                if (method["name"] == other["name"]) {
                    if (method["static"]) { oo_error(method, "static methods cannot overload"); }
                    if (other["static"]) { oo_error(method, "static and instance names conflict"); }
                    let left = method["parameter_types"]; let right = other["parameter_types"];
                    if (array_length(left) != array_length(right)) { oo_error(method, "overloads require distinct Information/STATE signatures of equal arity"); }
                    let difference = false; let parameter = 0;
                    while (parameter < array_length(left)) {
                        if (left[parameter] != right[parameter]) {
                            difference = true;
                            if (!oo_overload_type(left[parameter])) { oo_error(method, "unsupported overload type"); }
                            if (!oo_overload_type(right[parameter])) { oo_error(method, "unsupported overload type"); }
                        }
                        parameter = parameter + 1;
                    }
                    if (!difference) { oo_error(method, "duplicate method signature"); }
                }
                prior = prior + 1;
            }
            member = member + 1;
        }
        let promise_index = 0;
        while (promise_index < array_length(object["implements"])) {
            let interface_name = object["implements"][promise_index];
            if (!map_has(objects, interface_name)) { oo_error(object, "unknown interface"); }
            let interface = objects[interface_name]; if (interface["kind"] != "interface") { oo_error(object, "implements requires an interface"); }
            let promise = 0;
            while (promise < array_length(interface["methods"])) {
                let required = interface["methods"][promise]; let implementation = null; member = 0;
                while (member < array_length(methods)) {
                    let method = methods[member];
                    if (method["name"] == required["name"]) { if (json_stringify(method["parameter_types"]) == json_stringify(required["parameter_types"])) {
                        if (!method["static"]) { if (method["visibility"] == "public") { if (method["result_type"] == required["result_type"]) { implementation = method; } } }
                    } }
                    member = member + 1;
                }
                if (type_of(implementation) == "null") { oo_error(object, "missing interface signature"); }
                let effect_index = 0;
                while (effect_index < array_length(implementation["inferred"][1])) {
                    let effect = implementation["inferred"][1][effect_index];
                    if (effect != "pure") { if (!effects_contains(required["inferred"], effect)) { oo_error(implementation, "method exceeds interface effect promise"); } }
                    effect_index = effect_index + 1;
                }
                promise = promise + 1;
            }
            promise_index = promise_index + 1;
        }
        }
        index = index + 1;
    }
    return null;
}
fn oo_overload_type(name) {
    if (name == "STATE") { return true; } if (name == "STATE_DIST") { return true; }
    if (string_length(name) > 13) { return string_slice(name, 0, 12) == "Information<"; }
    return false;
}

fn oo_reference_name(node) {
    if (node[0] == 21) { return node[1]; }
    if (node[0] == 27) { let prefix = oo_reference_name(node[1]); if (prefix != "") { return string_concat(prefix, ".", node[2]); } }
    return "";
}

fn oo_import_type(name, alias, objects) {
    if (name == null) { return null; }
    if (string_length(name) > 13) { if (string_slice(name, 0, 12) == "Information<") {
        return string_concat("Information<", oo_import_type(string_slice(name, 12, string_length(name) - 1), alias, objects), ">");
    } }
    if (map_has(objects, name)) { return string_concat(alias, ".", name); }
    return name;
}
fn oo_import(original, alias, objects) {
    let imported = environment_clone(original); imported["imported"] = original;
    imported["name"] = string_concat(alias, ".", original["name"]);
    let interfaces = array_new(0); let index = 0;
    while (index < array_length(original["implements"])) { array_push(interfaces, oo_import_type(original["implements"][index], alias, objects)); index = index + 1; }
    imported["implements"] = interfaces;
    let fields = array_new(0); index = 0;
    while (index < array_length(original["fields"])) {
        let field = environment_clone(original["fields"][index]); field["type"] = oo_import_type(field["type"], alias, objects); array_push(fields, field); index = index + 1;
    }
    imported["fields"] = fields;
    let methods = array_new(0); index = 0;
    while (index < array_length(original["methods"])) {
        let method = environment_clone(original["methods"][index]); let parameters = array_new(0); let parameter = 0;
        while (parameter < array_length(method["parameter_types"])) { array_push(parameters, oo_import_type(method["parameter_types"][parameter], alias, objects)); parameter = parameter + 1; }
        method["parameter_types"] = parameters; method["result_type"] = oo_import_type(method["result_type"], alias, objects); array_push(methods, method); index = index + 1;
    }
    imported["methods"] = methods; return imported;
}

fn oo_symbol_reference(environment, owner, name, line, column, declaration_line, declaration_column) {
    let box = symbol_box_of(environment);
    if (box != null) { if (box[3]) { array_push(box[1], [name, line, column, string_concat(owner, ".", symbol_identity(name, declaration_line, declaration_column))]); } }
    return null;
}
fn oo_symbols(environment) {
    let box = symbol_box_of(environment); if (!box[3]) { return null; } let objects = oo_registry(environment); let names = map_keys(objects); let index = 0;
    while (index < array_length(names)) {
        let object = objects[names[index]];
        if (!map_has(object, "imported")) {
            symbol_add_definition(environment, object["name"], object["kind"], type_ordinary(object["name"]), object["line"], object["column"]);
            let members = array_new(0); let member = 0;
            while (member < array_length(object["fields"])) { array_push(members, object["fields"][member]); member = member + 1; }
            member = 0; while (member < array_length(object["methods"])) { array_push(members, object["methods"][member]); member = member + 1; }
            member = 0; while (member < array_length(members)) {
                let item = members[member]; let kind = "method"; let value_type = type_ordinary("function");
                if (map_has(item, "type")) { kind = "field"; value_type = oo_type(item["type"], environment); }
                array_push(box[0], [item["name"], kind, value_type, item["line"], item["column"], string_concat(object["name"], ".", symbol_identity(item["name"], item["line"], item["column"]))]);
                member = member + 1;
            }
        }
        index = index + 1;
    }
    return null;
}
