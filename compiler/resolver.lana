fn type_ordinary(name) { return ["ordinary", name]; }
fn type_information(value_type) { return ["information", value_type]; }
fn type_claim(value_type, proposition) { return ["claim", value_type, proposition]; }
fn type_sample(value_type, dependency, operation) {
    return ["sample", value_type, ["dependency", dependency], ["seed_lineage", "task"], ["operation", operation], ["revision", "current"]];
}
fn type_planned_effect(result_type, effect_kind) { return ["planned_effect", result_type, effect_kind]; }
fn type_task_handle(result_type, capabilities) { return ["task_handle", result_type, capabilities]; }
fn type_capability(name) { return ["capability", name]; }
fn type_shared_capability(value_type, permission) { return ["shared_capability", value_type, permission]; }
fn type_result(ok_type, error_type) { return ["result", ok_type, error_type]; }
fn type_unknown() { return type_ordinary("unknown"); }
fn type_tag(value_type) { return value_type[0]; }
fn shared_permission_valid(permission) {
    if (permission == "read") { return true; }
    if (permission == "observe") { return true; }
    return permission == "admin";
}
fn information_value_type(value_type) {
    if (type_tag(value_type) == "information") { return value_type[1]; }
    return value_type;
}

fn type_compatible(left, right) {
    if (type_tag(left) == "ordinary") {
        if (left[1] == "unknown") { return true; }
        if (type_tag(right) == "ordinary") {
            if (right[1] == "unknown") { return true; }
            return left[1] == right[1];
        }
        return false;
    }
    if (type_tag(right) == "ordinary") { if (right[1] == "unknown") { return true; } return false; }
    if (type_tag(left) != type_tag(right)) { return false; }
    if (type_tag(left) == "information") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "claim") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "sample") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "planned_effect") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "task_handle") { return type_compatible(left[1], right[1]); }
    if (type_tag(left) == "capability") { return left[1] == right[1]; }
    if (type_tag(left) == "shared_capability") {
        if (left[2] != right[2]) { return false; }
        return type_compatible(left[1], right[1]);
    }
    if (type_tag(left) == "result") {
        if (!type_compatible(left[1], right[1])) { return false; }
        return type_compatible(left[2], right[2]);
    }
    return false;
}

fn effect_kind_valid(kind) {
    if (kind == "pure") { return true; }
    if (kind == "observation") { return true; }
    if (kind == "stochastic") { return true; }
    if (kind == "io") { return true; }
    if (kind == "mutation") { return true; }
    if (kind == "task") { return true; }
    return kind == "external_call";
}

fn effects(kind) {
    assert(effect_kind_valid(kind), string_concat("unknown effect kind ", kind));
    return ["effects", [kind]];
}

fn effects_contains(value, kind) {
    let index = 0;
    while (index < array_length(value[1])) {
        if (value[1][index] == kind) { return true; }
        index = index + 1;
    }
    return false;
}

fn effects_add(value, kind) {
    assert(effect_kind_valid(kind), string_concat("unknown effect kind ", kind));
    let kinds = array_new(0); let index = 0;
    while (index < array_length(value[1])) {
        if (kind == "pure") { array_push(kinds, value[1][index]); }
        else { if (value[1][index] != "pure") { array_push(kinds, value[1][index]); } }
        index = index + 1;
    }
    if (array_length(kinds) == 0) { array_push(kinds, kind); }
    else { if (!effects_contains(["effects", kinds], kind)) { array_push(kinds, kind); } }
    return ["effects", kinds];
}

fn effects_combine(left, right) {
    let result = left; let index = 0;
    while (index < array_length(right[1])) { result = effects_add(result, right[1][index]); index = index + 1; }
    return result;
}

fn effects_external(value) {
    if (effects_contains(value, "io")) { return true; }
    if (effects_contains(value, "mutation")) { return true; }
    if (effects_contains(value, "task")) { return true; }
    if (effects_contains(value, "external_call")) { return true; }
    return effects_contains(value, "observation");
}

fn typed(node, value_type, effect_value) { return [node[0], value_type, effect_value, node]; }

fn host_is_pure(name) {
    if (name == "map_new") { return true; }
    if (name == "index_get") { return true; }
    if (name == "json_parse") { return true; }
    if (name == "json_stringify") { return true; }
    if (name == "string_length") { return true; }
    if (name == "string_byte_at") { return true; }
    if (name == "string_slice") { return true; }
    if (name == "string_concat") { return true; }
    if (name == "number_to_string") { return true; }
    if (name == "array_new") { return true; }
    if (name == "string_hex") { return true; }
    if (name == "string_join") { return true; }
    if (name == "array_length") { return true; }
    if (name == "string_unescape") { return true; }
    return false;
}

fn host_effect(name) {
    if (name == "print") { return effects("io"); }
    if (name == "read_text") { return effects("io"); }
    if (name == "write_text") { return effects("io"); }
    if (name == "csv_read") { return effects("io"); }
    if (name == "csv_write") { return effects("io"); }
    if (name == "args") { return effects("external_call"); }
    if (name == "now") { return effects("external_call"); }
    if (name == "random") { return effects("stochastic"); }
    if (name == "assert") { return effects("external_call"); }
    if (name == "index_set") { return effects("mutation"); }
    if (name == "array_push") { return effects("mutation"); }
    if (host_is_pure(name)) { return effects("pure"); }
    return effects("external_call");
}

fn host_type(name) {
    if (name == "args") { return type_ordinary("array"); }
    if (name == "read_text") { return type_ordinary("string"); }
    if (name == "write_text") { return type_ordinary("null"); }
    if (name == "now") { return type_ordinary("number"); }
    if (name == "random") { return type_sample(type_ordinary("number"), "host:random", "random"); }
    if (name == "assert") { return type_ordinary("null"); }
    if (name == "json_parse") { return type_unknown(); }
    if (name == "json_stringify") { return type_ordinary("string"); }
    if (name == "csv_read") { return type_ordinary("array"); }
    if (name == "csv_write") { return type_ordinary("null"); }
    if (name == "array_length") { return type_ordinary("number"); }
    if (name == "string_length") { return type_ordinary("number"); }
    if (name == "number_to_string") { return type_ordinary("string"); }
    return type_unknown();
}

fn literal_type(node) {
    if (node[1] == "number") { return type_ordinary("number"); }
    if (node[1] == "string") { return type_ordinary("string"); }
    if (node[1] == "bool") { return type_ordinary("bool"); }
    if (node[1] == "null") { return type_ordinary("null"); }
    return type_unknown();
}

fn environment_new() { return map_new(); }

fn environment_find(environment, name) {
    return map_has(environment, name);
}

fn environment_get(environment, name) {
    if (!map_has(environment, name)) { return type_unknown(); }
    return map_get(environment, name);
}

fn environment_set(environment, name, value_type) {
    map_set(environment, name, value_type);
    return null;
}

fn environment_clone(environment) {
    let result = map_new();
    let keys = map_keys(environment);
    let index = 0;
    while (index < array_length(keys)) {
        let key = keys[index];
        map_set(result, key, map_get(environment, key));
        index = index + 1;
    }
    return result;
}

fn type_error(node, message) {
    let line = node[array_length(node) - 1];
    let location = string_concat("type error at line ", number_to_string(line));
    location = string_concat(location, " column 1: ");
    assert(false, string_concat(location, message));
    return null;
}

fn exact_type(value_type, operation, node) {
    if (type_tag(value_type) == "sample") {
        type_error(node, string_concat(operation, " requires explicit sample_value(...)"));
    }
    if (type_tag(value_type) == "claim") {
        type_error(node, string_concat(operation, " requires explicit claim_value(...)"));
    }
    if (type_tag(value_type) == "information") {
        type_error(node, string_concat(operation, " requires resolve(...) or explicit Information matching"));
    }
    if (type_tag(value_type) == "planned_effect") {
        type_error(node, string_concat(operation, " cannot consume an unexecuted planned effect"));
    }
    if (type_tag(value_type) == "result") {
        type_error(node, string_concat(operation, " requires explicit result_value(...) or result_error(...)"));
    }
    return value_type;
}

fn resolve_arguments(arguments, environment) {
    let result = array_new(0); let index = 0;
    while (index < array_length(arguments)) {
        array_push(result, resolve_expression_with_environment(arguments[index], environment));
        index = index + 1;
    }
    return result;
}

fn arguments_effect(resolved) {
    let result = effects("pure"); let index = 0;
    while (index < array_length(resolved)) { result = effects_combine(result, resolved[index][2]); index = index + 1; }
    return result;
}

fn require_argument_count(name, resolved, expected) {
    assert(array_length(resolved) == expected, string_concat(name, " has invalid argument count"));
    return null;
}

fn builtin_uncertainty_type(node, resolved) {
    let name = node[1];
    if (name == "information") {
        require_argument_count(name, resolved, 1); return type_information(resolved[0][1]);
    }
    if (name == "claim") {
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 20) { type_error(node, "claim proposition must be a string literal"); }
        if (node[2][1][1] != "string") { type_error(node, "claim proposition must be a string literal"); }
        return type_claim(resolved[0][1], node[2][1][2]);
    }
    if (name == "sample_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "sample") { type_error(node, "sample_value requires Sample<T>"); }
        return resolved[0][1][1];
    }
    if (name == "sample_metadata") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "sample") { type_error(node, "sample_metadata requires Sample<T>"); }
        return type_ordinary("map");
    }
    if (name == "claim_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_value requires Claim<T, Proposition>"); }
        return resolved[0][1][1];
    }
    if (name == "claim_proposition") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_proposition requires Claim<T, Proposition>"); }
        return type_ordinary("string");
    }
    if (name == "claim_status") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_status requires Claim<T, Proposition>"); }
        return type_ordinary("map");
    }
    if (name == "inspect_information") {
        require_argument_count(name, resolved, 1);
        return type_ordinary("map");
    }
    return null;
}

fn builtin_effect_type(node, resolved) {
    let name = node[1];
    if (name == "planned_effect") {
        require_argument_count(name, resolved, 2);
        if (node[2][0][0] != 20) { type_error(node, "planned_effect kind must be a string literal"); }
        if (node[2][0][1] != "string") { type_error(node, "planned_effect kind must be a string literal"); }
        if (!effect_kind_valid(node[2][0][2])) { type_error(node, "planned_effect has invalid effect kind"); }
        return type_planned_effect(resolved[1][1], node[2][0][2]);
    }
    if (name == "execute_effect") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "planned_effect") { type_error(node, "execute_effect requires PlannedEffect<T, Kind>"); }
        return resolved[0][1][1];
    }
    if (name == "effect_status") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "planned_effect") { type_error(node, "effect_status requires PlannedEffect<T, Kind>"); }
        return type_ordinary("map");
    }
    if (name == "capability") {
        require_argument_count(name, resolved, 1);
        if (node[2][0][0] != 20) { type_error(node, "capability name must be a string literal"); }
        if (node[2][0][1] != "string") { type_error(node, "capability name must be a string literal"); }
        return type_capability(node[2][0][2]);
    }
    return null;
}

fn require_shared_permission(node, resolved, permission, message) {
    if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, message); }
    if (resolved[0][1][2] != permission) { type_error(node, message); }
    return resolved[0][1][1];
}

fn builtin_shared_admin_type(node, resolved) {
    let name = node[1]; let value_type = null;
    if (name == "shared_information") { require_argument_count(name, resolved, 1); return type_shared_capability(information_value_type(resolved[0][1]), "admin"); }
    if (name == "shared_grant") {
        require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "admin", "shared_grant requires an admin shared capability");
        if (node[2][1][0] != 20) { type_error(node, "shared_grant permission must be a string literal"); }
        if (node[2][1][1] != "string") { type_error(node, "shared_grant permission must be a string literal"); }
        if (!shared_permission_valid(node[2][1][2])) { type_error(node, "shared_grant permission must be read, observe, or admin"); }
        return type_shared_capability(value_type, node[2][1][2]);
    }
    if (name == "shared_revoke") {
        require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "admin", "shared_revoke requires admin and target shared capabilities");
        if (type_tag(resolved[1][1]) != "shared_capability") { type_error(node, "shared_revoke requires admin and target shared capabilities"); }
        return type_ordinary("null");
    }
    return null;
}

fn builtin_shared_access_type(node, resolved) {
    let name = node[1]; let value_type = null;
    if (name == "shared_snapshot") { require_argument_count(name, resolved, 1); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_at") { require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_wait") { require_argument_count(name, resolved, 3); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_observe") {
        require_argument_count(name, resolved, 3); value_type = require_shared_permission(node, resolved, "observe", "shared_observe requires an observe shared capability");
        if (!type_compatible(value_type, information_value_type(resolved[1][1]))) { type_error(node, "shared_observe evidence type does not match shared Information"); }
        return type_ordinary("number");
    }
    return null;
}

fn builtin_shared_metadata_type(node, resolved) {
    let name = node[1];
    if (name == "shared_revision") { require_argument_count(name, resolved, 1); if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, "shared metadata requires a shared capability"); } return type_ordinary("number"); }
    if (name == "shared_identity") { require_argument_count(name, resolved, 1); if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, "shared metadata requires a shared capability"); } return type_ordinary("number"); }
    return null;
}

fn builtin_result_type(node, resolved) {
    let name = node[1];
    if (name == "result_ok") {
        require_argument_count(name, resolved, 1); return type_result(resolved[0][1], type_unknown());
    }
    if (name == "result_error") {
        require_argument_count(name, resolved, 1); return type_result(type_unknown(), resolved[0][1]);
    }
    if (name == "result_is_ok") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_is_ok requires Result<T, E>"); }
        return type_ordinary("bool");
    }
    if (name == "result_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_value requires Result<T, E>"); }
        return resolved[0][1][1];
    }
    if (name == "result_error_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_error_value requires Result<T, E>"); }
        return resolved[0][1][2];
    }
    return null;
}

fn builtin_call_type(node, resolved) {
    let value_type = builtin_uncertainty_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_effect_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_admin_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_access_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_metadata_type(node, resolved);
    if (value_type != null) { return value_type; }
    return builtin_result_type(node, resolved);
}

fn resolve_call(node, environment) {
    let resolved = resolve_arguments(node[2], environment);
    let effect_value = arguments_effect(resolved);
    let builtin_type = builtin_call_type(node, resolved);
    if (builtin_type != null) {
        if (node[1] == "execute_effect") { effect_value = effects_combine(effect_value, effects(resolved[0][1][2])); }
        if (node[1] == "shared_observe") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "shared_grant") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "shared_revoke") { effect_value = effects_combine(effect_value, effects("observation")); }
        return typed(node, builtin_type, effect_value);
    }
    effect_value = effects_combine(effect_value, host_effect(node[1]));
    return typed(node, host_type(node[1]), effect_value);
}

fn resolve_structure_expression(node, environment) {
    if (node[0] == 27) {
        let source = resolve_expression_with_environment(node[1], environment);
        return typed(node, type_unknown(), source[2]);
    }
    if (node[0] == 28) {
        let effect_value = effects("pure"); let index = 0;
        while (index < array_length(node[1])) {
            let item = resolve_expression_with_environment(node[1][index][1], environment);
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, type_ordinary("map"), effect_value);
    }
    if (node[0] == 29) {
        let effect_value = effects("pure"); let index = 0;
        while (index < array_length(node[3])) {
            let item = resolve_expression_with_environment(node[3][index], environment);
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, type_information(type_unknown()), effect_value);
    }
    if (node[0] == 30) {
        let rows = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_information(type_unknown()), rows[2]);
    }
    return null;
}

fn resolve_information_operation(node, environment) {
    if (node[0] == 31) {
        let resolved = resolve_arguments(node[2], environment);
        let effect_value = arguments_effect(resolved);
        if (node[1] == "observe") {
            return typed(node, type_information(type_unknown()), effects_combine(effect_value, effects("observation")));
        }
        if (node[1] == "sample") {
            return typed(node, type_sample(type_unknown(), "information", "sample"), effects_combine(effect_value, effects("stochastic")));
        }
        if (node[1] == "resolve") {
            if (array_length(resolved) > 0) {
                if (type_tag(resolved[0][1]) == "information") { return typed(node, resolved[0][1][1], effect_value); }
            }
            return typed(node, type_unknown(), effect_value);
        }
        if (node[1] == "derivation") { return typed(node, type_ordinary("map"), effect_value); }
        if (node[1] == "explain") { return typed(node, type_ordinary("string"), effect_value); }
        return typed(node, type_information(type_unknown()), effect_value);
    }
    return null;
}

fn resolve_information_expression(node, environment) {
    let value = resolve_structure_expression(node, environment);
    if (value != null) { return value; }
    return resolve_information_operation(node, environment);
}

fn resolve_runtime_expression(node, environment) {
    if (node[0] == 32) {
        if (node[3] == "sample") {
            return typed(node, type_sample(type_unknown(), node[1], "measure"), effects("stochastic"));
        }
        return typed(node, type_unknown(), effects("pure"));
    }
    if (node[0] == 33) {
        return typed(node, type_sample(type_unknown(), node[1], "estimate_measure"), effects("stochastic"));
    }
    if (node[0] == 34) { return typed(node, type_unknown(), effects("pure")); }
    if (node[0] == 35) {
        let resolved = resolve_arguments(node[2], environment);
        return typed(node, type_task_handle(type_unknown(), ["join", "cancel"]), effects_combine(arguments_effect(resolved), effects("task")));
    }
    if (node[0] == 36) {
        let task = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_result(type_unknown(), type_ordinary("task_error")), effects_combine(task[2], effects("task")));
    }
    if (node[0] == 37) {
        let task = resolve_expression_with_environment(node[1], environment);
        let timeout = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_result(type_unknown(), type_ordinary("timeout_error")),
                     effects_combine(effects_combine(task[2], timeout[2]), effects("task")));
    }
    return null;
}

fn resolve_extended_expression(node, environment) {
    let value = resolve_information_expression(node, environment);
    if (value != null) { return value; }
    value = resolve_runtime_expression(node, environment);
    if (value != null) { return value; }
    assert(false, "unknown expression node");
    return typed(node, type_unknown(), effects("pure"));
}

fn resolve_core_expression(node, environment) {
    if (node[0] == 20) { return typed(node, literal_type(node), effects("pure")); }
    if (node[0] == 21) { return typed(node, environment_get(environment, node[1]), effects("pure")); }
    if (node[0] == 22) {
        let left = resolve_expression_with_environment(node[2], environment);
        let right = resolve_expression_with_environment(node[3], environment);
        let uncertain = type_tag(left[1]) == "information";
        if (type_tag(right[1]) == "information") { uncertain = true; }
        exact_type(information_value_type(left[1]), "binary operation", node); exact_type(information_value_type(right[1]), "binary operation", node);
        let result_type = type_ordinary("number");
        if (node[1] == "==") { result_type = type_ordinary("bool"); }
        if (node[1] == "!=") { result_type = type_ordinary("bool"); }
        if (node[1] == "<") { result_type = type_ordinary("bool"); }
        if (node[1] == "<=") { result_type = type_ordinary("bool"); }
        if (node[1] == ">") { result_type = type_ordinary("bool"); }
        if (node[1] == ">=") { result_type = type_ordinary("bool"); }
        if (uncertain) { result_type = type_information(result_type); }
        return typed(node, result_type, effects_combine(left[2], right[2]));
    }
    if (node[0] == 23) {
        let value = resolve_expression_with_environment(node[2], environment);
        let uncertain = type_tag(value[1]) == "information";
        let result_type = exact_type(information_value_type(value[1]), "unary operation", node);
        if (uncertain) { result_type = type_information(result_type); }
        return typed(node, result_type, value[2]);
    }
    if (node[0] == 24) { return resolve_call(node, environment); }
    return null;
}

fn resolve_collection_expression(node, environment) {
    if (node[0] == 25) {
        let effect_value = effects("pure"); let item_type = type_unknown(); let index = 0;
        while (index < array_length(node[1])) {
            let item = resolve_expression_with_environment(node[1][index], environment);
            if (index == 0) { item_type = item[1]; }
            else { if (!type_compatible(item_type, item[1])) { item_type = type_unknown(); } }
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, ["array", item_type], effect_value);
    }
    if (node[0] == 26) {
        let source = resolve_expression_with_environment(node[1], environment);
        let index_value = resolve_expression_with_environment(node[2], environment);
        exact_type(index_value[1], "index", node); let result_type = type_unknown();
        if (type_tag(source[1]) == "array") { result_type = source[1][1]; }
        return typed(node, result_type, effects_combine(source[2], index_value[2]));
    }
    return null;
}

fn resolve_expression_with_environment(node, environment) {
    let value = resolve_core_expression(node, environment);
    if (value != null) { return value; }
    value = resolve_collection_expression(node, environment);
    if (value != null) { return value; }
    return resolve_extended_expression(node, environment);
}

fn resolve_expression(node) { return resolve_expression_with_environment(node, environment_new()); }

fn statements_effect(statements) {
    let result = effects("pure"); let index = 0;
    while (index < array_length(statements)) { result = effects_combine(result, statements[index][2]); index = index + 1; }
    return result;
}

fn resolve_binding_statement(node, environment) {
    if (node[0] == 2) {
        let value = resolve_expression_with_environment(node[2], environment);
        environment_set(environment, node[1], value[1]);
        return [2, type_ordinary("statement"), value[2], node];
    }
    if (node[0] == 3) {
        let value = resolve_expression_with_environment(node[2], environment);
        if (node[1][0] == 21) {
            let target_type = environment_get(environment, node[1][1]);
            assert(type_compatible(target_type, value[1]), "assignment type mismatch");
            environment_set(environment, node[1][1], value[1]);
        }
        return [3, type_ordinary("statement"), effects_combine(value[2], effects("mutation")), node];
    }
    return null;
}

fn resolve_control_statement(node, environment) {
    if (node[0] == 4) {
        let predicate = resolve_expression_with_environment(node[1], environment);
        if (type_tag(predicate[1]) == "sample") { type_error(node, "if predicate requires explicit sample_value(...)"); }
        if (type_tag(predicate[1]) == "claim") { type_error(node, "if predicate requires explicit claim_value(...)"); }
        let then_resolved = resolve_list_with_environment(node[2], environment_clone(environment));
        let else_resolved = resolve_list_with_environment(node[3], environment_clone(environment));
        let branch_effect = effects_combine(statements_effect(then_resolved), statements_effect(else_resolved));
        if (type_tag(predicate[1]) == "information") {
            if (effects_external(branch_effect)) { type_error(node, "unresolved Information branches cannot perform effects"); }
        }
        return [4, type_ordinary("statement"), effects_combine(predicate[2], branch_effect), node];
    }
    if (node[0] == 5) {
        let predicate = resolve_expression_with_environment(node[1], environment);
        exact_type(predicate[1], "while predicate", node);
        let body = resolve_list_with_environment(node[2], environment_clone(environment));
        return [5, type_ordinary("statement"), effects_combine(predicate[2], statements_effect(body)), node];
    }
    return null;
}

fn resolve_value_statement(node, environment) {
    if (node[0] == 6) {
        let value = resolve_expression_with_environment(node[1], environment);
        return [6, type_ordinary("statement"), value[2], node];
    }
    if (node[0] == 7) {
        let value = resolve_expression_with_environment(node[1], environment);
        if (type_tag(value[1]) == "information") { type_error(node, "discarded unresolved Information value"); }
        if (type_tag(value[1]) == "sample") { type_error(node, "discarded Sample value"); }
        return [7, type_ordinary("statement"), value[2], node];
    }
    if (node[0] == 8) {
        let value = resolve_expression_with_environment(node[1], environment);
        exact_type(value[1], "print", node);
        return [8, type_ordinary("statement"), effects_combine(value[2], effects("io")), node];
    }
    return null;
}

fn resolve_task_statement(node, environment) {
    if (node[0] == 9) { return [9, type_ordinary("statement"), effects("mutation"), node]; }
    if (node[0] == 10) { return [10, type_ordinary("statement"), effects("mutation"), node]; }
    if (node[0] == 11) { return [11, type_ordinary("statement"), effects("mutation"), node]; }
    if (node[0] == 12) {
        let body = resolve_list_with_environment(node[1], environment_clone(environment));
        return [12, type_ordinary("statement"), effects_combine(statements_effect(body), effects("task")), node];
    }
    if (node[0] == 13) {
        let task = resolve_expression_with_environment(node[1], environment);
        return [13, type_ordinary("statement"), effects_combine(task[2], effects("task")), node];
    }
    return null;
}

fn resolve_statement_with_environment(node, environment) {
    let statement = resolve_binding_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_control_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_value_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_task_statement(node, environment);
    if (statement != null) { return statement; }
    assert(false, "unknown statement node");
    return [node[0], type_ordinary("statement"), effects("pure"), node];
}

fn resolve_list_with_environment(nodes, environment) {
    let result = array_new(0); let index = 0;
    while (index < array_length(nodes)) {
        array_push(result, resolve_statement_with_environment(nodes[index], environment)); index = index + 1;
    }
    return result;
}

fn resolve_list(nodes) { return resolve_list_with_environment(nodes, environment_new()); }

fn resolve_function(node) {
    let environment = environment_new(); let index = 0;
    while (index < array_length(node[2])) {
        environment_set(environment, node[2][index], type_unknown()); index = index + 1;
    }
    return [1, node[1], node[2], resolve_list_with_environment(node[3], environment), node[4]];
}

fn resolve_program(program) {
    let functions = array_new(0); let index = 0;
    while (index < array_length(program[1])) {
        array_push(functions, resolve_function(program[1][index])); index = index + 1;
    }
    return [100, functions, resolve_list_with_environment(program[2], environment_new()), program[3]];
}
