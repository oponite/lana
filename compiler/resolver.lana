                    if (map_has(objects, object["name"])) { oo_error(object, "duplicate object type name"); }
                    let inherited_fields = array_new(0); let inherited_methods = array_new(0);
                    if (parent != null) {
                        if (objects[parent]["kind"] != "class") { oo_error(object, "copies requires a same-module class"); }
                        if (map_has(objects[parent], "imported")) { oo_error(object, "cannot copy an imported class"); }
                        inherited_fields = objects[parent]["fields"]; inherited_methods = objects[parent]["methods"];
                    }
                    object["fields"] = oo_merge_members(inherited_fields, object["fields"]);
                    object["methods"] = oo_merge_members(inherited_methods, object["methods"]);
                    objects[object["name"]] = object;
                    pending[index] = null; remaining = remaining - 1; progress = true;
                }
            }
            index = index + 1;
        }
        if (!progress) { assert(false, "unknown, imported, or cyclic class blueprint"); }
    }
    let names = map_keys(objects); let index = 0;
    while (index < array_length(names)) {
        let object = objects[names[index]]; let fields = object["fields"]; let methods = object["methods"]; let member_index = 0;
        if (!map_has(object, "imported")) {
        while (member_index < array_length(fields)) {
            let field = fields[member_index]; let scan = 0;
            while (scan < array_length(methods)) { if (methods[scan]["name"] == field["name"]) { oo_error(field, "field and method names conflict"); } scan = scan + 1; }
            field["function"] = null;
