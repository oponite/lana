    if (name == "tensor_compare") { return type_unknown(); }
    if (name == "tensor_select") { return type_unknown(); }
    if (name == "gather") { return type_unknown(); }
    if (name == "cholesky_solve") { return type_unknown(); }
    if (name == "random_uniform") { return type_unknown(); }
    if (name == "random_normal") { return type_unknown(); }
    if (name == "device") { return type_unknown(); }
    if (name == "to_device") { return type_unknown(); }
    if (name == "to_cpu") { return type_unknown(); }
    if (name == "shape") { return type_ordinary("array"); }
    if (name == "ndim") { return type_ordinary("number"); }
    if (name == "matmul") { return type_ordinary("tensor"); }
    if (name == "gpu_matmul") { return type_ordinary("tensor"); }
    if (name == "density_operator") { return type_ordinary("nqubit_state"); }
    if (name == "povm") { return type_ordinary("povm"); }
    if (name == "channel") { return type_ordinary("channel"); }
    if (name == "observable") { return type_ordinary("observable"); }
    if (name == "tensor_product") { return type_ordinary("nqubit_state"); }
    if (name == "partial_trace") { return type_ordinary("nqubit_state"); }
    if (name == "measure_with") { return type_ordinary("array"); }
    if (name == "apply_to") { return type_ordinary("nqubit_state"); }
    if (name == "expect") { return type_ordinary("number"); }
    if (name == "mix") { return type_ordinary("nqubit_state"); }
    if (name == "trace_distance") { return type_ordinary("number"); }
    if (name == "is_separable") { return type_ordinary("string"); }
    if (name == "to_state") { return type_ordinary("state"); }
    if (name == "grad") { return type_ordinary("tensor"); }
    if (name == "vjp") { return type_ordinary("tensor"); }
    if (name == "sgd") { return type_ordinary("optimizer"); }
    if (name == "adam") { return type_ordinary("optimizer"); }
    if (name == "train") { return type_ordinary("training_result"); }
    if (name == "update") { return type_ordinary("training_result"); }
    if (name == "resume") { return type_ordinary("training_result"); }
    if (name == "mcmc") { return type_ordinary("inference_algorithm"); }
    if (name == "vi") { return type_ordinary("inference_algorithm"); }
    if (name == "smc") { return type_ordinary("inference_algorithm"); }
    if (name == "infer") { return type_ordinary("posterior"); }
    if (name == "state_tensor") { return type_ordinary("tensor"); }
    if (name == "append") { return type_ordinary("tensor"); }
    if (name == "measure") { return type_ordinary("tensor"); }
    if (name == "transform") { return type_ordinary("tensor"); }
    if (name == "sum") { return type_unknown(); }
    if (name == "mean") { return type_unknown(); }
    if (name == "max") { return type_ordinary("number"); }
    if (name == "min") { return type_ordinary("number"); }
    if (name == "set_new") { return type_set(type_unknown()); }
    if (name == "set_add") { return type_set(type_unknown()); }
    if (name == "set_contains") { return type_ordinary("bool"); }
    if (name == "set_union") { return type_set(type_unknown()); }
    if (name == "set_intersect") { return type_set(type_unknown()); }
    if (name == "set_difference") { return type_set(type_unknown()); }
    if (name == "format") { return type_ordinary("string"); }
    if (name == "format_number") { return type_ordinary("string"); }
    if (name == "char_length") { return type_ordinary("number"); }
    if (name == "string_codepoint_slice") { return type_ordinary("string"); }
    if (name == "to_upper") { return type_ordinary("string"); }
    if (name == "to_lower") { return type_ordinary("string"); }
    if (name == "regex_compile") { return type_result(type_ordinary("regex"), type_ordinary("string")); }
    if (name == "regex_match") { return type_result(type_ordinary("map"), type_ordinary("string")); }
    if (name == "regex_search") { return type_result(type_ordinary("map"), type_ordinary("string")); }
    if (name == "regex_replace") { return type_ordinary("string"); }
    return type_unknown();
}

fn literal_type(node) {
    if (node[1] == "number") { return type_ordinary("number"); }
    if (node[1] == "string") { return type_ordinary("string"); }
    if (node[1] == "bool") { return type_ordinary("bool"); }
    if (node[1] == "null") { return type_ordinary("null"); }
    return type_unknown();
}

fn environment_new() { return map_new(); }

fn environment_find(environment, name) {
    return map_has(environment, name);
}

fn environment_get(environment, name) {
    if (!map_has(environment, name)) { return type_unknown(); }
    return map_get(environment, name);
}

fn environment_set(environment, name, value_type) {
    map_set(environment, name, value_type);
    return null;
}

fn environment_clone(environment) {
    let result = map_new();
    let keys = map_keys(environment);
    let index = 0;
    while (index < array_length(keys)) {
        let key = keys[index];
        map_set(result, key, map_get(environment, key));
        index = index + 1;
    }
    return result;
}

fn type_error(node, message) {
    let line = node[array_length(node) - 2];
    let column = node[array_length(node) - 1];
    let location = string_concat("type error at line ", number_to_string(line));
    location = string_concat(location, " column ");
    location = string_concat(location, number_to_string(column));
    location = string_concat(location, ": ");
    assert(false, string_concat(location, message));
    return null;
}

// Symbol table: accumulated during resolution for the LSP query mode. The box
// holds [definitions, references]; definitions are [name, kind, type, line,
// column] and references are [name, line, column]. Line/column are 1-based.
// The box is carried inside the environment under a reserved key so it flows
// through the existing environment threading without changing signatures.
fn symbol_box_new() { return [array_new(0), array_new(0)]; }

fn symbol_box_of(environment) {
    if (!map_has(environment, "__symbols__")) { return null; }
    return map_get(environment, "__symbols__");
}

fn symbol_add_definition(environment, name, kind, value_type, line, column) {
    let box = symbol_box_of(environment);
    if (box != null) { array_push(box[0], [name, kind, value_type, line, column]); }
    return null;
}

fn symbol_add_reference(environment, name, line, column) {
    let box = symbol_box_of(environment);
    if (box != null) { array_push(box[1], [name, line, column]); }
    return null;
}

// Type registry: accumulated during resolution for ADT declarations. The box
// holds [variants, types]; variants maps a variant name to [type name, index,
// field count] and types maps a type name to its ordered variant names. It is
// carried inside the environment under a reserved key so it flows through the
// existing environment threading without changing signatures.
fn type_registry_new() { return [map_new(), map_new(), map_new()]; }

fn type_registry_of(environment) {
    if (!map_has(environment, "__types__")) { return null; }
    return map_get(environment, "__types__");
}

fn type_registry_add(registry, type_name, variant_name, index, field_count, field_types) {
    map_set(registry[0], variant_name, [type_name, index, field_count]);
    if (!map_has(registry[1], type_name)) { map_set(registry[1], type_name, array_new(0)); }
    array_push(map_get(registry[1], type_name), variant_name);
    map_set(registry[2], variant_name, field_types);
    return null;
}

fn type_registry_field_types(registry, variant_name) {
    if (!map_has(registry[2], variant_name)) { return null; }
    return map_get(registry[2], variant_name);
}

fn type_registry_lookup_variant(registry, name) {
    if (!map_has(registry[0], name)) { return null; }
    return map_get(registry[0], name);
}

fn type_registry_variants_of(registry, type_name) {
    if (!map_has(registry[1], type_name)) { return null; }
    return map_get(registry[1], type_name);
}

fn type_to_string(value_type) {
    let tag = type_tag(value_type);
    if (tag == "ordinary") { return value_type[1]; }
    if (tag == "information") { return string_concat("Information<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "claim") { return string_concat("Claim<", string_concat(type_to_string(value_type[1]), string_concat(", ", string_concat(value_type[2], ">")))); }
    if (tag == "sample") { return string_concat("Sample<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "planned_effect") { return string_concat("PlannedEffect<", string_concat(type_to_string(value_type[1]), string_concat(", ", string_concat(value_type[2], ">")))); }
    if (tag == "task_handle") { return string_concat("TaskHandle<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "capability") { return string_concat("Capability<", string_concat(value_type[1], ">")); }
    if (tag == "shared_capability") { return string_concat("SharedCapability<", string_concat(type_to_string(value_type[1]), string_concat(", ", string_concat(value_type[2], ">")))); }
    if (tag == "result") { return string_concat("Result<", string_concat(type_to_string(value_type[1]), string_concat(", ", string_concat(type_to_string(value_type[2]), ">")))); }
    if (tag == "generator") { return string_concat("Generator<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "future") { return string_concat("Future<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "set") { return string_concat("Set<", string_concat(type_to_string(value_type[1]), ">")); }
    if (tag == "tensor") { return string_concat("Tensor<", string_concat(shape_to_string(value_type[1]), ">")); }
    if (tag == "layer") { return string_concat("Layer<", string_concat(shape_to_string(value_type[1]), string_concat(", ", string_concat(shape_to_string(value_type[2]), ">")))); }
    return "unknown";
}

fn symbol_table_json(box) {
    let result = map_new();
    let definitions = array_new(0);
    let references = array_new(0);
    let index = 0;
    while (index < array_length(box[0])) {
        let def = box[0][index];
        let entry = map_new();
        map_set(entry, "name", def[0]);
        map_set(entry, "kind", def[1]);
        map_set(entry, "type", type_to_string(def[2]));
        map_set(entry, "line", def[3]);
        map_set(entry, "column", def[4]);
        array_push(definitions, entry);
        index = index + 1;
    }
    index = 0;
    while (index < array_length(box[1])) {
        let ref = box[1][index];
        let entry = map_new();
        map_set(entry, "name", ref[0]);
        map_set(entry, "line", ref[1]);
        map_set(entry, "column", ref[2]);
        array_push(references, entry);
        index = index + 1;
    }
    map_set(result, "definitions", definitions);
    map_set(result, "references", references);
    return result;
}

fn exact_type(value_type, operation, node) {
    if (type_tag(value_type) == "sample") {
        type_error(node, string_concat(operation, " requires explicit sample_value(...)"));
    }
    if (type_tag(value_type) == "claim") {
        type_error(node, string_concat(operation, " requires explicit claim_value(...)"));
    }
    if (type_tag(value_type) == "information") {
        type_error(node, string_concat(operation, " requires resolve(...) or explicit Information matching"));
    }
    if (type_tag(value_type) == "planned_effect") {
        type_error(node, string_concat(operation, " cannot consume an unexecuted planned effect"));
    }
    if (type_tag(value_type) == "result") {
        type_error(node, string_concat(operation, " requires explicit result_value(...) or result_error(...)"));
    }
    return value_type;
}

fn resolve_arguments(arguments, environment) {
    let result = array_new(0); let index = 0;
    while (index < array_length(arguments)) {
        array_push(result, resolve_expression_with_environment(arguments[index], environment));
        index = index + 1;
    }
    return result;
}

fn arguments_effect(resolved) {
    let result = effects("pure"); let index = 0;
    while (index < array_length(resolved)) { result = effects_combine(result, resolved[index][2]); index = index + 1; }
    return result;
}

fn require_argument_count(name, resolved, expected) {
    assert(array_length(resolved) == expected, string_concat(name, " has invalid argument count"));
    return null;
}

fn builtin_uncertainty_type(node, resolved) {
    let name = node[1];
    if (name == "information") {
        require_argument_count(name, resolved, 1); return type_information(resolved[0][1]);
    }
    if (name == "claim") {
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 20) { type_error(node, "claim proposition must be a string literal"); }
        if (node[2][1][1] != "string") { type_error(node, "claim proposition must be a string literal"); }
        return type_claim(resolved[0][1], node[2][1][2]);
    }
    if (name == "sample_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "sample") { type_error(node, "sample_value requires Sample<T>"); }
        return resolved[0][1][1];
    }
    if (name == "sample_metadata") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "sample") { type_error(node, "sample_metadata requires Sample<T>"); }
        return type_ordinary("map");
    }
    if (name == "claim_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_value requires Claim<T, Proposition>"); }
        return resolved[0][1][1];
    }
    if (name == "claim_proposition") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_proposition requires Claim<T, Proposition>"); }
        return type_ordinary("string");
    }
    if (name == "claim_status") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "claim") { type_error(node, "claim_status requires Claim<T, Proposition>"); }
        return type_ordinary("map");
    }
    if (name == "inspect_information") {
        require_argument_count(name, resolved, 1);
        return type_ordinary("map");
    }
    return null;
}

fn builtin_effect_type(node, resolved) {
    let name = node[1];
    if (name == "planned_effect") {
        require_argument_count(name, resolved, 2);
        if (node[2][0][0] != 20) { type_error(node, "planned_effect kind must be a string literal"); }
        if (node[2][0][1] != "string") { type_error(node, "planned_effect kind must be a string literal"); }
        if (!effect_kind_valid(node[2][0][2])) { type_error(node, "planned_effect has invalid effect kind"); }
        return type_planned_effect(resolved[1][1], node[2][0][2]);
    }
    if (name == "execute_effect") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "planned_effect") { type_error(node, "execute_effect requires PlannedEffect<T, Kind>"); }
        return resolved[0][1][1];
    }
    if (name == "effect_status") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "planned_effect") { type_error(node, "effect_status requires PlannedEffect<T, Kind>"); }
        return type_ordinary("map");
    }
    if (name == "capability") {
        require_argument_count(name, resolved, 1);
        if (node[2][0][0] != 20) { type_error(node, "capability name must be a string literal"); }
        if (node[2][0][1] != "string") { type_error(node, "capability name must be a string literal"); }
        return type_shared_capability("string", "admin");
    }
    return null;
}

fn require_shared_permission(node, resolved, permission, message) {
    if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, message); }
    if (resolved[0][1][2] != permission) { type_error(node, message); }
    return resolved[0][1][1];
}

fn builtin_state_type(node, resolved) {
    let name = node[1];
    if (name == "mix") {
        require_argument_count(name, resolved, 3);
        return type_unknown();
    }
    if (name == "map") {
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 21) { type_error(node, "map transform must be a bare identifier"); }
        return type_unknown();
    }
    if (name == "support") {
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 20) { type_error(node, "support limit must be a number literal"); }
        if (node[2][1][1] != "number") { type_error(node, "support limit must be a number literal"); }
        return type_unknown();
    }
    if (name == "expect") {
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 21) { type_error(node, "expect observable must be a bare identifier"); }
        return type_unknown();
    }
    if (name == "validate") {
        require_argument_count(name, resolved, 2);
        return type_unknown();
    }
    if (name == "revision") {
        require_argument_count(name, resolved, 1);
        return type_unknown();
    }
    if (name == "attenuate") {
        require_argument_count(name, resolved, 2);
        return type_unknown();
    }
    if (name == "trace_distance") {
        require_argument_count(name, resolved, 2);
        return type_ordinary("number");
    }
    return null;
}

fn builtin_lazy_type(node, resolved) {
    let name = node[1];
    if (name == "lazy") {
        require_argument_count(name, resolved, 2);
        if (node[2][0][0] != 21) { type_error(node, "lazy generator must be a function name"); }
        return type_ordinary("lazy");
    }
    if (name == "force") {
        require_argument_count(name, resolved, 2);
        return type_unknown();
    }
    if (name == "force_all") {
        require_argument_count(name, resolved, 1);
        return type_ordinary("array");
    }
    return null;
}

fn builtin_bootstrap_type(node, resolved) {
    let name = node[1];
    if (name != "bootstrap") { return null; }
    let count = array_length(resolved);
    if (count != 2) { if (count != 3) { type_error(node, "bootstrap requires 2 or 3 arguments"); } }
    if (node[2][1][0] != 21) { type_error(node, "bootstrap statistic must be a function name"); }
    return type_ordinary("map");
}

fn builtin_shared_admin_type(node, resolved) {
    let name = node[1]; let value_type = null;
    if (name == "shared_information") { require_argument_count(name, resolved, 1); return type_shared_capability(information_value_type(resolved[0][1]), "admin"); }
    if (name == "shared_grant") {
        require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "admin", "shared_grant requires an admin shared capability");
        if (node[2][1][0] != 20) { type_error(node, "shared_grant permission must be a string literal"); }
        if (node[2][1][1] != "string") { type_error(node, "shared_grant permission must be a string literal"); }
        if (!shared_permission_valid(node[2][1][2])) { type_error(node, "shared_grant permission must be read, observe, or admin"); }
        return type_shared_capability(value_type, node[2][1][2]);
    }
    if (name == "shared_revoke") {
        require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "admin", "shared_revoke requires admin and target shared capabilities");
        if (type_tag(resolved[1][1]) != "shared_capability") { type_error(node, "shared_revoke requires admin and target shared capabilities"); }
        return type_ordinary("null");
    }
    if (name == "grant") {
        require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "admin", "grant requires an admin capability");
        if (node[2][1][0] != 20) { type_error(node, "grant permission must be a string literal"); }
        if (node[2][1][1] != "string") { type_error(node, "grant permission must be a string literal"); }
        if (node[2][1][2] != "use") { if (node[2][1][2] != "admin") { type_error(node, "grant permission must be use or admin"); } }
        if (node[2][1][2] == "use") { return type_shared_capability(value_type, "read"); }
        return type_shared_capability(value_type, "admin");
    }
    if (name == "revoke") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, "revoke requires a shared capability"); }
        return type_ordinary("null");
    }
    return null;
}

fn builtin_shared_access_type(node, resolved) {
    let name = node[1]; let value_type = null;
    if (name == "shared_snapshot") { require_argument_count(name, resolved, 1); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_at") { require_argument_count(name, resolved, 2); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_wait") { require_argument_count(name, resolved, 3); value_type = require_shared_permission(node, resolved, "read", "shared read requires a read shared capability"); return type_information(value_type); }
    if (name == "shared_observe") {
        require_argument_count(name, resolved, 3); value_type = require_shared_permission(node, resolved, "observe", "shared_observe requires an observe shared capability");
        if (!type_compatible(value_type, information_value_type(resolved[1][1]))) { type_error(node, "shared_observe evidence type does not match shared Information"); }
        return type_ordinary("number");
    }
    return null;
}

fn builtin_shared_metadata_type(node, resolved) {
    let name = node[1];
    if (name == "shared_revision") { require_argument_count(name, resolved, 1); if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, "shared metadata requires a shared capability"); } return type_ordinary("number"); }
    if (name == "shared_identity") { require_argument_count(name, resolved, 1); if (type_tag(resolved[0][1]) != "shared_capability") { type_error(node, "shared metadata requires a shared capability"); } return type_ordinary("number"); }
    return null;
}

fn builtin_generator_type(node, resolved) {
    let name = node[1];
    if (name == "next") {
        require_argument_count(name, resolved, 1);
        let arg_type = resolved[0][1];
        if (type_tag(arg_type) == "generator") { return type_result(arg_type[1], type_unknown()); }
        if (type_tag(arg_type) == "ordinary") { if (arg_type[1] == "unknown") { return type_result(type_unknown(), type_unknown()); } }
        type_error(node, "next requires a Generator");
    }
    return null;
}

fn builtin_async_type(node, resolved) {
    let name = node[1];
    if (name == "run_async") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) == "future") { return resolved[0][1][1]; }
        return type_unknown();
    }
    if (name == "future_all") {
        require_argument_count(name, resolved, 1);
        return type_future(type_ordinary("array"));
    }
    if (name == "future_race") {
        require_argument_count(name, resolved, 1);
        return type_future(type_unknown());
    }
    if (name == "sleep") {
        require_argument_count(name, resolved, 1);
        return type_future(type_ordinary("null"));
    }
    return null;
}

fn builtin_set_type(node, resolved) {
    let name = node[1];
    if (name == "set_new") { require_argument_count(name, resolved, 0); return type_set(type_unknown()); }
    if (name == "set_add") { require_argument_count(name, resolved, 2); return type_set(type_unknown()); }
    if (name == "set_contains") { require_argument_count(name, resolved, 2); return type_ordinary("bool"); }
    if (name == "set_union") { require_argument_count(name, resolved, 2); return type_set(type_unknown()); }
    if (name == "set_intersect") { require_argument_count(name, resolved, 2); return type_set(type_unknown()); }
    if (name == "set_difference") { require_argument_count(name, resolved, 2); return type_set(type_unknown()); }
    return null;
}

fn name_suffix(name) {
    let i = string_length(name) - 1;
    while (i >= 0) {
        if (string_byte_at(name, i) == 46) { return string_slice(name, i + 1, string_length(name)); }
        i = i - 1;
    }
    return name;
}

fn is_function_name(environment, name) {
    let box = symbol_box_of(environment);
    if (box == null) { return false; }
    let definitions = box[0];
    let index = 0;
    while (index < array_length(definitions)) {
        if (definitions[index][0] == name) {
            if (definitions[index][1] == "function") { return true; }
        }
        index = index + 1;
    }
    return false;
}

fn builtin_iterator_type(node, resolved) {
    let name = node[1];
    let suffix = name_suffix(name);
    if (suffix == "iter") { require_argument_count(name, resolved, 1); return type_generator(type_unknown()); }
    if (suffix == "enumerate") { require_argument_count(name, resolved, 1); return type_generator(type_ordinary("array")); }
    if (suffix == "zip") { require_argument_count(name, resolved, 2); return type_generator(type_ordinary("array")); }
    return null;
}

fn builtin_iterator_call_type(node, resolved, effect_value, environment) {
    let name = node[1];
    if (name == "map") {
        // The iterator map takes a function name first and an iterable second;
        // the state-transform map (builtin_state_type) takes a distribution first
        // and a transform name second. Distinguish by whether the first argument
        // is a defined function: a function name means the iterator map.
        if (array_length(node[2]) > 0) {
            if (node[2][0][0] == 21) {
                if (is_function_name(environment, node[2][0][1])) {
                    require_argument_count(name, resolved, 2);
                    let is_generator = false;
                    if (array_length(resolved) >= 2) { is_generator = type_tag(resolved[1][1]) == "generator"; }
                    array_push(node, is_generator);
                    return typed(node, type_ordinary("array"), effect_value);
                }
            }
        }
        return null;
    }
    if (name == "filter") {
        if (array_length(node[2]) > 0) {
            if (node[2][0][0] == 21) {
                if (is_function_name(environment, node[2][0][1])) {
                    require_argument_count(name, resolved, 2);
                    let is_generator = false;
                    if (array_length(resolved) >= 2) { is_generator = type_tag(resolved[1][1]) == "generator"; }
                    array_push(node, is_generator);
                    return typed(node, type_ordinary("array"), effect_value);
                }
            }
        }
        // A Dataset first argument is the dataset filter, handled by
        // builtin_dataset_type; defer rather than erroring here.
        if (array_length(resolved) >= 1) {
            if (is_dataset_type(resolved[0][1])) { return null; }
        }
        type_error(node, "filter requires a function name as its first argument");
    }
    if (name == "reduce") {
        if (array_length(node[2]) > 0) {
            if (node[2][0][0] == 21) {
                if (is_function_name(environment, node[2][0][1])) {
                    require_argument_count(name, resolved, 3);
                    let is_generator = false;
                    if (array_length(resolved) >= 2) { is_generator = type_tag(resolved[1][1]) == "generator"; }
                    array_push(node, is_generator);
                    return typed(node, type_unknown(), effect_value);
                }
            }
        }
        type_error(node, "reduce requires a function name as its first argument");
    }
    return null;
}

fn builtin_result_type(node, resolved) {
    let name = node[1];
    if (name == "result_ok") {
        require_argument_count(name, resolved, 1); return type_result(resolved[0][1], type_unknown());
    }
    if (name == "result_error") {
        require_argument_count(name, resolved, 1); return type_result(type_unknown(), resolved[0][1]);
    }
    if (name == "result_is_ok") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_is_ok requires Result<T, E>"); }
        return type_ordinary("bool");
    }
    if (name == "result_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_value requires Result<T, E>"); }
        return resolved[0][1][1];
    }
    if (name == "result_error_value") {
        require_argument_count(name, resolved, 1);
        if (type_tag(resolved[0][1]) != "result") { type_error(node, "result_error_value requires Result<T, E>"); }
        return resolved[0][1][2];
    }
    return null;
}

fn string_to_int(text) {
    let result = 0; let index = 0;
    while (index < string_length(text)) {
        let byte = string_byte_at(text, index);
        if (byte < 48) { return -1; }
        if (byte > 57) { return -1; }
        result = result * 10 + (byte - 48);
        index = index + 1;
    }
    return result;
}

fn reduce_shape(shape, axis_resolved) {
    if (shape[0] != "shape") { return shape_dynamic(); }
    let axis_node = axis_resolved[3];
    if (axis_node[0] != 20) { return shape_dynamic(); }
    if (axis_node[1] != "number") { return shape_dynamic(); }
    let axis = string_to_int(axis_node[2]);
    if (axis < 0) { return shape_dynamic(); }
    let dims = shape[1];
    if (axis >= array_length(dims)) { return shape_dynamic(); }
    let result = array_new(0); let index = 0;
    while (index < array_length(dims)) {
        if (index != axis) { array_push(result, dims[index]); }
        index = index + 1;
    }
    return shape_literal(result);
}

fn check_optional_dtype(node, resolved) {
    let count = array_length(resolved);
    if (count == 1) { return null; }
    if (count == 2) {
        let dtype_node = resolved[1][3];
        if (dtype_node[0] != 20) { type_error(node, "dtype: must be a string literal"); }
        if (dtype_node[1] != "string") { type_error(node, "dtype: must be a string literal"); }
        return null;
    }
    type_error(node, "tensor constructor expects a shape and optional dtype");
    return null;
}

fn builtin_tensor_type(node, resolved) {
    let name = node[1];
    if (name == "zeros") { check_optional_dtype(node, resolved); return type_tensor(shape_of_expression(resolved[0])); }
    if (name == "ones") { check_optional_dtype(node, resolved); return type_tensor(shape_of_expression(resolved[0])); }
    if (name == "eye") {
        check_optional_dtype(node, resolved);
        let arg = resolved[0][3];
        if (arg[0] == 20) { if (arg[1] == "number") { return type_tensor(shape_literal([arg[2], arg[2]])); } }
        return type_tensor(shape_dynamic());
    }
    if (name == "tensor") { check_optional_dtype(node, resolved); return type_tensor(array_literal_shape(resolved[0][3])); }
    if (name == "tensor_complex") { require_argument_count(name, resolved, 2); return type_tensor(array_literal_shape(resolved[0][3])); }
    if (name == "matmul") {
        let count = array_length(resolved);
        if (count != 2) { if (count != 3) { type_error(node, "matmul expects two tensors and an optional out_dtype"); } }
        if (count == 3) {
            let dtype_node = resolved[2][3];
            if (dtype_node[0] != 20) { type_error(node, "out_dtype: must be a string literal"); }
            if (dtype_node[1] != "string") { type_error(node, "out_dtype: must be a string literal"); }
        }
        let shape = matmul_shape(tensor_shape_of(resolved[0]), tensor_shape_of(resolved[1]));
        if (is_uncertain_tensor_type(resolved[0][1])) { return type_uncertain(type_tensor(shape)); }
        if (is_uncertain_tensor_type(resolved[1][1])) { return type_uncertain(type_tensor(shape)); }
        return type_tensor(shape);
    }
    if (name == "shape") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], "shape", node);
        return type_ordinary("array");
    }
    if (name == "dtype") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], "dtype", node);
        return type_ordinary("string");
    }
    if (name == "ndim") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], "ndim", node);
        return type_ordinary("number");
    }
    if (name == "cast") {
        require_argument_count(name, resolved, 2);
        require_certain_tensor(resolved[0][1], "cast", node);
        let dtype_node = resolved[1][3];
        if (dtype_node[0] != 20) { type_error(node, "cast: dtype must be a string literal"); }
        if (dtype_node[1] != "string") { type_error(node, "cast: dtype must be a string literal"); }
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "reshape") {
        require_argument_count(name, resolved, 2);
        require_certain_tensor(resolved[0][1], "reshape", node);
        return type_tensor(shape_dynamic());
    }
    if (name == "transpose") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], "transpose", node);
        return type_tensor(shape_dynamic());
    }
    if (name == "exp") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "log") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "sqrt") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "relu") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "softmax") {
        let count = array_length(resolved);
        if (count != 1) { if (count != 2) { type_error(node, string_concat(name, " expects a tensor and optional axis")); } }
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(shape_dynamic());
    }
    if (name == "logsumexp") {
        let count = array_length(resolved);
        if (count != 1) { if (count != 2) { type_error(node, string_concat(name, " expects a tensor and optional axis")); } }
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(shape_dynamic());
    }
    if (name == "argmax") {
        let count = array_length(resolved);
        if (count != 1) { if (count != 2) { type_error(node, "argmax expects a tensor and optional axis"); } }
        require_certain_tensor(resolved[0][1], name, node);
        if (count == 1) { return type_ordinary("number"); }
        return type_tensor(shape_dynamic());
    }
    if (name == "tensor_compare") {
        require_argument_count(name, resolved, 3);
        require_certain_tensor(resolved[0][1], name, node);
        require_certain_tensor(resolved[1][1], name, node);
        return type_tensor(shape_dynamic());
    }
    if (name == "tensor_select") {
        require_argument_count(name, resolved, 3);
        require_certain_tensor(resolved[0][1], name, node);
        require_certain_tensor(resolved[1][1], name, node);
        require_certain_tensor(resolved[2][1], name, node);
        return type_tensor(shape_dynamic());
    }
    if (name == "gather") {
        require_argument_count(name, resolved, 3);
        require_certain_tensor(resolved[0][1], name, node);
        require_certain_tensor(resolved[1][1], name, node);
        return type_tensor(shape_dynamic());
    }
    if (name == "cholesky_solve") {
        require_argument_count(name, resolved, 2);
        require_certain_tensor(resolved[0][1], name, node);
        require_certain_tensor(resolved[1][1], name, node);
        return type_tensor(tensor_shape_of(resolved[1]));
    }
    if (name == "random_uniform") {
        require_argument_count(name, resolved, 2);
        return type_tensor(shape_dynamic());
    }
    if (name == "random_normal") {
        require_argument_count(name, resolved, 2);
        return type_tensor(shape_dynamic());
    }
    if (name == "device") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_ordinary("string");
    }
    if (name == "to_device") {
        require_argument_count(name, resolved, 3);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    if (name == "to_cpu") {
        require_argument_count(name, resolved, 1);
        require_certain_tensor(resolved[0][1], name, node);
        return type_tensor(tensor_shape_of(resolved[0]));
    }
    return null;
}

fn layer_input_shape(resolved) {
    let value_type = resolved[1];
    if (type_tag(value_type) == "layer") { return value_type[1]; }
    return shape_dynamic();
}

fn layer_output_shape(resolved) {
    let value_type = resolved[1];
    if (type_tag(value_type) == "layer") { return value_type[2]; }
    return shape_dynamic();
}

fn check_connection(node, feeding, fed) {
    let output = layer_output_shape(feeding);
    let input = layer_input_shape(fed);
    if (!shape_compatible(output, input)) {
        type_error(node, string_concat("connection shape mismatch: output ", string_concat(shape_to_string(output), string_concat(" does not match input ", shape_to_string(input)))));
    }
    return null;
}

fn resolve_layer_variant(node, resolved, effect_value) {
    let name = node[1];
    if (name == "Dense") {
        if (array_length(resolved) == 3) {
            let in_shape = shape_of_expression(resolved[0]);
            let out_shape = shape_of_expression(resolved[1]);
            let weights_shape = tensor_shape_of(resolved[2]);
            let expected = shape_concat(in_shape, out_shape);
            if (!shape_compatible(weights_shape, expected)) {
                type_error(node, string_concat("Dense weights shape ", string_concat(shape_to_string(weights_shape), string_concat(" does not match [in, out] = ", shape_to_string(expected)))));
            }
            return typed(node, type_layer(in_shape, out_shape), effect_value);
        }
    }
    if (name == "Conv") {
        if (array_length(resolved) == 3) {
            let in_shape = shape_of_expression(resolved[0]);
            let out_shape = shape_of_expression(resolved[1]);
            return typed(node, type_layer(in_shape, out_shape), effect_value);
        }
    }
    if (name == "Relu") {
        if (array_length(resolved) == 1) {
            let shape = shape_of_expression(resolved[0]);
            return typed(node, type_layer(shape, shape), effect_value);
        }
    }
    return typed(node, type_ordinary("Layer"), effect_value);
}

fn resolve_model_variant(node, resolved, effect_value) {
    let name = node[1];
    if (name == "Sequential") {
        if (array_length(resolved) == 2) { check_connection(node, resolved[0], resolved[1]); }
    }
    if (name == "Residual") {
        if (array_length(resolved) == 2) { check_connection(node, resolved[0], resolved[1]); }
    }
    if (name == "Branch") {
        if (array_length(resolved) == 3) { check_connection(node, resolved[0], resolved[1]); check_connection(node, resolved[0], resolved[2]); }
    }
    return typed(node, type_ordinary("Model"), effect_value);
}

fn resolve_variant_construction(node, resolved, variant, effect_value) {
    let type_name = variant[0];
    if (type_name == "Layer") { return resolve_layer_variant(node, resolved, effect_value); }
    if (type_name == "Model") { return resolve_model_variant(node, resolved, effect_value); }
    return typed(node, type_ordinary(type_name), effect_value);
}

fn is_dataset_type(value_type) {
    if (type_tag(value_type) == "uncertain") { return is_dataset_type(value_type[1]); }
    if (type_tag(value_type) == "ordinary") { return value_type[1] == "dataset"; }
    return false;
}

fn require_dataset(node, resolved, index) {
    if (!is_dataset_type(resolved[index][1])) { type_error(node, "dataset operation requires a Dataset"); }
}

fn builtin_dataset_type(node, resolved) {
    let name = node[1];
    if (name == "dataset") {
        require_argument_count(name, resolved, 1);
        return type_ordinary("dataset");
    }
    if (name == "filter") {
        if (array_length(resolved) < 1) { return null; }
        if (!is_dataset_type(resolved[0][1])) { return null; }
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 21) { type_error(node, "filter predicate must be a function name"); }
        node[1] = "dataset_filter";
        return type_ordinary("dataset");
    }
    if (name == "map") {
        if (array_length(resolved) < 1) { return null; }
        if (!is_dataset_type(resolved[0][1])) { return null; }
        require_argument_count(name, resolved, 2);
        if (node[2][1][0] != 21) { type_error(node, "map transform must be a function name"); }
        node[1] = "dataset_map";
        return type_ordinary("dataset");
    }
    if (name == "select") {
        require_argument_count(name, resolved, 2);
        require_dataset(node, resolved, 0);
        return type_ordinary("dataset");
    }
    if (name == "limit") {
        require_argument_count(name, resolved, 2);
        require_dataset(node, resolved, 0);
        return type_ordinary("dataset");
    }
    if (name == "sort") {
        require_argument_count(name, resolved, 2);
        require_dataset(node, resolved, 0);
        return type_ordinary("dataset");
    }
    if (name == "group_by") {
        require_argument_count(name, resolved, 2);
        require_dataset(node, resolved, 0);
        return type_ordinary("dataset");
    }
    if (name == "aggregate") {
        require_argument_count(name, resolved, 2);
        require_dataset(node, resolved, 0);
        return type_ordinary("dataset");
    }
    if (name == "join") {
        require_argument_count(name, resolved, 3);
        require_dataset(node, resolved, 0);
        require_dataset(node, resolved, 1);
        return type_ordinary("dataset");
    }
    if (name == "materialize") {
        require_argument_count(name, resolved, 1);
        require_dataset(node, resolved, 0);
        return type_ordinary("array");
    }
    if (name == "explain") {
        require_argument_count(name, resolved, 1);
        require_dataset(node, resolved, 0);
        node[1] = "dataset_explain";
        return type_ordinary("map");
    }
    return null;
}

fn builtin_call_type(node, resolved) {
    let name = node[1];
    let dataset_type = builtin_dataset_type(node, resolved);
    if (dataset_type != null) { return dataset_type; }
    let reduction = false;
    if (name == "sum") { reduction = true; } if (name == "mean") { reduction = true; }
    if (name == "max") { reduction = true; } if (name == "min") { reduction = true; }
    if (reduction) {
        let count = array_length(resolved);
        if (count != 1) { if (count != 2) { type_error(node, "tensor reduction expects a tensor and optional axis"); } }
        exact_type(resolved[0][1], "tensor reduction", node);
        let uncertain = is_uncertain_tensor_type(resolved[0][1]);
        if (uncertain) {
            if (name == "max") { type_error(node, "max requires a certain Tensor (extract .prediction first)"); }
            if (name == "min") { type_error(node, "min requires a certain Tensor (extract .prediction first)"); }
        }
        if (count == 2) {
            exact_type(resolved[1][1], "tensor reduction axis", node);
            let result = type_tensor(reduce_shape(tensor_shape_of(resolved[0]), resolved[1]));
            if (uncertain) { return type_uncertain(result); }
            return result;
        }
        if (name == "max") { return type_ordinary("number"); }
        if (name == "min") { return type_ordinary("number"); }
        // Element dtype is dynamic: full sum/mean may return a complex tensor.
        if (uncertain) { return type_uncertain(type_unknown()); }
        return type_unknown();
    }
    let value_type = builtin_uncertainty_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_effect_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_state_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_lazy_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_bootstrap_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_admin_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_access_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_shared_metadata_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_generator_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_async_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_set_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_iterator_type(node, resolved);
    if (value_type != null) { return value_type; }
    value_type = builtin_tensor_type(node, resolved);
    if (value_type != null) { return value_type; }
    return builtin_result_type(node, resolved);
}

fn resolve_call(node, environment) {
    symbol_add_reference(environment, node[1], node[3], node[4]);
    let resolved = resolve_arguments(node[2], environment);
    let effect_value = arguments_effect(resolved);
    let is_ad = false;
    if (node[1] == "grad") { is_ad = true; }
    if (node[1] == "vjp") { is_ad = true; }
    if (is_ad) {
        if (map_has(environment, "__uses_ad__")) { map_set(map_get(environment, "__uses_ad__"), "yes", true); }
        let expected = 2; if (node[1] == "vjp") { expected = 3; }
        require_argument_count(node[1], resolved, expected);
        if (node[2][0][0] != 21) { type_error(node, string_concat(node[1], " function must be a function name")); }
        let fname = node[2][0][1];
        let feffect = effects("external_call");
        if (map_has(environment, "__function_effects__")) {
            if (map_has(map_get(environment, "__function_effects__"), fname)) {
                feffect = map_get(map_get(environment, "__function_effects__"), fname);
            }
        }
        if (!effects_is_pure(feffect)) {
            type_error(node, string_concat(node[1], " requires a pure function"));
        }
        if (map_has(environment, "__function_ops__")) {
            if (map_has(map_get(environment, "__function_ops__"), fname)) {
                if (list_uses_non_diff_op(map_get(map_get(environment, "__function_ops__"), fname))) {
                    type_error(node, string_concat(node[1], " requires a differentiable function (max, min, and gpu_matmul are not differentiable)"));
                }
            }
        }
    }
    let registry = type_registry_of(environment);
    if (registry != null) {
        let variant = type_registry_lookup_variant(registry, node[1]);
        if (variant != null) {
            if (array_length(resolved) != variant[2]) {
                let message = string_concat("variant ", node[1]);
                message = string_concat(message, " expects ");
                message = string_concat(message, number_to_string(variant[2]));
                message = string_concat(message, " fields");
                type_error(node, message);
            }
            return resolve_variant_construction(node, resolved, variant, effect_value);
        }
    }
    if (map_has(environment, "__generators__")) {
        if (map_has(map_get(environment, "__generators__"), node[1])) {
            return typed(node, type_generator(type_unknown()), effect_value);
        }
    }
    if (map_has(environment, "__asyncs__")) {
        if (map_has(map_get(environment, "__asyncs__"), node[1])) {
            return typed(node, type_future(type_unknown()), effects_combine(effect_value, effects("io")));
        }
    }
    let iterator_type = builtin_iterator_call_type(node, resolved, effect_value, environment);
    if (iterator_type != null) { return iterator_type; }
    let builtin_type = builtin_call_type(node, resolved);
    if (builtin_type != null) {
        if (node[1] == "execute_effect") { effect_value = effects_combine(effect_value, effects(resolved[0][1][2])); }
        if (node[1] == "shared_observe") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "shared_grant") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "shared_revoke") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "grant") { effect_value = effects_combine(effect_value, effects("observation")); }
        if (node[1] == "revoke") { effect_value = effects_combine(effect_value, effects("observation")); }
        return typed(node, builtin_type, effect_value);
    }
    if (map_has(environment, "__function_effects__")) {
        if (map_has(map_get(environment, "__function_effects__"), node[1])) {
            effect_value = effects_combine(effect_value, map_get(map_get(environment, "__function_effects__"), node[1]));
            return typed(node, host_type(node[1]), effect_value);
        }
    }
    effect_value = effects_combine(effect_value, host_effect(node[1]));
    return typed(node, host_type(node[1]), effect_value);
}

fn resolve_match(node, environment) {
    let scrutinee = resolve_expression_with_environment(node[1], environment);
    let registry = type_registry_of(environment);
    let declared = null;
    if (registry != null) {
        if (type_tag(scrutinee[1]) == "ordinary") { declared = type_registry_variants_of(registry, scrutinee[1][1]); }
        if (type_tag(scrutinee[1]) == "layer") { declared = layer_variants(); }
    }
    let covered = map_new(); let has_wildcard = false; let has_unknown = false; let index = 0;
    while (index < array_length(node[2])) {
        let pattern = node[2][index][0];
        if (pattern[0] == "wildcard") { has_wildcard = true; }
        else { if (pattern[0] == "unknown") { has_unknown = true; }
        else {
            if (registry != null) {
                if (type_registry_lookup_variant(registry, pattern[1]) == null) {
                    type_error(node, string_concat("unknown variant ", pattern[1]));
                }
            }
            map_set(covered, pattern[1], true);
        } }
        index = index + 1;
    }
    if (declared != null) {
        if (!has_wildcard) {
            index = 0;
            while (index < array_length(declared)) {
                if (!map_has(covered, declared[index])) {
                    type_error(node, string_concat("match is not exhaustive: missing variant ", declared[index]));
                }
                index = index + 1;
            }
            if (!has_unknown) { type_error(node, "match is not exhaustive: missing unknown case"); }
        }
    }
    let result_type = type_unknown(); let effect_value = scrutinee[2]; let first = true; index = 0;
    while (index < array_length(node[2])) {
        let arm = node[2][index]; let pattern = arm[0]; let arm_env = environment_clone(environment);
        if (pattern[0] == "variant") {
            let bindings = pattern[2]; let binding_index = 0;
            while (binding_index < array_length(bindings)) {
                environment_set(arm_env, bindings[binding_index], type_unknown());
                symbol_add_definition(arm_env, bindings[binding_index], "binding", type_unknown(), node[3], node[4]);
                binding_index = binding_index + 1;
            }
        }
        let body = resolve_expression_with_environment(arm[1], arm_env);
        if (first) { result_type = body[1]; first = false; }
        else { if (!type_compatible(result_type, body[1])) { result_type = type_unknown(); } }
        effect_value = effects_combine(effect_value, body[2]);
        index = index + 1;
    }
    return typed(node, result_type, effect_value);
}

fn resolve_structure_expression(node, environment) {
    if (node[0] == 27) {
        let source = resolve_expression_with_environment(node[1], environment);
        let field = node[2];
        if (is_uncertain_tensor_type(source[1])) {
            if (field == "prediction") { return typed(node, uncertain_inner_type(source[1]), source[2]); }
            if (field == "uncertainty") { return typed(node, uncertain_inner_type(source[1]), source[2]); }
        }
        if (is_tensor_type(source[1])) {
            if (field == "uncertainty") { type_error(node, "uncertainty on a certain Tensor requires an Uncertain<Tensor>"); }
        }
        return typed(node, type_unknown(), source[2]);
    }
    if (node[0] == 28) {
        let effect_value = effects("pure"); let index = 0;
        let resolved_values = array_new(0);
        while (index < array_length(node[1])) {
            let item = resolve_expression_with_environment(node[1][index][1], environment);
            array_push(resolved_values, item);
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        // LIP-008 test seam: { prediction: t, uncertainty: u } is Uncertain<Tensor>.
        if (array_length(node[1]) == 2) {
            let key0 = node[1][0][0]; let key1 = node[1][1][0];
            let pred_index = -1; let unc_index = -1;
            if (key0 == "prediction") { pred_index = 0; }
            if (key1 == "prediction") { pred_index = 1; }
            if (key0 == "uncertainty") { unc_index = 0; }
            if (key1 == "uncertainty") { unc_index = 1; }
            if (pred_index >= 0) {
                if (unc_index >= 0) {
                    if (is_tensor_type(resolved_values[pred_index][1])) {
                        if (is_tensor_type(resolved_values[unc_index][1])) {
                            return typed(node, type_uncertain(resolved_values[pred_index][1]), effect_value);
                        }
                    }
                }
            }
        }
        return typed(node, type_ordinary("map"), effect_value);
    }
    if (node[0] == 29) {
        let effect_value = effects("pure"); let index = 0;
        while (index < array_length(node[3])) {
            let item = resolve_expression_with_environment(node[3][index], environment);
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, type_information(type_unknown()), effect_value);
    }
    if (node[0] == 30) {
        let rows = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_information(type_unknown()), rows[2]);
    }
    if (node[0] == 38) {
        let effect_value = effects("pure"); let index = 1;
        while (index <= 3) {
            let item = resolve_expression_with_environment(node[index], environment);
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, type_information(type_unknown()), effect_value);
    }
    return null;
}

fn resolve_information_operation(node, environment) {
    if (node[0] == 31) {
        let resolved = resolve_arguments(node[2], environment);
        let effect_value = arguments_effect(resolved);
        if (node[1] == "observe") {
            return typed(node, type_information(type_unknown()), effects_combine(effect_value, effects("observation")));
        }
        if (node[1] == "sample") {
            return typed(node, type_sample(type_unknown(), "information", "sample"), effects_combine(effect_value, effects("stochastic")));
        }
        if (node[1] == "resolve") {
            if (array_length(resolved) > 0) {
                if (type_tag(resolved[0][1]) == "information") { return typed(node, resolved[0][1][1], effect_value); }
            }
            return typed(node, type_unknown(), effect_value);
        }
        if (node[1] == "derivation") { return typed(node, type_ordinary("map"), effect_value); }
        if (node[1] == "explain") {
            // `explain(ds)` on a Dataset is the LIP-015 optimizer inspector, not
            // the provenance explain. Rewrite to a dataset host call in place.
            if (array_length(resolved) > 0) {
                if (is_dataset_type(resolved[0][1])) {
                    node[0] = 24; node[1] = "dataset_explain";
                    return typed(node, type_ordinary("map"), effect_value);
                }
            }
            return typed(node, type_ordinary("string"), effect_value);
        }
        if (node[1] == "append") {
            // LIP-007: append of STATE tensors is a differentiable tensor op
            // (HOST_CALL append). LIP-005: append of state values is a
            // state_dist relationship (APPEND opcode). Distinguish by argument
            // type: state values (state/nqubit_state/information) select the
            // LIP-005 relationship; everything else (tensors, and function
            // parameters typed unknown) selects the differentiable tensor op,
            // so rewrite the information node to a call node in place.
            if (array_length(resolved) == 2) {
                if (!is_state_value_type(resolved[0][1])) {
                    if (!is_state_value_type(resolved[1][1])) {
                        node[0] = 24;
                        return typed(node, type_ordinary("tensor"), effect_value);
                    }
                }
            }
        }
        return typed(node, type_information(type_unknown()), effect_value);
    }
    return null;
}

fn resolve_information_expression(node, environment) {
    let value = resolve_structure_expression(node, environment);
    if (value != null) { return value; }
    return resolve_information_operation(node, environment);
}

fn resolve_runtime_expression(node, environment) {
    if (node[0] == 32) {
        if (node[3] == "sample") {
            return typed(node, type_sample(type_unknown(), node[1], "measure"), effects("stochastic"));
        }
        return typed(node, type_unknown(), effects("pure"));
    }
    if (node[0] == 33) {
        return typed(node, type_sample(type_unknown(), node[1], "estimate_measure"), effects("stochastic"));
    }
    if (node[0] == 34) { return typed(node, type_unknown(), effects("pure")); }
    if (node[0] == 35) {
        let resolved = resolve_arguments(node[2], environment);
        return typed(node, type_task_handle(type_unknown(), ["join", "cancel"]), effects_combine(arguments_effect(resolved), effects("task")));
    }
    if (node[0] == 36) {
        let task = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_result(type_unknown(), type_ordinary("task_error")), effects_combine(task[2], effects("task")));
    }
    if (node[0] == 37) {
        let task = resolve_expression_with_environment(node[1], environment);
        let timeout = resolve_expression_with_environment(node[2], environment);
        return typed(node, type_result(type_unknown(), type_ordinary("timeout_error")),
                     effects_combine(effects_combine(task[2], timeout[2]), effects("task")));
    }
    return null;
}

fn resolve_extended_expression(node, environment) {
    let value = resolve_information_expression(node, environment);
    if (value != null) { return value; }
    value = resolve_runtime_expression(node, environment);
    if (value != null) { return value; }
    assert(false, "unknown expression node");
    return typed(node, type_unknown(), effects("pure"));
}

fn resolve_core_expression(node, environment) {
    if (node[0] == 20) { return typed(node, literal_type(node), effects("pure")); }
    if (node[0] == 21) {
        let registry = type_registry_of(environment);
        if (registry != null) {
            let variant = type_registry_lookup_variant(registry, node[1]);
            if (variant != null) {
                if (variant[2] == 0) { return typed(node, type_ordinary(variant[0]), effects("pure")); }
                type_error(node, string_concat("variant ", string_concat(node[1], " requires fields")));
            }
        }
        symbol_add_reference(environment, node[1], node[2], node[3]); return typed(node, environment_get(environment, node[1]), effects("pure"));
    }
    if (node[0] == 40) { return resolve_match(node, environment); }
    if (node[0] == 43) { return typed(node, type_unknown(), effects("pure")); }
    if (node[0] == 22) {
        let left = resolve_expression_with_environment(node[2], environment);
        let right = resolve_expression_with_environment(node[3], environment);
        let uncertain = type_tag(left[1]) == "information";
        if (type_tag(right[1]) == "information") { uncertain = true; }
        exact_type(information_value_type(left[1]), "binary operation", node); exact_type(information_value_type(right[1]), "binary operation", node);
        let result_type = type_ordinary("number");
        let left_tensor = is_tensor_type(left[1]);
        if (is_uncertain_tensor_type(left[1])) { left_tensor = true; }
        let right_tensor = is_tensor_type(right[1]);
        if (is_uncertain_tensor_type(right[1])) { right_tensor = true; }
        if (left_tensor) {
            if (right_tensor) {
                if (node[1] == "+") { result_type = type_tensor(elementwise_shape(tensor_shape_of(left), tensor_shape_of(right))); }
                if (node[1] == "-") { result_type = type_tensor(elementwise_shape(tensor_shape_of(left), tensor_shape_of(right))); }
                if (node[1] == "*") { result_type = type_tensor(elementwise_shape(tensor_shape_of(left), tensor_shape_of(right))); }
                if (node[1] == "/") { result_type = type_tensor(elementwise_shape(tensor_shape_of(left), tensor_shape_of(right))); }
                let uncertain_operand = is_uncertain_tensor_type(left[1]);
                if (is_uncertain_tensor_type(right[1])) { uncertain_operand = true; }
                if (uncertain_operand) { result_type = type_uncertain(result_type); }
            }
        }
        if (node[1] == "==") { result_type = type_ordinary("bool"); }
        if (node[1] == "!=") { result_type = type_ordinary("bool"); }
        if (node[1] == "<") { result_type = type_ordinary("bool"); }
        if (node[1] == "<=") { result_type = type_ordinary("bool"); }
        if (node[1] == ">") { result_type = type_ordinary("bool"); }
        if (node[1] == ">=") { result_type = type_ordinary("bool"); }
        if (uncertain) { result_type = type_information(result_type); }
        return typed(node, result_type, effects_combine(left[2], right[2]));
    }
    if (node[0] == 23) {
        let value = resolve_expression_with_environment(node[2], environment);
        let uncertain = type_tag(value[1]) == "information";
        let result_type = exact_type(information_value_type(value[1]), "unary operation", node);
        if (uncertain) { result_type = type_information(result_type); }
        return typed(node, result_type, value[2]);
    }
    if (node[0] == 24) { return resolve_call(node, environment); }
    if (node[0] == 45) {
        if (!map_has(environment, "__in_async__")) { type_error(node, "await outside an async function"); }
        if (!map_get(environment, "__in_async__")) { type_error(node, "await outside an async function"); }
        let value = resolve_expression_with_environment(node[1], environment);
        let result_type = type_unknown();
        if (type_tag(value[1]) == "future") { result_type = value[1][1]; }
        else {
            if (type_tag(value[1]) == "ordinary") {
                if (value[1][1] != "unknown") { type_error(node, "await requires a Future"); }
            } else { type_error(node, "await requires a Future"); }
        }
        return typed(node, result_type, value[2]);
    }
    return null;
}

fn resolve_collection_expression(node, environment) {
    if (node[0] == 25) {
        let effect_value = effects("pure"); let item_type = type_unknown(); let index = 0;
        while (index < array_length(node[1])) {
            let item = resolve_expression_with_environment(node[1][index], environment);
            if (index == 0) { item_type = item[1]; }
            else { if (!type_compatible(item_type, item[1])) { item_type = type_unknown(); } }
            effect_value = effects_combine(effect_value, item[2]); index = index + 1;
        }
        return typed(node, ["array", item_type], effect_value);
    }
    if (node[0] == 26) {
        let source = resolve_expression_with_environment(node[1], environment);
        let effect_value = source[2]; let result_type = type_unknown();
        let positions = node[2]; let index = 0;
        while (index < array_length(positions)) {
            let position = positions[index];
            if (position[0] == 39) {
                let start = resolve_expression_with_environment(position[1], environment);
                let end = resolve_expression_with_environment(position[2], environment);
                exact_type(start[1], "slice start", position);
                exact_type(end[1], "slice end", position);
                effect_value = effects_combine(effect_value, start[2]);
                effect_value = effects_combine(effect_value, end[2]);
            } else {
                let index_value = resolve_expression_with_environment(position, environment);
                exact_type(index_value[1], "index", position);
                effect_value = effects_combine(effect_value, index_value[2]);
            }
            index = index + 1;
        }
        if (type_tag(source[1]) == "array") {
            // Arrays take exactly one non-slice position (SPEC indexing
// * boundaries); maps and tensors have their own runtime rules.
            if (array_length(positions) != 1) { type_error(node, "array indexing accepts one position"); }
            if (positions[0][0] == 39) { type_error(node, "arrays cannot be sliced"); }
            result_type = source[1][1];
        }
        return typed(node, result_type, effect_value);
    }
    if (node[0] == 44) {
        let iterable = resolve_expression_with_environment(node[6], environment);
        let is_generator = type_tag(iterable[1]) == "generator";
        let is_sequence = is_generator;
        if (type_tag(iterable[1]) == "array") { is_sequence = true; }
        if (!is_sequence) {
            if (type_tag(iterable[1]) == "ordinary") {
                if (iterable[1][1] != "array") { if (iterable[1][1] != "unknown") { type_error(node, "comprehension iterable must be an array or generator"); } }
            } else { type_error(node, "comprehension iterable must be an array or generator"); }
        }
        let element_type = type_unknown();
        if (is_generator) { element_type = iterable[1][1]; }
        if (type_tag(iterable[1]) == "array") { element_type = iterable[1][1]; }
        let body_env = environment_clone(environment);
        let binding_type = element_type;
        if (node[1] == "map") { binding_type = type_unknown(); }
        environment_set(body_env, node[4], binding_type);
        symbol_add_definition(body_env, node[4], "variable", binding_type, node[8], node[9]);
        if (node[5] != null) {
            environment_set(body_env, node[5], binding_type);
            symbol_add_definition(body_env, node[5], "variable", binding_type, node[8], node[9]);
        }
        let effect_value = iterable[2];
        let element = resolve_expression_with_environment(node[2], body_env);
        effect_value = effects_combine(effect_value, element[2]);
        if (node[3] != null) {
            let value_expr = resolve_expression_with_environment(node[3], body_env);
            effect_value = effects_combine(effect_value, value_expr[2]);
        }
        if (node[7] != null) {
            let filter = resolve_expression_with_environment(node[7], body_env);
            effect_value = effects_combine(effect_value, filter[2]);
        }
        let result_type = type_unknown();
        if (node[1] == "list") { result_type = ["array", element[1]]; }
        if (node[1] == "set") { result_type = type_set(element[1]); }
        if (node[1] == "map") { result_type = type_ordinary("map"); }
        array_push(node, is_generator);
        return typed(node, result_type, effect_value);
    }
    return null;
}

fn resolve_expression_with_environment(node, environment) {
    let value = resolve_core_expression(node, environment);
    if (value != null) { return value; }
    value = resolve_collection_expression(node, environment);
    if (value != null) { return value; }
    return resolve_extended_expression(node, environment);
}

fn resolve_expression(node) { return resolve_expression_with_environment(node, environment_new()); }

fn statements_effect(statements) {
    let result = effects("pure"); let index = 0;
    while (index < array_length(statements)) { result = effects_combine(result, statements[index][2]); index = index + 1; }
    return result;
}

fn resolve_binding_statement(node, environment) {
    if (node[0] == 2) {
        let value = resolve_expression_with_environment(node[3], environment);
        let value_type = value[1];
        if (node[2] != null) { value_type = resolve_type_annotation(node[2], environment); }
        environment_set(environment, node[1], value_type);
        symbol_add_definition(environment, node[1], "variable", value_type, node[4], node[5]);
        return [2, value_type, value[2], node];
    }
    if (node[0] == 3) {
        let value = resolve_expression_with_environment(node[2], environment);
        if (node[1][0] == 21) {
            let target_type = environment_get(environment, node[1][1]);
            assert(type_compatible(target_type, value[1]), "assignment type mismatch");
            environment_set(environment, node[1][1], value[1]);
            if (map_has(environment, "__branch_writes__")) { map_set(map_get(environment, "__branch_writes__"), node[1][1], true); }
            return [3, value[1], value[2], node];
        }
        return [3, type_ordinary("statement"), effects_combine(value[2], effects("mutation")), node];
    }
    return null;
}

fn resolve_control_statement(node, environment) {
    if (node[0] == 4) {
        let predicate = resolve_expression_with_environment(node[1], environment);
        if (type_tag(predicate[1]) == "sample") { type_error(node, "if predicate requires explicit sample_value(...)"); }
        if (type_tag(predicate[1]) == "claim") { type_error(node, "if predicate requires explicit claim_value(...)"); }
        let then_env = environment_clone(environment);
        let else_env = environment_clone(environment);
        let writes = map_new();
        map_set(then_env, "__branch_writes__", writes);
        map_set(else_env, "__branch_writes__", writes);
        let then_resolved = resolve_list_with_environment(node[2], then_env);
        let else_resolved = resolve_list_with_environment(node[3], else_env);
        let branch_effect = effects_combine(statements_effect(then_resolved), statements_effect(else_resolved));
        if (type_tag(predicate[1]) == "information") {
            if (effects_external(branch_effect)) { type_error(node, "unresolved Information branches cannot perform effects"); }
        }
        let keys = map_keys(writes); let index = 0; let joined_types = map_new();
        while (index < array_length(keys)) {
            let name = keys[index];
            if (map_has(environment, name)) {
                let left = environment_get(then_env, name);
                let right = environment_get(else_env, name);
                let joined = left;
                if (!type_compatible(left, right)) { joined = type_unknown(); }
                let uncertain = type_tag(predicate[1]) == "information";
                if (type_tag(left) == "information") { uncertain = true; }
                if (type_tag(right) == "information") { uncertain = true; }
                if (uncertain) { joined = type_information(information_value_type(joined)); }
                environment_set(environment, name, joined);
                map_set(joined_types, name, joined);
                if (map_has(environment, "__branch_writes__")) { map_set(map_get(environment, "__branch_writes__"), name, true); }
            }
            index = index + 1;
        }
        return [4, type_ordinary("statement"), effects_combine(predicate[2], branch_effect),
                [4, node[1], then_resolved, else_resolved, type_tag(predicate[1]) == "information", joined_types, node[4], node[5]]];
    }
    if (node[0] == 5) {
        let predicate = resolve_expression_with_environment(node[1], environment);
        exact_type(predicate[1], "while predicate", node);
        let body = resolve_list_with_environment(node[2], environment_clone(environment));
        return [5, type_ordinary("statement"), effects_combine(predicate[2], statements_effect(body)),
                [5, node[1], body, node[3], node[4]]];
    }
    if (node[0] == 15) {
        let iterable = resolve_expression_with_environment(node[2], environment);
        let is_generator = type_tag(iterable[1]) == "generator";
        let is_sequence = is_generator;
        if (type_tag(iterable[1]) == "array") { is_sequence = true; }
        if (!is_sequence) {
            if (type_tag(iterable[1]) == "ordinary") {
                if (iterable[1][1] != "array") { if (iterable[1][1] != "unknown") { type_error(node, "for iterable must be an array or generator"); } }
            } else { type_error(node, "for iterable must be an array or generator"); }
        }
        let element_type = type_unknown();
        if (is_generator) { element_type = iterable[1][1]; }
        let body_env = environment_clone(environment);
        if (type_tag(iterable[1]) == "array") { element_type = iterable[1][1]; }
        environment_set(body_env, node[1], element_type);
        symbol_add_definition(body_env, node[1], "variable", element_type, node[4], node[5]);
        let body = resolve_list_with_environment(node[3], body_env);
        return [15, type_ordinary("statement"), effects_combine(iterable[2], statements_effect(body)), [15, node[1], node[2], body, is_generator, node[4], node[5]]];
    }
    return null;
}

fn resolve_value_statement(node, environment) {
    if (node[0] == 6) {
        let value = resolve_expression_with_environment(node[1], environment);
        return [6, type_ordinary("statement"), value[2], node];
    }
    if (node[0] == 7) {
        let value = resolve_expression_with_environment(node[1], environment);
        if (type_tag(value[1]) == "information") { type_error(node, "discarded unresolved Information value"); }
        if (type_tag(value[1]) == "sample") { type_error(node, "discarded Sample value"); }
        return [7, type_ordinary("statement"), value[2], node];
    }
    if (node[0] == 8) {
        let value = resolve_expression_with_environment(node[1], environment);
        exact_type(value[1], "print", node);
        return [8, type_ordinary("statement"), effects_combine(value[2], effects("io")), node];
    }
    if (node[0] == 14) {
        if (!map_has(environment, "__in_generator__")) { type_error(node, "yield outside a generator function"); }
        if (!map_get(environment, "__in_generator__")) { type_error(node, "yield outside a generator function"); }
        let value = resolve_expression_with_environment(node[1], environment);
        return [14, type_ordinary("statement"), value[2], node];
    }
    return null;
}

fn resolve_task_statement(node, environment) {
    if (node[0] == 9) {
        environment_set(environment, node[1], type_ordinary("state"));
        symbol_add_definition(environment, node[1], "variable", type_ordinary("state"), node[3], node[4]);
        return [9, type_ordinary("statement"), effects("mutation"), node];
    }
    if (node[0] == 10) { return [10, type_ordinary("statement"), effects("mutation"), node]; }
    if (node[0] == 11) { return [11, type_ordinary("statement"), effects("mutation"), node]; }
    if (node[0] == 12) {
        let body = resolve_list_with_environment(node[1], environment_clone(environment));
        return [12, type_ordinary("statement"), effects_combine(statements_effect(body), effects("task")),
                [12, body, node[2], node[3]]];
    }
    if (node[0] == 13) {
        let task = resolve_expression_with_environment(node[1], environment);
        return [13, type_ordinary("statement"), effects_combine(task[2], effects("task")), node];
    }
    return null;
}

fn resolve_statement_with_environment(node, environment) {
    let statement = resolve_binding_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_control_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_value_statement(node, environment);
    if (statement != null) { return statement; }
    statement = resolve_task_statement(node, environment);
    if (statement != null) { return statement; }
    assert(false, "unknown statement node");
    return [node[0], type_ordinary("statement"), effects("pure"), node];
}

fn resolve_list_with_environment(nodes, environment) {
    let result = array_new(0); let index = 0;
    while (index < array_length(nodes)) {
        array_push(result, resolve_statement_with_environment(nodes[index], environment)); index = index + 1;
    }
    return result;
}

fn resolve_list(nodes, in_generator, in_async) {
    let environment = environment_new();
    map_set(environment, "__in_generator__", in_generator);
    map_set(environment, "__in_async__", in_async);
    return resolve_list_with_environment(nodes, environment);
}

fn resolve_list_with_binding(nodes, name, value_type, in_generator, in_async) {
    let environment = environment_new();
    map_set(environment, "__in_generator__", in_generator);
    map_set(environment, "__in_async__", in_async);
    environment_set(environment, name, value_type);
    return resolve_list_with_environment(nodes, environment);
}

fn statement_contains_yield(node) {
    if (node[0] == 14) { return true; }
    if (node[0] == 4) { if (list_contains_yield(node[2])) { return true; } return list_contains_yield(node[3]); }
    if (node[0] == 5) { return list_contains_yield(node[2]); }
    if (node[0] == 15) { return list_contains_yield(node[3]); }
    if (node[0] == 12) { return list_contains_yield(node[1]); }
    return false;
}

fn list_contains_yield(nodes) {
    let index = 0;
    while (index < array_length(nodes)) {
        if (statement_contains_yield(nodes[index])) { return true; }
        index = index + 1;
    }
    return false;
}

fn entries_contain_await(entries) {
    let index = 0;
    while (index < array_length(entries)) {
        if (node_contains_await(entries[index][1])) { return true; }
        index = index + 1;
    }
    return false;
}

fn arms_contain_await(arms) {
    let index = 0;
    while (index < array_length(arms)) {
        if (node_contains_await(arms[index][1])) { return true; }
        index = index + 1;
    }
    return false;
}

fn list_contains_await(nodes) {
    let index = 0;
    while (index < array_length(nodes)) {
        if (node_contains_await(nodes[index])) { return true; }
        index = index + 1;
    }
    return false;
}

fn node_contains_await(node) {
    if (node[0] == 45) { return true; }
    if (node[0] == 24) { return list_contains_await(node[2]); }
    if (node[0] == 2) { return node_contains_await(node[3]); }
    if (node[0] == 3) { if (node_contains_await(node[1])) { return true; } return node_contains_await(node[2]); }
    if (node[0] == 4) { if (node_contains_await(node[1])) { return true; } if (list_contains_await(node[2])) { return true; } return list_contains_await(node[3]); }
    if (node[0] == 5) { if (node_contains_await(node[1])) { return true; } return list_contains_await(node[2]); }
    if (node[0] == 6) { return node_contains_await(node[1]); }
    if (node[0] == 7) { return node_contains_await(node[1]); }
    if (node[0] == 8) { return node_contains_await(node[1]); }
    if (node[0] == 9) { return entries_contain_await(node[2]); }
    if (node[0] == 10) { return node_contains_await(node[3]); }
    if (node[0] == 12) { return list_contains_await(node[1]); }
    if (node[0] == 13) { return node_contains_await(node[1]); }
    if (node[0] == 14) { return node_contains_await(node[1]); }
    if (node[0] == 15) { if (node_contains_await(node[2])) { return true; } return list_contains_await(node[3]); }
    if (node[0] == 22) { if (node_contains_await(node[2])) { return true; } return node_contains_await(node[3]); }
    if (node[0] == 23) { return node_contains_await(node[2]); }
    if (node[0] == 25) { return list_contains_await(node[1]); }
    if (node[0] == 26) { if (node_contains_await(node[1])) { return true; } return list_contains_await(node[2]); }
    if (node[0] == 27) { return node_contains_await(node[1]); }
    if (node[0] == 28) { return entries_contain_await(node[1]); }
    if (node[0] == 29) { return list_contains_await(node[3]); }
    if (node[0] == 30) { return node_contains_await(node[2]); }
    if (node[0] == 31) { return list_contains_await(node[2]); }
    if (node[0] == 35) { return list_contains_await(node[2]); }
    if (node[0] == 36) { return node_contains_await(node[2]); }
    if (node[0] == 37) { if (node_contains_await(node[1])) { return true; } return node_contains_await(node[2]); }
    if (node[0] == 38) { if (node_contains_await(node[1])) { return true; } if (node_contains_await(node[2])) { return true; } return node_contains_await(node[3]); }
    if (node[0] == 39) { if (node_contains_await(node[1])) { return true; } return node_contains_await(node[2]); }
    if (node[0] == 40) { if (node_contains_await(node[1])) { return true; } return arms_contain_await(node[2]); }
    if (node[0] == 44) { if (node_contains_await(node[2])) { return true; } if (node[3] != null) { if (node_contains_await(node[3])) { return true; } } if (node_contains_await(node[6])) { return true; } if (node[7] != null) { return node_contains_await(node[7]); } return false; }
    return false;
}

fn entries_use_op(entries, op_name) {
    let index = 0;
    while (index < array_length(entries)) {
        if (node_uses_op(entries[index][1], op_name)) { return true; }
        index = index + 1;
    }
    return false;
}

fn arms_use_op(arms, op_name) {
    let index = 0;
    while (index < array_length(arms)) {
        if (node_uses_op(arms[index][1], op_name)) { return true; }
        index = index + 1;
    }
    return false;
}

fn list_uses_op(nodes, op_name) {
    let index = 0;
    while (index < array_length(nodes)) {
        if (node_uses_op(nodes[index], op_name)) { return true; }
        index = index + 1;
    }
    return false;
}

fn node_uses_op(node, op_name) {
    if (node[0] == 24) {
        if (node[1] == op_name) { return true; }
        return list_uses_op(node[2], op_name);
    }
    if (node[0] == 2) { return node_uses_op(node[3], op_name); }
    if (node[0] == 3) { if (node_uses_op(node[1], op_name)) { return true; } return node_uses_op(node[2], op_name); }
    if (node[0] == 4) { if (node_uses_op(node[1], op_name)) { return true; } if (list_uses_op(node[2], op_name)) { return true; } return list_uses_op(node[3], op_name); }
    if (node[0] == 5) { if (node_uses_op(node[1], op_name)) { return true; } return list_uses_op(node[2], op_name); }
    if (node[0] == 6) { return node_uses_op(node[1], op_name); }
    if (node[0] == 7) { return node_uses_op(node[1], op_name); }
    if (node[0] == 8) { return node_uses_op(node[1], op_name); }
    if (node[0] == 9) { return entries_use_op(node[2], op_name); }
    if (node[0] == 10) { return node_uses_op(node[3], op_name); }
    if (node[0] == 12) { return list_uses_op(node[1], op_name); }
    if (node[0] == 13) { return node_uses_op(node[1], op_name); }
    if (node[0] == 14) { return node_uses_op(node[1], op_name); }
    if (node[0] == 15) { if (node_uses_op(node[2], op_name)) { return true; } return list_uses_op(node[3], op_name); }
    if (node[0] == 22) { if (node_uses_op(node[2], op_name)) { return true; } return node_uses_op(node[3], op_name); }
    if (node[0] == 23) { return node_uses_op(node[2], op_name); }
    if (node[0] == 25) { return list_uses_op(node[1], op_name); }
    if (node[0] == 26) { if (node_uses_op(node[1], op_name)) { return true; } return list_uses_op(node[2], op_name); }
    if (node[0] == 27) { return node_uses_op(node[1], op_name); }
    if (node[0] == 28) { return entries_use_op(node[1], op_name); }
    if (node[0] == 29) { return list_uses_op(node[3], op_name); }
    if (node[0] == 30) { return node_uses_op(node[2], op_name); }
    if (node[0] == 31) { return list_uses_op(node[2], op_name); }
    if (node[0] == 35) { return list_uses_op(node[2], op_name); }
    if (node[0] == 36) { return node_uses_op(node[2], op_name); }
    if (node[0] == 37) { if (node_uses_op(node[1], op_name)) { return true; } return node_uses_op(node[2], op_name); }
    if (node[0] == 38) { if (node_uses_op(node[1], op_name)) { return true; } if (node_uses_op(node[2], op_name)) { return true; } return node_uses_op(node[3], op_name); }
    if (node[0] == 39) { if (node_uses_op(node[1], op_name)) { return true; } return node_uses_op(node[2], op_name); }
    if (node[0] == 40) { if (node_uses_op(node[1], op_name)) { return true; } return arms_use_op(node[2], op_name); }
    if (node[0] == 44) { if (node_uses_op(node[2], op_name)) { return true; } if (node_uses_op(node[3], op_name)) { return true; } if (node_uses_op(node[6], op_name)) { return true; } if (node[7] != null) { return node_uses_op(node[7], op_name); } return false; }
    return false;
}

fn list_uses_non_diff_op(nodes) {
    if (list_uses_op(nodes, "max")) { return true; }
    if (list_uses_op(nodes, "min")) { return true; }
    return list_uses_op(nodes, "gpu_matmul");
}

fn resolve_function(node, box, registry, generators, asyncs, function_effects, uses_ad, function_ops) {
    let environment = environment_new(); let index = 0;
    map_set(environment, "__symbols__", box);
    map_set(environment, "__types__", registry);
    map_set(environment, "__generators__", generators);
    map_set(environment, "__asyncs__", asyncs);
    map_set(environment, "__function_effects__", function_effects);
    map_set(environment, "__uses_ad__", uses_ad);
    map_set(environment, "__function_ops__", function_ops);
    let is_generator = map_has(generators, node[1]);
    let is_async = map_has(asyncs, node[1]);
    if (is_generator) { if (is_async) { assert(false, "a function cannot be both a generator and async"); } }
    map_set(environment, "__in_generator__", is_generator);
    map_set(environment, "__in_async__", is_async);
    symbol_add_definition(environment, node[1], "function", type_ordinary("function"), node[5], node[6]);
    while (index < array_length(node[3])) {
        environment_set(environment, node[3][index], type_unknown());
        symbol_add_definition(environment, node[3][index], "parameter", type_unknown(), node[5], node[6]);
        index = index + 1;
    }
    let body = resolve_list_with_environment(node[4], environment);
    let feffect = statements_effect(body);
    if (is_async) { feffect = effects_add(feffect, "io"); }
    map_set(function_effects, node[1], feffect);
    return [1, node[1], node[2], node[3], body, node[5], is_generator, is_async];
}

fn resolve_type_declaration(node, environment) {
    let registry = type_registry_of(environment);
    let name = node[1]; let variants = node[3]; let index = 0;
    while (index < array_length(variants)) {
        let variant = variants[index];
        let field_types = array_new(0); let field_index = 0;
        while (field_index < array_length(variant[2])) { array_push(field_types, variant[2][field_index][1]); field_index = field_index + 1; }
        type_registry_add(registry, name, variant[1], index, array_length(variant[2]), field_types);
        index = index + 1;
    }
    symbol_add_definition(environment, name, "type", type_ordinary(name), node[4], node[5]);
    return null;
}

fn resolve_program(program) {
    let box = symbol_box_new();
    let registry = type_registry_new();
    let generators = map_new();
    let asyncs = map_new();
    let function_effects = map_new();
    let uses_ad = map_new();
    let function_ops = map_new();
    let top_environment = environment_new();
    map_set(top_environment, "__symbols__", box);
    map_set(top_environment, "__types__", registry);
    map_set(top_environment, "__generators__", generators);
    map_set(top_environment, "__asyncs__", asyncs);
    map_set(top_environment, "__function_effects__", function_effects);
    map_set(top_environment, "__uses_ad__", uses_ad);
    map_set(top_environment, "__function_ops__", function_ops);
    let index = 0;
    while (index < array_length(program[4])) {
        resolve_type_declaration(program[4][index], top_environment); index = index + 1;
    }
    index = 0;
    while (index < array_length(program[1])) {
        map_set(function_ops, program[1][index][1], program[1][index][4]);
        if (list_contains_yield(program[1][index][4])) { map_set(generators, program[1][index][1], true); }
        if (program[1][index][7]) { map_set(asyncs, program[1][index][1], true); }
        index = index + 1;
    }
    let functions = array_new(0); index = 0;
    while (index < array_length(program[1])) {
        array_push(functions, resolve_function(program[1][index], box, registry, generators, asyncs, function_effects, uses_ad, function_ops)); index = index + 1;
    }
    let statements = resolve_list_with_environment(program[2], top_environment);
    return [100, functions, statements, program[3], box, registry, map_has(uses_ad, "yes")];
}
