    if (name == "ledger_query") { return effects("io"); }
    if (name == "csv_read") { return effects("io"); }
    if (name == "csv_write") { return effects("io"); }
    if (name == "args") { return effects("external_call"); }
    if (name == "getenv") { return effects("external_call"); }
    if (name == "now") { return effects("external_call"); }
    if (name == "random") { return effects("stochastic"); }
    if (name == "random_seed") { return effects("stochastic"); }
    if (name == "infer") { return effects("stochastic"); }
    if (name == "floor") { return effects("pure"); }
    if (name == "string_to_number") { return effects("pure"); }
    if (name == "type_of") { return effects("pure"); }
    if (name == "assert") { return effects("external_call"); }
    if (name == "index_set") { return effects("mutation"); }
    if (name == "array_push") { return effects("mutation"); }
    if (name == "run_async") { return effects("io"); }
    if (name == "future_all") { return effects("io"); }
    if (name == "future_race") { return effects("io"); }
