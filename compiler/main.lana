import "./parser.lana" as parser;
import "./resolver.lana" as resolver;
import "./ir.lana" as ir;
import "./emitter.lana" as emitter;

fn stack_with(stack, value) {
    let result = array_new(0); let index = 0;
    while (index < array_length(stack)) { array_push(result, stack[index]); index = index + 1; }
    array_push(result, value); return result;
}

fn load_module(path, prefix, modules, stack, root) {
    let canonical = path_resolve(path, "");
    let index = 0; while (index < array_length(stack)) { if (stack[index] == canonical) { assert(false, "import cycle detected"); } index = index + 1; }
    if (map_has(modules, canonical)) { return map_get(modules, canonical); }
    let syntax_tree = parser.parse(read_text(canonical));
    if (!root) { assert(array_length(syntax_tree[2]) == 0, "imported modules cannot execute statements"); }
    let semantic_ir = ir.lower(resolver.resolve_program(syntax_tree));
    let module_index = array_length(modules["items"]);
    let module_index_str = number_to_string(module_index);
    map_set(modules, canonical, module_index);
    array_push(modules["items"], null);
    let local_names = map_new();
    let index2 = 0;
    while (index2 < array_length(semantic_ir[1])) {
        let name = semantic_ir[1][index2][1];
        map_set(local_names, name, string_concat(prefix, name));
        index2 = index2 + 1;
    }
    map_set(modules["mappings"], module_index_str, local_names);
    let next_stack = stack_with(stack, canonical);
    let import_names = map_new();
    let import_index = 0;
    while (import_index < array_length(syntax_tree[3])) {
        let imported = syntax_tree[3][import_index]; let target = path_resolve(canonical, imported[0]);
        let child_prefix = string_concat("__m", number_to_string(array_length(modules["items"])), "__");
        let child_index = load_module(target, child_prefix, modules, next_stack, false);
        let child_record = modules["items"][child_index];
        let child_exports = child_record[2][1];
        let exp_index = 0;
        while (exp_index < array_length(child_exports)) {
            let name = child_exports[exp_index][1];
            map_set(import_names, string_concat(imported[1], ".", name), string_concat(child_record[1], name));
            exp_index = exp_index + 1;
        }
        import_index = import_index + 1;
    }
    let record = [canonical, prefix, semantic_ir, import_names];
    index_set(modules["items"], module_index, record);
    map_set(modules["import_mappings"], module_index_str, import_names);
    return module_index;
}

let argv = args(); assert(array_length(argv) == 2, "usage: lana-compiler <input.lana> <output.lasm>");
let modules = map_new(); map_set(modules, "items", array_new(0)); map_set(modules, "mappings", map_new()); map_set(modules, "import_mappings", map_new());
let root = load_module(argv[0], "", modules, array_new(0), true);
write_text(argv[1], emitter.emit_modules(modules, root));
