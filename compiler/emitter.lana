    let root = items[root_index]; let main = emitter_new("main"); main[6] = root[3]; emit_statements(main, root[2][2]); emit(main, "HALT");
    sb_push(sections, string_join(main[0], "\n"));
    sb_push(sections, "\n");
    return sb_join(sections);
}
