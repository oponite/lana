}

fn is_shared_builtin(name) {
    if (name == "shared_information") { return true; }
    if (name == "shared_grant") { return true; }
    if (name == "shared_revoke") { return true; }
    if (name == "shared_snapshot") { return true; }
    if (name == "shared_at") { return true; }
    if (name == "shared_observe") { return true; }
    if (name == "shared_revision") { return true; }
    if (name == "shared_identity") { return true; }
    if (name == "shared_wait") { return true; }
    if (name == "grant") { return true; }
    return name == "revoke";
}

// Move already-emitted register numbers into one contiguous block.
fn pack_registers(context, values) {
    let base = context[2]; let index = 0;
    while (index < array_length(values)) {
        let destination = new_register(context);
        emit(context, string_concat("MOVE ", reg(destination), " ", reg(values[index]))); index = index + 1;
    }
    return [base, array_length(values)];
}

fn emit_contiguous(context, arguments) {
    let values = array_new(0); let index = 0;
    while (index < array_length(arguments)) { array_push(values, emit_expression(context, arguments[index])); index = index + 1; }
    return pack_registers(context, values);
}

fn adt_variant_lookup(registry, name) {
    if (registry == null) { return null; }
    if (!map_has(registry[0], name)) { return null; }
    return map_get(registry[0], name);
}

fn emit_adt_build(context, variant_index, arguments) {
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("ADT_BUILD ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", number_to_string(variant_index)));
    return destination;
}

fn emit_match(context, node) {
    let scrutinee = emit_expression(context, node[1]);
    let end = new_label(context, "matchend"); let result = new_register(context);
    let arms = node[2]; let labels = array_new(0); let index = 0;
    while (index < array_length(arms)) { array_push(labels, new_label(context, "arm")); index = index + 1; }
    let default_label = null; index = 0;
    while (index < array_length(arms)) {
        let pattern = arms[index][0];
        if (pattern[0] == "variant") {
            let variant = adt_variant_lookup(context[8], pattern[1]);
            assert(variant != null, string_concat("unknown variant ", pattern[1]));
            emit(context, string_concat("ADT_CASE ", reg(scrutinee), " ", number_to_string(variant[1]), " ", labels[index]));
        } else {
            if (pattern[0] == "unknown") { emit(context, string_concat("ADT_CASE ", reg(scrutinee), " 4294967295 ", labels[index])); }
            else { default_label = labels[index]; }
        }
        index = index + 1;
    }
    if (default_label == null) { default_label = end; }
    emit(context, string_concat("JUMP ", default_label));
    index = 0;
    while (index < array_length(arms)) {
        let arm = arms[index]; let pattern = arm[0];
        emit(context, string_concat(labels[index], ":"));
        if (pattern[0] == "variant") {
            let bindings = pattern[2]; let binding_index = 0;
            while (binding_index < array_length(bindings)) {
                let field = new_register(context);
                emit(context, string_concat("ADT_GET ", reg(field), " ", reg(scrutinee), " ", number_to_string(binding_index)));
                symbol_add(context, bindings[binding_index], field, false);
                binding_index = binding_index + 1;
            }
        }
        let value = emit_expression(context, arm[1]);
        emit(context, string_concat("MOVE ", reg(result), " ", reg(value)));
        emit(context, string_concat("JUMP ", end));
        index = index + 1;
    }
    emit(context, string_concat(end, ":"));
    return result;
}

fn emit_literal(context, node) {
    let destination = new_register(context);
    if (node[1] == "string") {
        let encoded = string_hex(node[2]);
        if (string_length(encoded) == 0) { encoded = "-"; }
        emit(context, string_concat("LOAD_STRING ", reg(destination), " ", encoded));
    } else {
        let text = node[2];
        if (node[1] == "bool") { if (node[2]) { text = "true"; } else { text = "false"; } }
        if (node[1] == "null") { text = "null"; }
        emit(context, string_concat("LOAD_CONST ", reg(destination), " ", text));
    }
    return destination;
}

fn emit_tagged_pair(context, tag, value) {
    let arguments = [syntax.literal_node("bool", tag, 0, 0), value];
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
    return destination;
}

fn emit_pair(context, left, right) {
    let arguments = [left, right]; let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
    return destination;
}

fn emit_pair_index(context, value, index) {
    let arguments = [value, syntax.literal_node("number", number_to_string(index), 0, 0)];
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination)));
    return destination;
}

fn emit_sample_record(context, source, dependency, operation) {
    let dependency_register = emit_literal(context, syntax.literal_node("string", dependency, 0, 0));
    let operation_register = emit_literal(context, syntax.literal_node("string", operation, 0, 0));
    let base = context[2]; let destination = new_register(context);
    emit(context, string_concat("MOVE ", reg(destination), " ", reg(source)));
    destination = new_register(context);
    emit(context, string_concat("MOVE ", reg(destination), " ", reg(dependency_register)));
    destination = new_register(context);
    emit(context, string_concat("MOVE ", reg(destination), " ", reg(operation_register)));
    destination = new_register(context);
    emit(context, string_concat("HOST_CALL sample_record ", reg(base), " 3 ", reg(destination)));
    return destination;
}

fn emit_map_field(context, source, field) {
    let field_register = emit_literal(context, syntax.literal_node("string", field, 0, 0));
    let base = context[2]; let destination = new_register(context);
    emit(context, string_concat("MOVE ", reg(destination), " ", reg(source)));
    destination = new_register(context);
    emit(context, string_concat("MOVE ", reg(destination), " ", reg(field_register)));
    destination = new_register(context);
    emit(context, string_concat("HOST_CALL index_get ", reg(base), " 2 ", reg(destination)));
    return destination;
}

fn emit_host_builtin(context, name, arguments) {
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("HOST_CALL ", name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn is_state_field(name) {
    if (name == "p") { return true; }
    if (name == "d") { return true; }
    if (name == "d_re") { return true; }
    if (name == "d_im") { return true; }
    if (name == "params") { return true; }
    if (name == "steps") { return true; }
    if (name == "mean") { return true; }
    if (name == "variance") { return true; }
    if (name == "samples") { return true; }
    if (name == "history") { return true; }
    return false;
}

fn emit_type_builtin(context, node) {
    let name = node[1];
    if (name == "information") { return emit_host_builtin(context, "information_new", node[2]); }
    if (name == "sample_value") { return emit_pair_index(context, node[2][0], 0); }
    if (name == "sample_metadata") { return emit_pair_index(context, node[2][0], 1); }
    if (name == "capability") { return emit_host_builtin(context, "shared_information", node[2]); }
    if (name == "claim") { return emit_host_builtin(context, "claim_new", node[2]); }
    if (name == "planned_effect") { return emit_host_builtin(context, "planned_effect_new", node[2]); }
    if (name == "result_ok") { return emit_tagged_pair(context, true, node[2][0]); }
    if (name == "result_error") { return emit_tagged_pair(context, false, node[2][0]); }
    if (name == "claim_value") { return emit_host_builtin(context, "claim_value", node[2]); }
    if (name == "claim_proposition") { return emit_host_builtin(context, "claim_proposition", node[2]); }
    if (name == "claim_status") { return emit_host_builtin(context, "claim_status", node[2]); }
    if (name == "execute_effect") { return emit_host_builtin(context, "planned_effect_execute", node[2]); }
    if (name == "effect_status") { return emit_host_builtin(context, "planned_effect_status", node[2]); }
    if (name == "inspect_information") { return emit_host_builtin(context, "information_inspect", node[2]); }
    if (name == "result_is_ok") { return emit_pair_index(context, node[2][0], 0); }
    if (name == "result_value") { return emit_pair_index(context, node[2][0], 1); }
    return emit_pair_index(context, node[2][0], 1);
}

fn emit_shared_builtin(context, node) {
    return emit_host_builtin(context, node[1], node[2]);
}

fn emit_next(context, node) {
    let source = emit_expression(context, node[2][0]);
    let destination = new_register(context);
    emit(context, string_concat("NEXT ", reg(source), " ", reg(destination)));
    return destination;
}

fn emit_generator_call(context, target, packed, destination) {
    let opcode = "CALL";
    if (map_has(context[9], target)) { opcode = "GENERATOR"; }
    if (map_has(context[10], target)) { opcode = "ASYNC"; }
    emit(context, string_concat(opcode, " ", target, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return null;
}

fn emit_call(context, node) {
    let variant = adt_variant_lookup(context[8], node[1]);
    if (variant != null) { return emit_adt_build(context, variant[1], node[2]); }
    if (is_shared_builtin(node[1])) { return emit_shared_builtin(context, node); }
    if (is_type_builtin(node[1])) { return emit_type_builtin(context, node); }
    if (node[1] == "mix") {
        let left = emit_expression(context, node[2][0]);
        let right = emit_expression(context, node[2][1]);
        let weight = emit_expression(context, node[2][2]);
        let destination = new_register(context);
        emit(context, string_concat("MIX ", reg(destination), " ", reg(left), " ", reg(right), " ", reg(weight)));
        return destination;
    }
    if (node[1] == "map") { if (array_length(node) == 6) { return emit_iterator_map(context, node); } }
    if (node[1] == "filter") { return emit_iterator_filter(context, node); }
    if (node[1] == "reduce") { return emit_iterator_reduce(context, node); }
    if (node[1] == "map") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        emit(context, string_concat("MAP ", reg(destination), " ", reg(source), " ", node[2][1][1]));
        return destination;
    }
    if (node[1] == "support") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        emit(context, string_concat("SUPPORT ", reg(destination), " ", reg(source), " ", node[2][1][2]));
        return destination;
    }
    if (node[1] == "expect") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        emit(context, string_concat("EXPECT ", reg(destination), " ", reg(source), " ", node[2][1][1]));
        return destination;
    }
    if (node[1] == "validate") {
        let value = emit_expression(context, node[2][0]);
        let schema = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        emit(context, string_concat("VALIDATE ", reg(destination), " ", reg(value), " ", reg(schema)));
        return destination;
    }
    if (node[1] == "revision") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        emit(context, string_concat("REVISION ", reg(destination), " ", reg(source)));
        return destination;
    }
    if (node[1] == "attenuate") {
        let source = emit_expression(context, node[2][0]);
        let factor = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        emit(context, string_concat("ATTENUATE ", reg(destination), " ", reg(source), " ", reg(factor)));
        return destination;
    }
    if (node[1] == "trace_distance") {
        let left = emit_expression(context, node[2][0]);
        let right = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        emit(context, string_concat("TRACE_DISTANCE ", reg(destination), " ", reg(left), " ", reg(right)));
        return destination;
    }
    if (node[1] == "lazy") { return emit_lazy_force(context, node); }
    if (node[1] == "force") { return emit_lazy_force(context, node); }
    if (node[1] == "force_all") { return emit_lazy_force(context, node); }
    if (node[1] == "bootstrap") { return emit_bootstrap(context, node); }
    if (node[1] == "next") { return emit_next(context, node); }
    if (node[1] == "grad") { return emit_grad_vjp(context, node, "grad"); }
    if (node[1] == "vjp") { return emit_grad_vjp(context, node, "vjp"); }
    if (node[1] == "train") { return emit_train(context, node); }
    if (node[1] == "infer") { return emit_infer(context, node); }
    if (node[1] == "run_async") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        emit(context, string_concat("RUN_ASYNC ", reg(source), " ", reg(destination)));
        return destination;
    }
    if (node[1] == "dataset_map") { return emit_dataset_fn(context, node, "dataset_map"); }
    if (node[1] == "dataset_filter") { return emit_dataset_fn(context, node, "dataset_filter"); }
    let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
    if (is_host_call(node[1])) {
        emit(context, string_concat("HOST_CALL ", host_call_name(node[1]), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    } else {
        emit_generator_call(context, call_target(context, node[1]), packed, destination);
    }
    if (node[1] == "random") { return emit_sample_record(context, destination, "host:random", "random"); }
    return destination;
}

fn emit_binary(context, node) {
    let left = emit_expression(context, node[2]); let right = emit_expression(context, node[3]);
    let destination = new_register(context); let opcode = "BINARY";
    if (node[1] == "==") { opcode = "COMPARE"; } if (node[1] == "!=") { opcode = "COMPARE"; }
    if (node[1] == "<") { opcode = "COMPARE"; } if (node[1] == "<=") { opcode = "COMPARE"; }
    if (node[1] == ">") { opcode = "COMPARE"; } if (node[1] == ">=") { opcode = "COMPARE"; }
    emit(context, string_concat(opcode, " ", reg(left), " ", node[1], " ", reg(right), " ", reg(destination)));
    return destination;
}

fn emit_unary(context, node) {
    let source = emit_expression(context, node[2]); let destination = new_register(context);
    emit(context, string_concat("UNARY ", node[1], " ", reg(source), " ", reg(destination))); return destination;
}

fn emit_array(context, node) {
    let packed = emit_contiguous(context, node[1]); let destination = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1])));
    return destination;
}

fn emit_index(context, node) {
    let positions = node[2];
    if (array_length(positions) == 1) {
        if (positions[0][0] != 39) {
            // The single non-slice form keeps the historical two-argument
// * host call, byte-identical to the pre-slicing emitter.
            let arguments = [node[1], positions[0]]; let packed = emit_contiguous(context, arguments); let destination = new_register(context);
            emit(context, string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination))); return destination;
        }
    }
    // Multi-position and slice forms pass a runtime position list: each
// * slice becomes a two-element [start, end] array, and the whole list
// * becomes the spec array the tensor path expects.
    let source = emit_expression(context, node[1]);
    let registers = array_new(0); let index = 0;
    while (index < array_length(positions)) {
        let position = positions[index];
        if (position[0] == 39) {
            let packed = emit_contiguous(context, [position[1], position[2]]);
            let destination = new_register(context);
            emit(context, string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
            array_push(registers, destination);
        } else {
            array_push(registers, emit_expression(context, position));
        }
        index = index + 1;
    }
    let packed_positions = pack_registers(context, registers);
    let spec = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(spec), " ", reg(packed_positions[0]), " ", number_to_string(packed_positions[1])));
    let packed = pack_registers(context, [source, spec]); let destination = new_register(context);
    emit(context, string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination))); return destination;
}

fn emit_map(context, node) {
    let arguments = array_new(0); let index = 0;
    while (index < array_length(node[1])) {
        array_push(arguments, syntax.literal_node("string", node[1][index][0], node[2], node[3]));
        array_push(arguments, node[1][index][1]); index = index + 1;
    }
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    emit(context, string_concat("HOST_CALL map_new ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination))); return destination;
}

fn emit_joint(context, node) {
    let packed = emit_contiguous(context, node[3]); let destination = new_register(context);
    emit(context, string_concat("JOINT_BUILD ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", node[1], ":", string_join(node[2], ";")));
    return destination;
}

fn emit_finite_joint(context, node) {
    let rows = emit_expression(context, node[2]); let destination = new_register(context);
    emit(context, string_concat("JOINT_BUILD_FINITE ", reg(rows), " ", reg(destination), " ", string_join(node[1], ";"))); return destination;
}

fn emit_correlated(context, node) {
    let packed = emit_contiguous(context, [node[1], node[2], node[3]]); let destination = new_register(context);
    emit(context, string_concat("HOST_CALL correlated ", reg(packed[0]), " 3 ", reg(destination))); return destination;
}

fn emit_lazy_force(context, node) {
    if (node[1] == "lazy") {
        assert(node[2][0][0] == 21, "lazy generator must be a function name");
        let bound = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        emit(context, string_concat("LAZY ", reg(destination), " ", call_target(context, node[2][0][1]), " ", reg(bound)));
        return destination;
    }
    if (node[1] == "force") {
        let source = emit_expression(context, node[2][0]);
        let index = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        emit(context, string_concat("FORCE ", reg(destination), " ", reg(source), " ", reg(index)));
        return destination;
    }
    return emit_force_all(context, node[2][0]);
}

fn emit_bootstrap(context, node) {
    assert(node[2][1][0] == 21, "bootstrap statistic must be a function name");
    let data = emit_expression(context, node[2][0]);
    let b = null;
    if (array_length(node[2]) == 3) {
        b = emit_expression(context, node[2][2]);
    } else {
        b = new_register(context);
        emit(context, string_concat("LOAD_CONST ", reg(b), " 2000"));
    }
    let destination = new_register(context);
    emit(context, string_concat("BOOTSTRAP ", reg(destination), " ", reg(data), " ", reg(b), " ", call_target(context, node[2][1][1])));
    return destination;
}

fn emit_dataset_fn(context, node, host_name) {
    assert(node[2][1][0] == 21, string_concat(host_name, " function must be a function name"));
    let function_reg = new_register(context);
    emit(context, string_concat("LOAD_FUNCTION ", reg(function_reg), " ", call_target(context, node[2][1][1])));
    let values = array_new(0);
    array_push(values, emit_expression(context, node[2][0]));
    array_push(values, function_reg);
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    emit(context, string_concat("HOST_CALL ", host_name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_grad_vjp(context, node, host_name) {
    assert(node[2][0][0] == 21, string_concat(host_name, " function must be a function name"));
    let function_reg = new_register(context);
    emit(context, string_concat("LOAD_FUNCTION ", reg(function_reg), " ", call_target(context, node[2][0][1])));
    let values = array_new(0);
    array_push(values, function_reg);
    let index = 1;
    while (index < array_length(node[2])) {
        array_push(values, emit_expression(context, node[2][index]));
        index = index + 1;
    }
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    emit(context, string_concat("HOST_CALL ", host_name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_train(context, node) {
    assert(node[2][0][0] == 21, "train model must be a function name");
    assert(node[2][2][0] == 21, "train loss must be a function name");
    let model_reg = new_register(context);
    emit(context, string_concat("LOAD_FUNCTION ", reg(model_reg), " ", call_target(context, node[2][0][1])));
    let loss_reg = new_register(context);
    emit(context, string_concat("LOAD_FUNCTION ", reg(loss_reg), " ", call_target(context, node[2][2][1])));
    let values = array_new(0);
    array_push(values, model_reg);
    array_push(values, emit_expression(context, node[2][1]));
    array_push(values, loss_reg);
    let index = 3;
    while (index < array_length(node[2])) {
        array_push(values, emit_expression(context, node[2][index]));
        index = index + 1;
    }
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    emit(context, string_concat("HOST_CALL train ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_infer(context, node) {
    assert(node[2][1][0] == 21, "infer model must be a function name");
    let model_reg = new_register(context);
    emit(context, string_concat("LOAD_FUNCTION ", reg(model_reg), " ", call_target(context, node[2][1][1])));
    let values = array_new(0);
    array_push(values, emit_expression(context, node[2][0]));
    array_push(values, model_reg);
    array_push(values, emit_expression(context, node[2][2]));
    array_push(values, emit_expression(context, node[2][3]));
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    emit(context, string_concat("HOST_CALL infer ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_force_all(context, source_node) {
    let source = emit_expression(context, source_node);
    let result = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    let index = new_register(context);
    emit(context, string_concat("LOAD_CONST ", reg(index), " 0"));
    let one = new_register(context);
    emit(context, string_concat("LOAD_CONST ", reg(one), " 1"));
    let bound_base = context[2]; let bound = new_register(context);
    emit(context, string_concat("MOVE ", reg(bound), " ", reg(source)));
    bound = new_register(context);
    emit(context, string_concat("HOST_CALL lazy_bound ", reg(bound_base), " 1 ", reg(bound)));
    let start = new_label(context, "force_all"); let end = new_label(context, "endforce_all");
    emit(context, string_concat(start, ":"));
    let condition = new_register(context);
    emit(context, string_concat("COMPARE ", reg(index), " < ", reg(bound), " ", reg(condition)));
    emit(context, string_concat("JUMP_IF_FALSE ", reg(condition), " ", end));
    let element = new_register(context);
    emit(context, string_concat("FORCE ", reg(element), " ", reg(source), " ", reg(index)));
    let push_base = context[2]; let push = new_register(context);
    emit(context, string_concat("MOVE ", reg(push), " ", reg(result)));
    push = new_register(context);
    emit(context, string_concat("MOVE ", reg(push), " ", reg(element)));
    let ignored = new_register(context);
    emit(context, string_concat("HOST_CALL array_push ", reg(push_base), " 2 ", reg(ignored)));
    let next = new_register(context);
    emit(context, string_concat("BINARY ", reg(index), " + ", reg(one), " ", reg(next)));
    emit(context, string_concat("MOVE ", reg(index), " ", reg(next)));
    emit(context, string_concat("JUMP ", start));
    emit(context, string_concat(end, ":"));
    return result;
}

fn emit_append(context, arguments) {
    let left = emit_expression(context, arguments[0]); let right = emit_expression(context, arguments[1]); let destination = new_register(context);
    emit(context, string_concat("APPEND ", reg(left), " ", reg(right), " ", reg(destination))); return destination;
}

fn emit_append_relationship(context, opcode, arguments) {
    let left = emit_expression(context, arguments[0]); let right = emit_expression(context, arguments[1]); let destination = new_register(context);
    if (array_length(arguments) > 2) {
        let strength = emit_expression(context, arguments[2]);
        emit(context, string_concat(opcode, " ", reg(left), " ", reg(right), " ", reg(destination), " ", reg(strength)));
    } else {
        emit(context, string_concat(opcode, " ", reg(left), " ", reg(right), " ", reg(destination)));
    }
    return destination;
}

fn emit_joint_refinement(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "project") { emit(context, string_concat("JOINT_PROJECT ", reg(source), " ", reg(destination), " ", replace_commas(arguments[1][2]))); return destination; }
    if (operation == "condition") { let evidence_value = emit_expression(context, arguments[2]); emit(context, string_concat("JOINT_CONDITION ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", reg(evidence_value))); return destination; }
    if (operation == "rename") { emit(context, string_concat("JOINT_RENAME ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", arguments[2][2])); return destination; }
    let evidence_value = emit_expression(context, arguments[2]); emit(context, string_concat("OBSERVE ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", reg(evidence_value))); return destination;
}

fn emit_information_read(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "possibility") { emit(context, string_concat("POSSIBILITY_BUILD ", reg(source), " ", reg(destination))); return destination; }
    if (operation == "sample") {
        if (expression_is_information(context, arguments[0])) { emit(context, string_concat("INFO_SAMPLE ", reg(source), " ", reg(destination))); }
        else { emit(context, string_concat("SAMPLE_STATE_DIST ", reg(source), " ", reg(destination))); }
        return emit_sample_record(context, destination, "information", "sample");
    }
    emit(context, string_concat("RESOLVE ", reg(source), " ", reg(destination))); return destination;
}

fn is_provenance_operation(operation) {
    if (operation == "evidence") { return true; } if (operation == "assume") { return true; }
    if (operation == "derivation") { return true; } return operation == "explain";
}

fn emit_provenance(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "evidence") { emit(context, string_concat("EVIDENCE ", reg(source), " ", reg(destination), " ", arguments[1][2])); return destination; }
    if (operation == "assume") { emit(context, string_concat("ASSUME ", reg(source), " ", reg(destination), " ", arguments[1][2])); return destination; }
    if (operation == "derivation") { emit(context, string_concat("DERIVATION ", reg(source), " ", reg(destination))); return destination; }
    emit(context, string_concat("EXPLAIN ", reg(source), " ", reg(destination))); return destination;
}

fn emit_information(context, node) {
    if (node[1] == "append") { return emit_append(context, node[2]); }
    if (node[1] == "append_redundant") { return emit_append_relationship(context, "APPEND_REDUNDANT", node[2]); }
    if (node[1] == "append_full_redundancy") { return emit_append_relationship(context, "APPEND_FULL_REDUNDANCY", node[2]); }
    if (node[1] == "append_complementary") { return emit_append_relationship(context, "APPEND_COMPLEMENTARY", node[2]); }
    if (node[1] == "project") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "condition") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "rename") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "observe") { return emit_joint_refinement(context, node[1], node[2]); }
    if (is_provenance_operation(node[1])) { return emit_provenance(context, node[1], node[2]); }
    return emit_information_read(context, node[1], node[2]);
}

fn emit_measure(context, node) {
    let destination = new_register(context); let source = symbol_find(context, node[1]);
    if (node[2] == "") { emit(context, string_concat("MEASURE ", reg(source), " ", node[3], " ", reg(destination))); }
    else { emit(context, string_concat("MEASURE_BASIS ", reg(source), " ", reg(destination), " ", node[2], " ", node[3])); }
    if (node[3] == "sample") { return emit_sample_record(context, destination, node[1], "measure"); }
    return destination;
}

fn emit_estimate_measure(context, node) {
    let opcode = "ESTIMATE_MEASURE_DISTRIBUTION"; if (node[3] == "probability") { opcode = "ESTIMATE_MEASURE_PROBABILITY"; }
    let destination = new_register(context); emit(context, string_concat(opcode, " ", reg(symbol_find(context, node[1])), " ", reg(destination), " ", node[2], " ", node[4]));
    return emit_sample_record(context, destination, node[1], "estimate_measure");
}

fn emit_task_expression(context, node) {
    if (node[0] == 35) {
        let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
        emit(context, string_concat("FORK ", call_target(context, node[1]), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination))); return destination;
    }
    if (node[0] == 36) {
        let task = emit_expression(context, node[2]); let destination = new_register(context);
        let opcode = "JOIN"; if (node[1] == "join_all") { opcode = "JOIN_ALL"; }
        emit(context, string_concat(opcode, " ", reg(task), " ", reg(destination))); return destination;
    }
    let task = emit_expression(context, node[1]); let timeout = emit_expression(context, node[2]); let destination = new_register(context);
    emit(context, string_concat("JOIN_TIMEOUT ", reg(task), " ", reg(timeout), " ", reg(destination))); return destination;
}

fn emit_extended_expression(context, node) {
    if (node[0] == 27) {
        let source = emit_expression(context, node[1]); let opcode = "GET_FIELD";
        if (node[2] == "timestamp") { opcode = "GET_INDEX"; } if (node[2] == "source") { opcode = "GET_INDEX"; }
        if (node[2] == "weight") { opcode = "GET_INDEX"; } if (node[2] == "confidence") { opcode = "GET_INDEX"; }
        if (opcode == "GET_FIELD") {
            if (is_state_field(node[2]) == false) { return emit_map_field(context, source, node[2]); }
        }
        let destination = new_register(context);
        emit(context, string_concat(opcode, " ", reg(source), " ", node[2], " ", reg(destination))); return destination;
    }
    if (node[0] == 28) { return emit_map(context, node); }
    if (node[0] == 29) { return emit_joint(context, node); }
    if (node[0] == 30) { return emit_finite_joint(context, node); }
    if (node[0] == 31) { return emit_information(context, node); }
    if (node[0] == 32) { return emit_measure(context, node); }
    if (node[0] == 33) { return emit_estimate_measure(context, node); }
    if (node[0] == 34) {
        let opcode = "PREVIOUS"; if (node[1] == "change") { opcode = "CHANGE"; } if (node[1] == "velocity") { opcode = "VELOCITY"; }
        let destination = new_register(context); emit(context, string_concat(opcode, " ", reg(symbol_find(context, node[2])), " ", reg(destination))); return destination;
    }
    if (node[0] == 35) { return emit_task_expression(context, node); }
    if (node[0] == 36) { return emit_task_expression(context, node); }
    if (node[0] == 37) { return emit_task_expression(context, node); }
    if (node[0] == 38) { return emit_correlated(context, node); }
    assert(false, "unsupported expression in native emitter"); return 0;
}

fn emit_expression(context, node) {
    if (node[0] == 20) { return emit_literal(context, node); }
    if (node[0] == 21) {
        let variant = adt_variant_lookup(context[8], node[1]);
        if (variant != null) { return emit_adt_build(context, variant[1], array_new(0)); }
        return symbol_find(context, node[1]);
    }
    if (node[0] == 22) { return emit_binary(context, node); }
    if (node[0] == 23) { return emit_unary(context, node); }
    if (node[0] == 24) { return emit_call(context, node); }
    if (node[0] == 25) { return emit_array(context, node); }
    if (node[0] == 26) { return emit_index(context, node); }
    if (node[0] == 44) { return emit_comprehension(context, node); }
    if (node[0] == 40) { return emit_match(context, node); }
    if (node[0] == 43) { return emit_adt_build(context, 4294967295, array_new(0)); }
    if (node[0] == 45) {
        let source = emit_expression(context, node[1]);
        let destination = new_register(context);
        emit(context, string_concat("AWAIT ", reg(source), " ", reg(destination)));
        return destination;
    }
    return emit_extended_expression(context, node);
}

fn emit_assignment(context, target, value) {
    if (target[0] == 21) {
        let source = emit_expression(context, value); let destination = symbol_find(context, target[1]);
        if (expression_is_information(context, value)) { array_push(context[5], target[1]); }
        emit(context, string_concat("MOVE ", reg(destination), " ", reg(source))); return null;
    }
    if (target[0] == 26) {
        // Assignment goes through index_set, which takes one position:
// * slices and multi-position targets are read-only views.
        let positions = target[2];
        let position = 0; let sliced = false;
        while (position < array_length(positions)) {
            if (positions[position][0] == 39) { sliced = true; }
            position = position + 1;
        }
        assert(!sliced, "slices cannot be assigned");
        assert(array_length(positions) == 1, "assignment accepts a single index position");
        let arguments = [target[1], positions[0], value]; let packed = emit_contiguous(context, arguments); let ignored = new_register(context);
        emit(context, string_concat("HOST_CALL index_set ", reg(packed[0]), " 3 ", reg(ignored))); return null;
    }
    assert(false, "invalid assignment target"); return null;
}

fn emit_if(context, node) {
    let otherwise = new_label(context, "else"); let end = new_label(context, "endif");
    let predicate = emit_expression(context, node[1]);
    let uncertain = expression_is_information(context, node[1]); let opcode = "JUMP_IF_FALSE";
    if (uncertain) { opcode = "PATH_SPLIT"; }
    emit(context, string_concat(opcode, " ", reg(predicate), " ", otherwise));
    emit_statements(context, node[2]); emit(context, string_concat("JUMP ", end)); emit(context, string_concat(otherwise, ":"));
    emit_statements(context, node[3]); emit(context, string_concat(end, ":")); if (uncertain) { emit(context, "PATH_JOIN"); } return null;
}

fn emit_while(context, node) {
    let start = new_label(context, "while"); let end = new_label(context, "endwhile");
    assert(!expression_is_information(context, node[1]), "unresolved loop guards require a bounded execution form");
    emit(context, string_concat(start, ":")); let predicate = emit_expression(context, node[1]);
    emit(context, string_concat("JUMP_IF_FALSE ", reg(predicate), " ", end)); emit_statements(context, node[2]);
    emit(context, string_concat("JUMP ", start)); emit(context, string_concat(end, ":")); return null;
}

fn emit_index_get_reg(context, arr_reg, idx_reg) {
    let base = new_register(context);
    emit(context, string_concat("MOVE ", reg(base), " ", reg(arr_reg)));
    let idx = new_register(context);
    emit(context, string_concat("MOVE ", reg(idx), " ", reg(idx_reg)));
    let dest = new_register(context);
    emit(context, string_concat("HOST_CALL index_get ", reg(base), " 2 ", reg(dest)));
    return dest;
}

fn emit_index_get_const(context, arr_reg, index) {
    let idx = new_register(context);
    emit(context, string_concat("LOAD_CONST ", reg(idx), " ", number_to_string(index)));
    return emit_index_get_reg(context, arr_reg, idx);
}

fn emit_for(context, node) {
    let iterable = emit_expression(context, node[2]);
    if (node[4]) {
        let it = new_register(context);
        let r = new_register(context);
        let binding = new_register(context);
        symbol_add(context, node[1], binding, false);
        emit(context, string_concat("MOVE ", reg(it), " ", reg(iterable)));
        emit(context, string_concat("NEXT ", reg(it), " ", reg(r)));
        let start = new_label(context, "for"); let end = new_label(context, "endfor");
        emit(context, string_concat(start, ":"));
        let ok = emit_index_get_const(context, r, 0);
        emit(context, string_concat("JUMP_IF_FALSE ", reg(ok), " ", end));
        let value = emit_index_get_const(context, r, 1);
        emit(context, string_concat("MOVE ", reg(binding), " ", reg(value)));
        emit_statements(context, node[3]);
        let r2 = new_register(context);
        emit(context, string_concat("NEXT ", reg(it), " ", reg(r2)));
        emit(context, string_concat("MOVE ", reg(r), " ", reg(r2)));
        emit(context, string_concat("JUMP ", start));
        emit(context, string_concat(end, ":"));
    } else {
        let arr = new_register(context);
        let i = new_register(context);
        let len = new_register(context);
        let len_base = new_register(context);
        let binding = new_register(context);
        symbol_add(context, node[1], binding, false);
        emit(context, string_concat("MOVE ", reg(arr), " ", reg(iterable)));
        emit(context, string_concat("LOAD_CONST ", reg(i), " 0"));
        emit(context, string_concat("MOVE ", reg(len_base), " ", reg(arr)));
        emit(context, string_concat("HOST_CALL array_length ", reg(len_base), " 1 ", reg(len)));
        let start = new_label(context, "for"); let end = new_label(context, "endfor");
        emit(context, string_concat(start, ":"));
        let cond = new_register(context);
        emit(context, string_concat("COMPARE ", reg(i), " < ", reg(len), " ", reg(cond)));
        emit(context, string_concat("JUMP_IF_FALSE ", reg(cond), " ", end));
        let value = emit_index_get_reg(context, arr, i);
        emit(context, string_concat("MOVE ", reg(binding), " ", reg(value)));
        emit_statements(context, node[3]);
        let one = new_register(context);
        emit(context, string_concat("LOAD_CONST ", reg(one), " 1"));
        let next = new_register(context);
        emit(context, string_concat("BINARY ", reg(i), " + ", reg(one), " ", reg(next)));
        emit(context, string_concat("MOVE ", reg(i), " ", reg(next)));
        emit(context, string_concat("JUMP ", start));
        emit(context, string_concat(end, ":"));
    }
    return null;
}

fn emit_iter_prologue(context, iterable, is_generator, prefix) {
    if (is_generator) {
        let it = new_register(context);
        let r = new_register(context);
        emit(context, string_concat("MOVE ", reg(it), " ", reg(iterable)));
        emit(context, string_concat("NEXT ", reg(it), " ", reg(r)));
        let start = new_label(context, prefix); let end = new_label(context, string_concat("end", prefix));
        emit(context, string_concat(start, ":"));
        let ok = emit_index_get_const(context, r, 0);
        emit(context, string_concat("JUMP_IF_FALSE ", reg(ok), " ", end));
        let element = emit_index_get_const(context, r, 1);
        return [start, end, it, r, element, 0];
    }
    let arr = new_register(context);
    let i = new_register(context);
    let len = new_register(context);
    let len_base = new_register(context);
    emit(context, string_concat("MOVE ", reg(arr), " ", reg(iterable)));
    emit(context, string_concat("LOAD_CONST ", reg(i), " 0"));
    emit(context, string_concat("MOVE ", reg(len_base), " ", reg(arr)));
    emit(context, string_concat("HOST_CALL array_length ", reg(len_base), " 1 ", reg(len)));
    let start = new_label(context, prefix); let end = new_label(context, string_concat("end", prefix));
    emit(context, string_concat(start, ":"));
    let cond = new_register(context);
    emit(context, string_concat("COMPARE ", reg(i), " < ", reg(len), " ", reg(cond)));
    emit(context, string_concat("JUMP_IF_FALSE ", reg(cond), " ", end));
    let element = emit_index_get_reg(context, arr, i);
    return [start, end, arr, i, element, 1];
}

fn emit_iter_epilogue(context, state) {
    if (state[5] == 0) {
        let r2 = new_register(context);
        emit(context, string_concat("NEXT ", reg(state[2]), " ", reg(r2)));
        emit(context, string_concat("MOVE ", reg(state[3]), " ", reg(r2)));
    } else {
        let one = new_register(context);
        emit(context, string_concat("LOAD_CONST ", reg(one), " 1"));
        let next = new_register(context);
        emit(context, string_concat("BINARY ", reg(state[3]), " + ", reg(one), " ", reg(next)));
        emit(context, string_concat("MOVE ", reg(state[3]), " ", reg(next)));
    }
    emit(context, string_concat("JUMP ", state[0]));
    emit(context, string_concat(state[1], ":"));
    return null;
}

fn emit_iterator_map(context, node) {
    let f_name = node[2][0][1];
    let iterable = emit_expression(context, node[2][1]);
    let result = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    let state = emit_iter_prologue(context, iterable, node[5], "map");
    let packed = pack_registers(context, [state[4]]);
    let f_result = new_register(context);
    emit_generator_call(context, call_target(context, f_name), packed, f_result);
    let push = pack_registers(context, [result, f_result]);
    let ignored = new_register(context);
    emit(context, string_concat("HOST_CALL array_push ", reg(push[0]), " 2 ", reg(ignored)));
    emit_iter_epilogue(context, state);
    return result;
}

fn emit_iterator_filter(context, node) {
    let f_name = node[2][0][1];
    let iterable = emit_expression(context, node[2][1]);
    let result = new_register(context);
    emit(context, string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    let state = emit_iter_prologue(context, iterable, node[5], "filter");
    let packed = pack_registers(context, [state[4]]);
    let f_result = new_register(context);
    emit_generator_call(context, call_target(context, f_name), packed, f_result);
    let skip = new_label(context, "skip");
    emit(context, string_concat("JUMP_IF_FALSE ", reg(f_result), " ", skip));
    let push = pack_registers(context, [result, state[4]]);
    let ignored = new_register(context);
    emit(context, string_concat("HOST_CALL array_push ", reg(push[0]), " 2 ", reg(ignored)));
    emit(context, string_concat(skip, ":"));
    emit_iter_epilogue(context, state);
    return result;
}

fn emit_iterator_reduce(context, node) {
    let f_name = node[2][0][1];
    let iterable = emit_expression(context, node[2][1]);
    let acc = emit_expression(context, node[2][2]);
    let state = emit_iter_prologue(context, iterable, node[5], "reduce");
    let packed = pack_registers(context, [acc, state[4]]);
    let f_result = new_register(context);
    emit_generator_call(context, call_target(context, f_name), packed, f_result);
    emit(context, string_concat("MOVE ", reg(acc), " ", reg(f_result)));
    emit_iter_epilogue(context, state);
    return acc;
}

fn emit_comprehension(context, node) {
    let kind = node[1];
    let iterable = emit_expression(context, node[6]);
    let result = new_register(context);
    if (kind == "list") {
        emit(context, string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    }
    if (kind == "set") {
        emit(context, string_concat("HOST_CALL set_new ", reg(result), " 0 ", reg(result)));
    }
    if (kind == "map") {
        emit(context, string_concat("HOST_CALL map_new ", reg(result), " 0 ", reg(result)));
    }
    let state = emit_iter_prologue(context, iterable, node[10], "comp");
    let element_reg = state[4];
    if (kind == "map") {
        let key_reg = emit_index_get_const(context, element_reg, 0);
        let value_reg = emit_index_get_const(context, element_reg, 1);
        symbol_add(context, node[4], key_reg, false);
        symbol_add(context, node[5], value_reg, false);
    } else {
        let binding = new_register(context);
        symbol_add(context, node[4], binding, false);
        emit(context, string_concat("MOVE ", reg(binding), " ", reg(element_reg)));
    }
    let skip = null;
    if (node[7] != null) {
        let predicate = emit_expression(context, node[7]);
        skip = new_label(context, "skip");
        emit(context, string_concat("JUMP_IF_FALSE ", reg(predicate), " ", skip));
    }
    if (kind == "list") {
        let element = emit_expression(context, node[2]);
        let push = pack_registers(context, [result, element]);
        let ignored = new_register(context);
        emit(context, string_concat("HOST_CALL array_push ", reg(push[0]), " 2 ", reg(ignored)));
    }
    if (kind == "set") {
        let element = emit_expression(context, node[2]);
        let packed = pack_registers(context, [result, element]);
        let new_set = new_register(context);
        emit(context, string_concat("HOST_CALL set_add ", reg(packed[0]), " 2 ", reg(new_set)));
        emit(context, string_concat("MOVE ", reg(result), " ", reg(new_set)));
    }
    if (kind == "map") {
        let key = emit_expression(context, node[2]);
        let value = emit_expression(context, node[3]);
        let packed = pack_registers(context, [result, key, value]);
        let ignored = new_register(context);
        emit(context, string_concat("HOST_CALL map_set ", reg(packed[0]), " 3 ", reg(ignored)));
    }
    if (skip != null) { emit(context, string_concat(skip, ":")); }
    emit_iter_epilogue(context, state);
    return result;
}

fn emit_state_statement(context, node) {
    let destination = new_register(context); symbol_add(context, node[1], destination, false);
    let p = emit_expression(context, field_find(node[2], "p")); let d_re_node = field_find(node[2], "d"); let d_im = new_register(context); let d_re = 0;
    if (d_re_node == null) { d_re = emit_expression(context, field_find(node[2], "d_re")); d_im = emit_expression(context, field_find(node[2], "d_im")); }
    else { d_re = emit_expression(context, d_re_node); emit(context, string_concat("LOAD_CONST ", reg(d_im), " 0")); }
    emit(context, string_concat("STATE_BUILD ", reg(p), " ", reg(d_re), " ", reg(d_im), " ", reg(destination)));
    let metadata = ["timestamp", "source", "weight", "confidence"]; let index = 0;
    while (index < array_length(metadata)) {
        let field = field_find(node[2], metadata[index]);
        if (field != null) { emit(context, string_concat("SET_INDEX ", reg(destination), " ", metadata[index], " ", reg(emit_expression(context, field)))); }
        index = index + 1;
    }
    return null;
}

fn emit_extended_statement(context, node) {
    if (node[0] == 9) { return emit_state_statement(context, node); }
    if (node[0] == 10) { emit(context, string_concat("HISTORY ", reg(symbol_find(context, node[1])), " ", node[2], " ", reg(emit_expression(context, node[3])))); return null; }
    if (node[0] == 11) { let target = symbol_find(context, node[1]); emit(context, string_concat("TRANSFORM ", reg(target), " ", reg(target), " ", node[2])); return null; }
    if (node[0] == 12) { emit(context, "TASKGROUP_ENTER"); emit_statements(context, node[1]); emit(context, "TASKGROUP_EXIT"); return null; }
    if (node[0] == 13) { emit(context, string_concat("CANCEL ", reg(emit_expression(context, node[1])))); return null; }
    assert(false, "unsupported statement in native emitter"); return null;
}

fn emit_statement(context, ir_node) {
    context[2] = context[7];
    let node = ir_node[3]; emit(context, string_concat(".line ", number_to_string(node[array_length(node) - 2])));
    if (node[0] == 2) {
        let source = emit_expression(context, node[3]); let destination = new_register(context);
        symbol_add(context, node[1], destination, expression_is_information(context, node[3])); emit(context, string_concat("MOVE ", reg(destination), " ", reg(source))); return null;
    }
    if (node[0] == 3) { return emit_assignment(context, node[1], node[2]); }
    if (node[0] == 4) { return emit_if(context, node); }
    if (node[0] == 5) { return emit_while(context, node); }
    if (node[0] == 15) { return emit_for(context, node); }
    if (node[0] == 6) { emit(context, string_concat("RETURN ", reg(emit_expression(context, node[1])))); return null; }
    if (node[0] == 7) { emit_expression(context, node[1]); return null; }
    if (node[0] == 8) { emit(context, string_concat("PRINT ", reg(emit_expression(context, node[1])))); return null; }
    if (node[0] == 14) { emit(context, string_concat("YIELD R0 ", reg(emit_expression(context, node[1])))); return null; }
    return emit_extended_statement(context, node);
}

fn emit_statements(context, statements) {
    let index = 0; while (index < array_length(statements)) { emit_statement(context, statements[index]); index = index + 1; }
    return null;
}

fn emit_function_named(node, emitted_name, mappings, registry, generators, asyncs) {
    let context = emitter_new(emitted_name, registry, generators, asyncs); context[6] = mappings; let index = 0;
    let offset = 0; if (node[6]) { offset = 1; } if (node[7]) { offset = 1; }
    context[2] = offset; context[7] = offset;
    while (index < array_length(node[3])) { symbol_add(context, node[3][index], index + offset, false); context[2] = index + offset + 1; index = index + 1; }
    emit_statements(context, node[4]);
    let empty = new_register(context); emit(context, string_concat("LOAD_CONST ", reg(empty), " null")); emit(context, string_concat("RETURN ", reg(empty)));
    let header_sb = sb_new();
    sb_push(header_sb, ".function "); sb_push(header_sb, emitted_name); sb_push(header_sb, " "); sb_push(header_sb, number_to_string(array_length(node[3]))); sb_push(header_sb, " "); sb_push(header_sb, number_to_string(context[2])); sb_push(header_sb, "\n");
    sb_push(header_sb, string_join(context[0], "\n"));
    return sb_join(header_sb);
}

fn emit_function(node, registry) { return emit_function_named(node, node[1], array_new(0), registry, map_new(), map_new()); }

fn merge_mappings(left, right) {
    let merged = map_new();
    let keys = map_keys(left);
    let index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(left, keys[index]));
        index = index + 1;
    }
    keys = map_keys(right);
    index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(right, keys[index]));
        index = index + 1;
    }
    return merged;
}

fn emit_program(program) {
    let sections = sb_new();
    if (program[5]) { sb_push(sections, ".version 3"); } else { sb_push(sections, ".version 2"); }
    sb_push(sections, "\n");
    if (array_length(program[1]) > 0) { sb_push(sections, "JUMP __main\n"); }
    let index = 0;
    while (index < array_length(program[1])) { sb_push(sections, emit_function(program[1][index], program[4])); sb_push(sections, "\n"); index = index + 1; }
    if (array_length(program[1]) > 0) { sb_push(sections, "__main:\n"); }
    let main = emitter_new("main", program[4], map_new(), map_new()); emit_statements(main, program[2]); emit(main, "HALT");
    sb_push(sections, string_join(main[0], "\n"));
    sb_push(sections, "\n");
    return sb_join(sections);
}

fn emit_modules(modules, root_index) {
    let sections = sb_new();
    let items = modules["items"];
    let generators = map_new();
    let asyncs = map_new();
    let has_generators = false;
    let has_async = false;
    let has_ad = false;
    let function_count = 0; let module_index = 0;
    while (module_index < array_length(items)) {
        function_count = function_count + array_length(items[module_index][2][1]);
        let module = items[module_index]; let function_index = 0;
        if (module[2][5]) { has_ad = true; }
        while (function_index < array_length(module[2][1])) {
            let function_node = module[2][1][function_index];
            if (function_node[6]) { map_set(generators, string_concat(module[1], function_node[1]), true); has_generators = true; }
            if (function_node[7]) { map_set(asyncs, string_concat(module[1], function_node[1]), true); has_async = true; }
            function_index = function_index + 1;
        }
        module_index = module_index + 1;
    }
    if (has_async) { sb_push(sections, ".version 4"); } else { if (has_generators) { sb_push(sections, ".version 3"); } else { if (has_ad) { sb_push(sections, ".version 3"); } else { sb_push(sections, ".version 2"); } } }
    sb_push(sections, "\n");
    if (function_count > 0) { sb_push(sections, "JUMP __main\n"); }
    module_index = 0;
    while (module_index < array_length(items)) {
        let module = items[module_index]; let function_index = 0;
        let module_index_str = number_to_string(module_index);
        let import_mappings = map_get(modules["import_mappings"], module_index_str);
        let local_mappings = map_get(modules["mappings"], module_index_str);
        let mappings = merge_mappings(local_mappings, import_mappings);
        while (function_index < array_length(module[2][1])) {
            let function_node = module[2][1][function_index];
            sb_push(sections, emit_function_named(function_node, string_concat(module[1], function_node[1]), mappings, module[2][4], generators, asyncs)); sb_push(sections, "\n"); function_index = function_index + 1;
        }
        module_index = module_index + 1;
    }
    if (function_count > 0) { sb_push(sections, "__main:\n"); }
    let root = items[root_index]; let main = emitter_new("main", root[2][4], generators, asyncs); main[6] = root[3]; emit_statements(main, root[2][2]); emit(main, "HALT");
    sb_push(sections, string_join(main[0], "\n"));
    sb_push(sections, "\n");
    return sb_join(sections);
}
