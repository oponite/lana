    }
    if (node[0] == 3) { return emit_assignment(context, node[1], node[2]); }
    if (node[0] == 4) { return emit_if(context, node); }
    if (node[0] == 5) { return emit_while(context, node); }
    if (node[0] == 6) { emit(context, string_concat("RETURN ", reg(emit_expression(context, node[1])))); return null; }
