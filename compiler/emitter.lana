        let import_mappings = map_get(modules["import_mappings"], module_index_str);
        let local_mappings = map_get(modules["mappings"], module_index_str);
        let mappings = merge_mappings(local_mappings, import_mappings);
        while (function_index < array_length(module[2][1])) {
