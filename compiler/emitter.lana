fn emit_function(node) { return emit_function_named(node, node[1], array_new(0)); }

fn merge_mappings(left, right) {
    let merged = map_new();
    let keys = map_keys(left);
    let index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(left, keys[index]));
        index = index + 1;
    }
    keys = map_keys(right);
    index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(right, keys[index]));
        index = index + 1;
    }
    return merged;
}

fn emit_program(program) {
    let sections = sb_new();
    sb_push(sections, ".version 1");
    sb_push(sections, "\n");
