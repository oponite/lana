    return null;
}

fn emit_iter_prologue(context, iterable, is_generator, prefix) {
    if (is_generator) {
        let it = new_register(context);
        let r = new_register(context);
        array_push(context[0], string_concat("MOVE ", reg(it), " ", reg(iterable)));
        array_push(context[0], string_concat("NEXT ", reg(it), " ", reg(r)));
        let start = new_label(context, prefix); let end = new_label(context, string_concat("end", prefix));
        array_push(context[0], string_concat(start, ":"));
        let ok = emit_index_get_const(context, r, 0);
        array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(ok), " ", end));
        let element = emit_index_get_const(context, r, 1);
        return [start, end, it, r, element, 0];
    }
    let arr = new_register(context);
    let i = new_register(context);
    let len = new_register(context);
    let len_base = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(arr), " ", reg(iterable)));
    array_push(context[0], string_concat("LOAD_CONST ", reg(i), " 0"));
    array_push(context[0], string_concat("MOVE ", reg(len_base), " ", reg(arr)));
    array_push(context[0], string_concat("HOST_CALL array_length ", reg(len_base), " 1 ", reg(len)));
    let start = new_label(context, prefix); let end = new_label(context, string_concat("end", prefix));
    array_push(context[0], string_concat(start, ":"));
    let cond = new_register(context);
    array_push(context[0], string_concat("COMPARE ", reg(i), " < ", reg(len), " ", reg(cond)));
    array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(cond), " ", end));
    let element = emit_index_get_reg(context, arr, i);
    return [start, end, arr, i, element, 1];
