        symbol_add(context, node[4], binding, false);
        array_push(context[0], string_concat("MOVE ", reg(binding), " ", reg(element_reg)));
    }
    let skip = null;
    if (node[7] != null) {
        let predicate = emit_expression(context, node[7]);
        skip = new_label(context, "skip");
        array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(predicate), " ", skip));
    }
    if (kind == "list") {
        let element = emit_expression(context, node[2]);
        let push = pack_registers(context, [result, element]);
        let ignored = new_register(context);
        array_push(context[0], string_concat("HOST_CALL array_push ", reg(push[0]), " 2 ", reg(ignored)));
    }
    if (kind == "set") {
        let element = emit_expression(context, node[2]);
        let packed = pack_registers(context, [result, element]);
        let new_set = new_register(context);
        array_push(context[0], string_concat("HOST_CALL set_add ", reg(packed[0]), " 2 ", reg(new_set)));
        array_push(context[0], string_concat("MOVE ", reg(result), " ", reg(new_set)));
    }
    if (kind == "map") {
        let key = emit_expression(context, node[2]);
        let value = emit_expression(context, node[3]);
        let packed = pack_registers(context, [result, key, value]);
        let ignored = new_register(context);
        array_push(context[0], string_concat("HOST_CALL map_set ", reg(packed[0]), " 3 ", reg(ignored)));
    }
    if (skip != null) { array_push(context[0], string_concat(skip, ":")); }
    emit_iter_epilogue(context, state);
    return result;
}

fn emit_state_statement(context, node) {
    let destination = new_register(context); symbol_add(context, node[1], destination, false);
    let p = emit_expression(context, field_find(node[2], "p")); let d_re_node = field_find(node[2], "d"); let d_im = new_register(context); let d_re = 0;
    if (d_re_node == null) { d_re = emit_expression(context, field_find(node[2], "d_re")); d_im = emit_expression(context, field_find(node[2], "d_im")); }
    else { d_re = emit_expression(context, d_re_node); array_push(context[0], string_concat("LOAD_CONST ", reg(d_im), " 0")); }
    array_push(context[0], string_concat("STATE_BUILD ", reg(p), " ", reg(d_re), " ", reg(d_im), " ", reg(destination)));
    let metadata = ["timestamp", "source", "weight", "confidence"]; let index = 0;
    while (index < array_length(metadata)) {
        let field = field_find(node[2], metadata[index]);
        if (field != null) { array_push(context[0], string_concat("SET_INDEX ", reg(destination), " ", metadata[index], " ", reg(emit_expression(context, field)))); }
        index = index + 1;
    }
    return null;
}

fn emit_extended_statement(context, node) {
    if (node[0] == 9) { return emit_state_statement(context, node); }
    if (node[0] == 10) { array_push(context[0], string_concat("HISTORY ", reg(symbol_find(context, node[1])), " ", node[2], " ", reg(emit_expression(context, node[3])))); return null; }
    if (node[0] == 11) { let target = symbol_find(context, node[1]); array_push(context[0], string_concat("TRANSFORM ", reg(target), " ", reg(target), " ", node[2])); return null; }
    if (node[0] == 12) { array_push(context[0], "TASKGROUP_ENTER"); emit_statements(context, node[1]); array_push(context[0], "TASKGROUP_EXIT"); return null; }
    if (node[0] == 13) { array_push(context[0], string_concat("CANCEL ", reg(emit_expression(context, node[1])))); return null; }
    assert(false, "unsupported statement in native emitter"); return null;
}

fn emit_statement(context, ir_node) {
    context[2] = context[7];
    let node = ir_node[3]; let kind = node[0]; array_push(context[0], string_concat(".line ", number_to_string(node[array_length(node) - 2])));
    if (kind == 2) {
        let source = emit_expression(context, node[3]); let destination = new_register(context);
        symbol_add(context, node[1], destination, ir_node[4][0] == "information"); array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(source))); return null;
    }
    if (kind == 3) { return emit_assignment(context, node[1], node[2], ir_node[4][0] == "information"); }
    if (kind == 4) { return emit_if(context, node); }
    if (kind == 5) { return emit_while(context, node); }
    if (kind == 15) { return emit_for(context, node); }
    if (kind == 6) { array_push(context[0], string_concat("RETURN ", reg(emit_expression(context, node[1])))); return null; }
    if (kind == 7) { emit_expression(context, node[1]); return null; }
    if (kind == 8) { array_push(context[0], string_concat("PRINT ", reg(emit_expression(context, node[1])))); return null; }
    if (kind == 14) { array_push(context[0], string_concat("YIELD R0 ", reg(emit_expression(context, node[1])))); return null; }
    return emit_extended_statement(context, node);
}

fn emit_statements(context, statements) {
    let index = 0; while (index < array_length(statements)) { emit_statement(context, statements[index]); index = index + 1; }
    return null;
}

fn emit_function_named(node, emitted_name, mappings, registry, generators, asyncs, features) {
    let context = emitter_new(emitted_name, registry, generators, asyncs, features); context[6] = mappings; let index = 0;
    let offset = 0; if (node[6]) { offset = 1; } if (node[7]) { offset = 1; }
    context[2] = offset; context[7] = offset;
    while (index < array_length(node[3])) { symbol_add(context, node[3][index], index + offset, false); context[2] = index + offset + 1; index = index + 1; }
    emit_statements(context, node[4]);
    let empty = new_register(context); array_push(context[0], string_concat("LOAD_CONST ", reg(empty), " null")); array_push(context[0], string_concat("RETURN ", reg(empty)));
    let header_sb = sb_new();
    array_push(header_sb, ".function "); array_push(header_sb, emitted_name); array_push(header_sb, " "); array_push(header_sb, number_to_string(array_length(node[3]))); array_push(header_sb, " "); array_push(header_sb, number_to_string(context[12])); array_push(header_sb, "\n");
    array_push(header_sb, string_join(context[0], "\n"));
    return sb_join(header_sb);
}

fn merge_mappings(left, right) {
    let merged = map_new();
    let keys = map_keys(left);
    let index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(left, keys[index]));
        index = index + 1;
    }
    keys = map_keys(right);
    index = 0;
    while (index < array_length(keys)) {
        map_set(merged, keys[index], map_get(right, keys[index]));
        index = index + 1;
    }
    return merged;
}

fn emit_modules(modules, root_index) {
    let sections = sb_new(); let features = [false, host_call_registry(), resolver.compiler_fast_hosts(), resolver.compiler_reserved_calls()];
    let items = modules["items"]; let has_objects = prepare_object_descriptors(modules, root_index);
    let generators = map_new();
    let asyncs = map_new();
    let has_generators = false;
    let has_async = false;
    let has_ad = false;
    let function_count = 0; let module_index = 0;
    while (module_index < array_length(items)) {
        function_count = function_count + array_length(items[module_index][2][1]);
        let module = items[module_index]; let function_index = 0;
        if (module[2][5]) { has_ad = true; }
        while (function_index < array_length(module[2][1])) {
            let function_node = module[2][1][function_index];
            if (function_node[6]) { map_set(generators, string_concat(module[1], function_node[1]), true); has_generators = true; }
            if (function_node[7]) { map_set(asyncs, string_concat(module[1], function_node[1]), true); has_async = true; }
            function_index = function_index + 1;
        }
        module_index = module_index + 1;
    }
    if (!has_objects) { if (function_count > 0) { array_push(sections, "JUMP __main\n"); } }
    module_index = 0;
    while (module_index < array_length(items)) {
        let module = items[module_index]; let function_index = 0;
        let module_index_str = number_to_string(module_index);
        let import_mappings = map_get(modules["import_mappings"], module_index_str);
        let local_mappings = map_get(modules["mappings"], module_index_str);
        let mappings = merge_mappings(local_mappings, import_mappings);
        while (function_index < array_length(module[2][1])) {
            let function_node = module[2][1][function_index];
            array_push(sections, emit_function_named(function_node, string_concat(module[1], function_node[1]), mappings, module[2][4], generators, asyncs, features)); array_push(sections, "\n"); function_index = function_index + 1;
        }
        module_index = module_index + 1;
    }
    if (!has_objects) { if (function_count > 0) { array_push(sections, "__main:\n"); } }
    let root = items[root_index]; let main = emitter_new("main", root[2][4], generators, asyncs, features); main[6] = root[3];
    if (has_objects) {
        let descriptor_register = new_register(main); module_index = 0;
        while (module_index < array_length(items)) {
            let objects = items[module_index][2][4][3]; let names = map_keys(objects); let index = 0;
            while (index < array_length(names)) { if (!map_has(objects[names[index]], "imported")) { array_push(main[0], string_concat("LOAD_STRING ", reg(descriptor_register), " ", objects[names[index]]["hex"])); } index = index + 1; }
            module_index = module_index + 1;
        }
    }
    emit_statements(main, root[2][2]); array_push(main[0], "HALT");
    if (has_objects) {
        let bodies = sb_join(sections); sections = sb_new();
        array_push(sections, string_concat(".function __lana_entry__ 0 ", number_to_string(main[12]), "\n", string_join(main[0], "\n"), "\n", bodies));
    } else { array_push(sections, string_join(main[0], "\n")); array_push(sections, "\n"); }
    let output = sb_join(sections); let version = ".version 2\n";
    if (has_async) { version = ".version 4\n"; } else { if (has_generators) { version = ".version 3\n"; } else { if (has_ad) { version = ".version 3\n"; } } }
    if (features[0]) { version = ".version 5\n"; }
    if (has_objects) { version = ".version 6\n"; }
    return string_concat(version, output);
}

fn emit_object(context, node) {
    let opcode = node[1]; let descriptor = context[8][3][node[2]]["hex"]; let destination = new_register(context);
    if (opcode == "OO_GET") {
        let receiver = emit_expression(context, node[3][0]);
        array_push(context[0], string_concat(opcode, " ", reg(destination), " ", reg(receiver), " ", descriptor, " ", number_to_string(node[4]))); return destination;
    }
    let packed = emit_contiguous(context, node[3]); let source = "-";
    if (packed[1] > 0) { source = reg(packed[0]); }
    let member = packed[1];
    if (opcode == "OO_CALL") { member = node[4]; }
    if (opcode == "OO_STATIC_CALL") { member = node[4]; }
    if (opcode == "OO_CALL") { let array = new_register(context); array_push(context[0], string_concat("ARRAY_NEW ", reg(array), " ", reg(packed[0]), " ", number_to_string(packed[1]))); source = reg(array); }
    if (opcode == "OO_STATIC_CALL") { let array = new_register(context); array_push(context[0], string_concat("ARRAY_NEW ", reg(array), " ", reg(packed[0]), " ", number_to_string(packed[1]))); source = reg(array); }
