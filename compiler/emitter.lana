import "./syntax.lana" as syntax;
import "./resolver.lana" as resolver;

fn emitter_new(namespace, registry, generators, asyncs, features) { return [array_new(0), map_new(), 0, 0, namespace, map_new(), map_new(), 0, registry, generators, asyncs, features, 0]; }
fn emit(context, line) { array_push(context[0], line); return null; }
fn reg(number) { return string_concat("R", number_to_string(number)); }

fn sb_new() { return array_new(0); }
fn sb_push(sb, part) { array_push(sb, part); return null; }
fn sb_join(sb) { return string_join(sb, ""); }

fn new_register(context) {
    let value = context[2]; let next = value + 1; context[2] = next;
    if (next > context[12]) { context[12] = next; }
    if (next > 256) { assert(false,
        string_concat("function ", context[4], " requires more than 256 registers")); }
    return value;
}

fn new_label(context, kind) {
    context[3] = context[3] + 1;
    return string_concat("__", context[4], "_", kind, "_", number_to_string(context[3]));
}

fn symbol_add(context, name, register, information) {
    map_set(context[1], name, register);
    map_set(context[5], name, information);
    if (register + 1 > context[7]) { context[7] = register + 1; }
    if (register + 1 > context[12]) { context[12] = register + 1; }
    return register;
}

fn symbol_is_information(context, name) {
    if (!map_has(context[5], name)) { return false; }
    return map_get(context[5], name);
}

fn expression_is_information(context, node) {
    let kind = node[0];
    if (kind == 21) { return symbol_is_information(context, node[1]); }
    if (kind == 22) { if (expression_is_information(context, node[2])) { return true; } return expression_is_information(context, node[3]); }
    if (kind == 23) { return expression_is_information(context, node[2]); }
    if (kind == 25) {
        let index = 0; while (index < array_length(node[1])) { if (expression_is_information(context, node[1][index])) { return true; } index = index + 1; }
    }
    if (kind == 26) { return expression_is_information(context, node[1]); }
    if (kind == 27) { return expression_is_information(context, node[1]); }
    if (kind == 28) {
        let index = 0; while (index < array_length(node[1])) { if (expression_is_information(context, node[1][index][1])) { return true; } index = index + 1; }
    }
    if (kind == 29) { return true; } if (kind == 30) { return true; } if (kind == 38) { return true; }
    if (kind == 31) {
        if (node[1] == "append") { return false; } if (node[1] == "append_redundant") { return false; }
        if (node[1] == "append_full_redundancy") { return false; } if (node[1] == "append_complementary") { return false; }
        if (node[1] == "sample") { return false; }
        if (node[1] == "resolve") { return false; } return true;
    }
    if (kind == 24) { return call_target(context, node[1]) == "__core_distribution__"; }
    return false;
}

fn field_find(fields, name) {
    let index = 0; while (index < array_length(fields)) { if (fields[index][0] == name) { return fields[index][1]; } index = index + 1; }
    return null;
}

fn replace_commas(text) {
    let pieces = array_new(0); let index = 0;
    while (index < string_length(text)) {
        if (string_byte_at(text, index) == 44) { array_push(pieces, ";"); }
        else { array_push(pieces, string_slice(text, index, index + 1)); }
        index = index + 1;
    }
    return string_join(pieces, "");
}

fn symbol_find(context, name) {
    if (!map_has(context[1], name)) { assert(false, string_concat("unknown name ", name)); }
    return map_get(context[1], name);
}

fn call_target(context, name) {
    if (map_has(context[6], name)) { return map_get(context[6], name); }
    return name;
}

fn host_call_registry() {
    let names = "args,read_text,write_text,now,random,random_seed,floor,string_to_number,type_of,assert,map_new,map_has,map_get,map_set,map_keys,index_get,index_set,json_parse,json_stringify,string_length,string_byte_at,string_slice,string_concat,number_to_string,array_new,array_push,string_hex,string_join,array_length,string_unescape,path_resolve,directory_list,directory_create,path_exists,write_text_atomic,hash_update,hash_xor,store_open,store_put,store_get,store_delete,store_commit,store_scan,store_current_revision,future_message,policy_evaluate,policy_store_decision,ledger_append,ledger_query,csv_read,csv_write,lazy_bound,surprisal,tensor,tensor_complex,zeros,ones,eye,shape,ndim,dtype,cast,reshape,transpose,exp,log,sqrt,relu,softmax,logsumexp,argmax,tensor_compare,tensor_select,gather,cholesky_solve,random_uniform,random_normal,device,to_device,to_cpu,matmul,sum,mean,max,min,set_new,set_add,set_contains,set_union,set_intersect,set_difference,getenv,format,format_number,char_length,string_codepoint_slice,to_upper,to_lower,regex_compile,regex_match,regex_search,regex_replace,gpu_matmul,density_operator,povm,channel,observable,tensor_product,partial_trace,measure_with,apply_to,is_separable,to_state,grad,vjp,sgd,adam,train,update,resume,mcmc,vi,smc,infer,state_tensor,append,measure,transform,run_async,future_all,future_race,sleep,dataset,select,limit,sort,group_by,aggregate,join,materialize,explain,dataset_map,dataset_filter,dataset_explain,http_get,http_post,execution_capability,execution_authorize,execution_execute,socket_connect,socket_send,socket_recv,socket_close,dataset_materialize,core_entropy,core_conditional_entropy,core_mutual_information,core_forget_weights,core_assign_weights,core_identity_kernel,core_compose_kernels,core_kernel,core_network,core_infer,core_broja,dataset_source,dataset_query,dataset_apply,dataset_snapshot,dataset_evidence,dataset_exclusions,document_extract,snapshot,dataset_sqlite,rules_learn,rules_predict,rules_save,rules_add_counterexample,rules_inspect,rules_rollback,trees_fit,trees_predict,trees_explain,trees_save,trees_load,evaluation_walk_forward,";
    let calls = map_new(); let start = 0; let index = 0;
    while (index < string_length(names)) {
        if (string_byte_at(names, index) == 44) {
            map_set(calls, string_slice(names, start, index), true);
            start = index + 1;
        }
        index = index + 1;
    }
    return calls;
}

fn is_host_call(context, name) { return map_has(context[11][1], name); }

fn host_call_name(name) {
    if (name == "zeros") { return "tensor_zeros"; }
    if (name == "ones") { return "tensor_ones"; }
    if (name == "eye") { return "tensor_eye"; }
    if (name == "shape") { return "tensor_shape"; }
    if (name == "ndim") { return "tensor_ndim"; }
    if (name == "dtype") { return "tensor_dtype"; }
    if (name == "cast") { return "tensor_cast"; }
    if (name == "reshape") { return "tensor_reshape"; }
    if (name == "transpose") { return "tensor_transpose"; }
    if (name == "exp") { return "tensor_exp"; } if (name == "log") { return "tensor_log"; }
    if (name == "sqrt") { return "tensor_sqrt"; } if (name == "relu") { return "tensor_relu"; }
    if (name == "softmax") { return "tensor_softmax"; }
    if (name == "logsumexp") { return "tensor_logsumexp"; }
    if (name == "argmax") { return "tensor_argmax"; }
    if (name == "tensor_compare") { return "tensor_compare"; }
    if (name == "tensor_select") { return "tensor_select"; }
    if (name == "gather") { return "tensor_gather"; }
    if (name == "cholesky_solve") { return "cholesky_solve"; }
    if (name == "random_uniform") { return "random_uniform"; }
    if (name == "random_normal") { return "random_normal"; }
    if (name == "device") { return "tensor_device"; }
    if (name == "to_device") { return "tensor_to_device"; }
    if (name == "to_cpu") { return "tensor_to_cpu"; }
    if (name == "matmul") { return "tensor_matmul"; }
    if (name == "gpu_matmul") { return "gpu_matmul"; }
    if (name == "sum") { return "tensor_sum"; }
    if (name == "mean") { return "tensor_mean"; }
    if (name == "max") { return "tensor_max"; }
    if (name == "min") { return "tensor_min"; }
    if (name == "select") { return "dataset_select"; }
    if (name == "limit") { return "dataset_limit"; }
    if (name == "sort") { return "dataset_sort"; }
    if (name == "group_by") { return "dataset_group_by"; }
    if (name == "aggregate") { return "dataset_aggregate"; }
    if (name == "join") { return "dataset_join"; }
    if (name == "materialize") { return "dataset_materialize"; }
    if (name == "explain") { return "dataset_explain"; }
    if (name == "dataset_explain") { return "dataset_explain"; }
    return name;
}

fn is_type_builtin(name) {
    if (name == "information") { return true; }
    if (name == "claim") { return true; }
    if (name == "sample_value") { return true; }
    if (name == "sample_metadata") { return true; }
    if (name == "claim_value") { return true; }
    if (name == "claim_proposition") { return true; }
    if (name == "claim_status") { return true; }
    if (name == "planned_effect") { return true; }
    if (name == "execute_effect") { return true; }
    if (name == "effect_status") { return true; }
    if (name == "inspect_information") { return true; }
    if (name == "capability") { return true; }
    if (name == "result_ok") { return true; }
    if (name == "result_error") { return true; }
    if (name == "result_is_ok") { return true; }
    if (name == "result_value") { return true; }
    return name == "result_error_value";
}

fn is_shared_builtin(name) {
    if (name == "shared_information") { return true; }
    if (name == "shared_grant") { return true; }
    if (name == "shared_revoke") { return true; }
    if (name == "shared_snapshot") { return true; }
    if (name == "shared_at") { return true; }
    if (name == "shared_observe") { return true; }
    if (name == "shared_revision") { return true; }
    if (name == "shared_identity") { return true; }
    if (name == "shared_wait") { return true; }
    if (name == "grant") { return true; }
    return name == "revoke";
}

// Move already-emitted register numbers into one contiguous block.
fn pack_registers(context, values) {
    let base = context[2]; let count = array_length(values); let index = 0;
    if (count == 1) { return [values[0], 1]; }
    if (count > 0) {
        let first = values[0]; let contiguous = true;
        while (index < count) {
            if (values[index] != first + index) { contiguous = false; }
            index = index + 1;
        }
        if (contiguous) { return [first, count]; }
        index = 0;
    }
    while (index < count) {
        let destination = new_register(context);
        array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(values[index]))); index = index + 1;
    }
    return [base, count];
}

fn emit_contiguous(context, arguments) {
    let count = array_length(arguments);
    if (count == 0) { return [context[2], 0]; }
    if (count == 1) { return [emit_expression(context, arguments[0]), 1]; }
    if (count == 2) {
        let first = emit_expression(context, arguments[0]);
        let second = emit_expression(context, arguments[1]);
        if (second == first + 1) { return [first, 2]; }
        let base = new_register(context);
        array_push(context[0], string_concat("MOVE ", reg(base), " ", reg(first)));
        let next = new_register(context);
        array_push(context[0], string_concat("MOVE ", reg(next), " ", reg(second)));
        return [base, 2];
    }
    let values = array_new(0); let index = 0;
    while (index < count) { array_push(values, emit_expression(context, arguments[index])); index = index + 1; }
    return pack_registers(context, values);
}

fn adt_variant_lookup(registry, name) {
    if (registry == null) { return null; }
    if (!map_has(registry[0], name)) { return null; }
    return map_get(registry[0], name);
}

fn emit_adt_build(context, variant_index, arguments) {
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("ADT_BUILD ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", number_to_string(variant_index)));
    return destination;
}

fn emit_match(context, node) {
    let scrutinee = emit_expression(context, node[1]);
    let end = new_label(context, "matchend"); let result = new_register(context);
    let arms = node[2]; let labels = array_new(0); let index = 0;
    while (index < array_length(arms)) { array_push(labels, new_label(context, "arm")); index = index + 1; }
    let default_label = null; index = 0;
    while (index < array_length(arms)) {
        let pattern = arms[index][0];
        if (pattern[0] == "variant") {
            let variant = adt_variant_lookup(context[8], pattern[1]);
            assert(variant != null, string_concat("unknown variant ", pattern[1]));
            array_push(context[0], string_concat("ADT_CASE ", reg(scrutinee), " ", number_to_string(variant[1]), " ", labels[index]));
        } else {
            if (pattern[0] == "unknown") { array_push(context[0], string_concat("ADT_CASE ", reg(scrutinee), " 4294967295 ", labels[index])); }
            else { default_label = labels[index]; }
        }
        index = index + 1;
    }
    if (default_label == null) { default_label = end; }
    array_push(context[0], string_concat("JUMP ", default_label));
    index = 0;
    while (index < array_length(arms)) {
        let arm = arms[index]; let pattern = arm[0];
        array_push(context[0], string_concat(labels[index], ":"));
        if (pattern[0] == "variant") {
            let bindings = pattern[2]; let binding_index = 0;
            while (binding_index < array_length(bindings)) {
                let field = new_register(context);
                array_push(context[0], string_concat("ADT_GET ", reg(field), " ", reg(scrutinee), " ", number_to_string(binding_index)));
                symbol_add(context, bindings[binding_index], field, false);
                binding_index = binding_index + 1;
            }
        }
        let value = emit_expression(context, arm[1]);
        array_push(context[0], string_concat("MOVE ", reg(result), " ", reg(value)));
        array_push(context[0], string_concat("JUMP ", end));
        index = index + 1;
    }
    array_push(context[0], string_concat(end, ":"));
    return result;
}

fn emit_literal(context, node) {
    let destination = new_register(context);
    if (node[1] == "string") {
        let encoded = string_hex(node[2]);
        if (string_length(encoded) == 0) { encoded = "-"; }
        array_push(context[0], string_concat("LOAD_STRING ", reg(destination), " ", encoded));
    } else {
        let text = node[2];
        if (node[1] == "bool") { if (node[2]) { text = "true"; } else { text = "false"; } }
        if (node[1] == "null") { text = "null"; }
        array_push(context[0], string_concat("LOAD_CONST ", reg(destination), " ", text));
    }
    return destination;
}

fn emit_tagged_pair(context, tag, value) {
    let arguments = [syntax.literal_node("bool", tag, 0, 0), value];
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
    return destination;
}

fn emit_pair(context, left, right) {
    let arguments = [left, right]; let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
    return destination;
}

fn emit_pair_index(context, value, index) {
    let arguments = [value, syntax.literal_node("number", number_to_string(index), 0, 0)];
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination)));
    return destination;
}

fn emit_sample_record(context, source, dependency, operation) {
    let dependency_register = emit_literal(context, syntax.literal_node("string", dependency, 0, 0));
    let operation_register = emit_literal(context, syntax.literal_node("string", operation, 0, 0));
    let base = context[2]; let destination = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(source)));
    destination = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(dependency_register)));
    destination = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(operation_register)));
    destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL sample_record ", reg(base), " 3 ", reg(destination)));
    return destination;
}

fn emit_map_field(context, source, field) {
    let field_register = emit_literal(context, syntax.literal_node("string", field, 0, 0));
    let base = context[2]; let destination = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(source)));
    destination = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(field_register)));
    destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL index_get ", reg(base), " 2 ", reg(destination)));
    return destination;
}

fn emit_host_builtin(context, name, arguments) {
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL ", name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn is_state_field(name) {
    if (name == "p") { return true; }
    if (name == "d") { return true; }
    if (name == "d_re") { return true; }
    if (name == "d_im") { return true; }
    if (name == "params") { return true; }
    if (name == "steps") { return true; }
    if (name == "mean") { return true; }
    if (name == "variance") { return true; }
    if (name == "samples") { return true; }
    if (name == "history") { return true; }
    return false;
}

fn emit_type_builtin(context, node) {
    let name = node[1];
    if (name == "information") { return emit_host_builtin(context, "information_new", node[2]); }
    if (name == "sample_value") { return emit_pair_index(context, node[2][0], 0); }
    if (name == "sample_metadata") { return emit_pair_index(context, node[2][0], 1); }
    if (name == "capability") { return emit_host_builtin(context, "shared_information", node[2]); }
    if (name == "claim") { return emit_host_builtin(context, "claim_new", node[2]); }
    if (name == "planned_effect") { return emit_host_builtin(context, "planned_effect_new", node[2]); }
    if (name == "result_ok") { return emit_tagged_pair(context, true, node[2][0]); }
    if (name == "result_error") { return emit_tagged_pair(context, false, node[2][0]); }
    if (name == "claim_value") { return emit_host_builtin(context, "claim_value", node[2]); }
    if (name == "claim_proposition") { return emit_host_builtin(context, "claim_proposition", node[2]); }
    if (name == "claim_status") { return emit_host_builtin(context, "claim_status", node[2]); }
    if (name == "execute_effect") { return emit_host_builtin(context, "planned_effect_execute", node[2]); }
    if (name == "effect_status") { return emit_host_builtin(context, "planned_effect_status", node[2]); }
    if (name == "inspect_information") { return emit_host_builtin(context, "information_inspect", node[2]); }
    if (name == "result_is_ok") { return emit_pair_index(context, node[2][0], 0); }
    if (name == "result_value") { return emit_pair_index(context, node[2][0], 1); }
    return emit_pair_index(context, node[2][0], 1);
}

fn emit_shared_builtin(context, node) {
    return emit_host_builtin(context, node[1], node[2]);
}

fn emit_next(context, node) {
    let source = emit_expression(context, node[2][0]);
    let destination = new_register(context);
    array_push(context[0], string_concat("NEXT ", reg(source), " ", reg(destination)));
    return destination;
}

fn emit_generator_call(context, target, packed, destination) {
    let opcode = "CALL";
    if (map_has(context[9], target)) { opcode = "GENERATOR"; }
    if (map_has(context[10], target)) { opcode = "ASYNC"; }
    array_push(context[0], string_concat(opcode, " ", target, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return null;
}

fn emit_call(context, node) {
    if (map_has(context[11][2], node[1])) {
        return emit_direct_host(context, node);
    }
    if (!map_has(context[11][3], node[1])) { if (map_has(context[6], node[1])) {
        let target = context[6][node[1]];
        if (target == "__core_kernel__") { return emit_core_kernel(context, node); }
        if (target == "__evaluation_walk_forward__") { return emit_evaluation_walk_forward(context, node); }
        return emit_direct_function(context, node);
    } }
    let variant = adt_variant_lookup(context[8], node[1]);
    if (variant != null) { return emit_adt_build(context, variant[1], node[2]); }
    if (is_shared_builtin(node[1])) { return emit_shared_builtin(context, node); }
    if (is_type_builtin(node[1])) { return emit_type_builtin(context, node); }
    if (node[1] == "mix") {
        let left = emit_expression(context, node[2][0]);
        let right = emit_expression(context, node[2][1]);
        let weight = emit_expression(context, node[2][2]);
        let destination = new_register(context);
        array_push(context[0], string_concat("MIX ", reg(destination), " ", reg(left), " ", reg(right), " ", reg(weight)));
        return destination;
    }
    if (node[1] == "map") { if (array_length(node) == 6) { return emit_iterator_map(context, node); } }
    if (node[1] == "filter") { return emit_iterator_filter(context, node); }
    if (node[1] == "reduce") { return emit_iterator_reduce(context, node); }
    if (node[1] == "map") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        array_push(context[0], string_concat("MAP ", reg(destination), " ", reg(source), " ", node[2][1][1]));
        return destination;
    }
    if (node[1] == "support") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        array_push(context[0], string_concat("SUPPORT ", reg(destination), " ", reg(source), " ", node[2][1][2]));
        return destination;
    }
    if (node[1] == "expect") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        array_push(context[0], string_concat("EXPECT ", reg(destination), " ", reg(source), " ", node[2][1][1]));
        return destination;
    }
    if (node[1] == "validate") {
        let value = emit_expression(context, node[2][0]);
        let schema = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("VALIDATE ", reg(destination), " ", reg(value), " ", reg(schema)));
        return destination;
    }
    if (node[1] == "revision") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        array_push(context[0], string_concat("REVISION ", reg(destination), " ", reg(source)));
        return destination;
    }
    if (node[1] == "attenuate") {
        let source = emit_expression(context, node[2][0]);
        let factor = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("ATTENUATE ", reg(destination), " ", reg(source), " ", reg(factor)));
        return destination;
    }
    if (node[1] == "trace_distance") {
        let left = emit_expression(context, node[2][0]);
        let right = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("TRACE_DISTANCE ", reg(destination), " ", reg(left), " ", reg(right)));
        return destination;
    }
    return emit_runtime_call(context, node);
}

fn emit_runtime_call(context, node) {
    if (node[1] == "lazy") { return emit_lazy_force(context, node); }
    if (node[1] == "force") { return emit_lazy_force(context, node); }
    if (node[1] == "force_all") { return emit_lazy_force(context, node); }
    if (node[1] == "bootstrap") { return emit_bootstrap(context, node); }
    if (node[1] == "next") { return emit_next(context, node); }
    if (node[1] == "grad") { return emit_grad_vjp(context, node, "grad"); }
    if (node[1] == "vjp") { return emit_grad_vjp(context, node, "vjp"); }
    if (node[1] == "train") { return emit_train(context, node); }
    if (node[1] == "infer") { return emit_infer(context, node); }
    if (node[1] == "run_async") {
        let source = emit_expression(context, node[2][0]);
        let destination = new_register(context);
        array_push(context[0], string_concat("RUN_ASYNC ", reg(source), " ", reg(destination)));
        return destination;
    }
    if (node[1] == "dataset_map") { return emit_dataset_fn(context, node, "dataset_map"); }
    if (node[1] == "dataset_filter") { return emit_dataset_fn(context, node, "dataset_filter"); }
    let variant = call_target(context, node[1]);
    if (variant == "__core_kernel__") { return emit_core_kernel(context, node); }
    if (variant == "__evaluation_walk_forward__") { return emit_evaluation_walk_forward(context, node); }
    let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
    if (is_host_call(context, node[1])) {
        array_push(context[0], string_concat("HOST_CALL ", host_call_name(node[1]), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    } else {
        emit_generator_call(context, variant, packed, destination);
    }
    if (node[1] == "random") { return emit_sample_record(context, destination, "host:random", "random"); }
    return destination;
}

fn emit_core_kernel(context, node) {
    assert(node[2][2][0] == 21, "kernel callback must be a function name");
    let values = array_new(0);
    array_push(values, emit_expression(context, node[2][0]));
    array_push(values, emit_expression(context, node[2][1]));
    let callback = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(callback), " ", call_target(context, node[2][2][1])));
    array_push(values, callback);
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL core_kernel ", reg(packed[0]), " 3 ", reg(destination)));
    return destination;
}

fn emit_evaluation_walk_forward(context, node) {
    let entries = node[2][1][1];
    let arguments = array_new(0); let index = 0;
    while (index < array_length(entries)) {
        let field = entries[index];
        array_push(arguments, emit_literal(context, syntax.literal_node("string", field[0], 0, 0)));
        let callback_field = field[0] == "fit";
        if (field[0] == "predict") { callback_field = true; }
        if (callback_field) {
            let callback = new_register(context);
            array_push(context[0], string_concat("LOAD_FUNCTION ", reg(callback), " ", call_target(context, field[1][1])));
            array_push(arguments, callback);
        } else { array_push(arguments, emit_expression(context, field[1])); }
        index = index + 1;
    }
    let packed = pack_registers(context, arguments);
    let trainer = new_register(context);
    array_push(context[0], string_concat("HOST_CALL map_new ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(trainer)));
    let inputs = [emit_expression(context, node[2][0]), trainer, emit_expression(context, node[2][2])];
    packed = pack_registers(context, inputs);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL evaluation_walk_forward ", reg(packed[0]), " 3 ", reg(destination)));
    return destination;
}

fn emit_binary(context, node) {
    let left = emit_expression(context, node[2]); let right = emit_expression(context, node[3]);
    let destination = new_register(context); let opcode = "BINARY";
    if (node[1] == "==") { opcode = "COMPARE"; } if (node[1] == "!=") { opcode = "COMPARE"; }
    if (node[1] == "<") { opcode = "COMPARE"; } if (node[1] == "<=") { opcode = "COMPARE"; }
    if (node[1] == ">") { opcode = "COMPARE"; } if (node[1] == ">=") { opcode = "COMPARE"; }
    array_push(context[0], string_concat(opcode, " ", reg(left), " ", node[1], " ", reg(right), " ", reg(destination)));
    return destination;
}

fn emit_unary(context, node) {
    let source = emit_expression(context, node[2]); let destination = new_register(context);
    array_push(context[0], string_concat("UNARY ", node[1], " ", reg(source), " ", reg(destination))); return destination;
}

fn emit_array(context, node) {
    let packed = emit_contiguous(context, node[1]); let destination = new_register(context);
    array_push(context[0], string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1])));
    return destination;
}

fn emit_index(context, node) {
    let positions = node[2];
    if (array_length(positions) == 1) {
        if (positions[0][0] != 39) {
            // The single non-slice form keeps the historical two-argument
// * host call, byte-identical to the pre-slicing emitter.
            let arguments = [node[1], positions[0]]; let packed = emit_contiguous(context, arguments); let destination = new_register(context);
            array_push(context[0], string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination))); return destination;
        }
    }
    // Multi-position and slice forms pass a runtime position list: each
// * slice becomes a two-element [start, end] array, and the whole list
// * becomes the spec array the tensor path expects.
    let source = emit_expression(context, node[1]);
    let registers = array_new(0); let index = 0;
    while (index < array_length(positions)) {
        let position = positions[index];
        if (position[0] == 39) {
            let packed = emit_contiguous(context, [position[1], position[2]]);
            let destination = new_register(context);
            array_push(context[0], string_concat("ARRAY_NEW ", reg(destination), " ", reg(packed[0]), " 2"));
            array_push(registers, destination);
        } else {
            array_push(registers, emit_expression(context, position));
        }
        index = index + 1;
    }
    let packed_positions = pack_registers(context, registers);
    let spec = new_register(context);
    array_push(context[0], string_concat("ARRAY_NEW ", reg(spec), " ", reg(packed_positions[0]), " ", number_to_string(packed_positions[1])));
    let packed = pack_registers(context, [source, spec]); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL index_get ", reg(packed[0]), " 2 ", reg(destination))); return destination;
}

fn emit_map(context, node) {
    let arguments = array_new(0); let index = 0;
    while (index < array_length(node[1])) {
        array_push(arguments, syntax.literal_node("string", node[1][index][0], node[2], node[3]));
        array_push(arguments, node[1][index][1]); index = index + 1;
    }
    let packed = emit_contiguous(context, arguments); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL map_new ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination))); return destination;
}

fn emit_joint(context, node) {
    let packed = emit_contiguous(context, node[3]); let destination = new_register(context);
    array_push(context[0], string_concat("JOINT_BUILD ", reg(destination), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", node[1], ":", string_join(node[2], ";")));
    return destination;
}

fn emit_finite_joint(context, node) {
    let rows = emit_expression(context, node[2]); let destination = new_register(context);
    array_push(context[0], string_concat("JOINT_BUILD_FINITE ", reg(rows), " ", reg(destination), " ", string_join(node[1], ";"))); return destination;
}

fn emit_correlated(context, node) {
    let packed = emit_contiguous(context, [node[1], node[2], node[3]]); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL correlated ", reg(packed[0]), " 3 ", reg(destination))); return destination;
}

fn emit_lazy_force(context, node) {
    if (node[1] == "lazy") {
        assert(node[2][0][0] == 21, "lazy generator must be a function name");
        let bound = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("LAZY ", reg(destination), " ", call_target(context, node[2][0][1]), " ", reg(bound)));
        return destination;
    }
    if (node[1] == "force") {
        let source = emit_expression(context, node[2][0]);
        let index = emit_expression(context, node[2][1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("FORCE ", reg(destination), " ", reg(source), " ", reg(index)));
        return destination;
    }
    return emit_force_all(context, node[2][0]);
}

fn emit_bootstrap(context, node) {
    assert(node[2][1][0] == 21, "bootstrap statistic must be a function name");
    let data = emit_expression(context, node[2][0]);
    let b = null;
    if (array_length(node[2]) == 3) {
        b = emit_expression(context, node[2][2]);
    } else {
        b = new_register(context);
        array_push(context[0], string_concat("LOAD_CONST ", reg(b), " 2000"));
    }
    let destination = new_register(context);
    array_push(context[0], string_concat("BOOTSTRAP ", reg(destination), " ", reg(data), " ", reg(b), " ", call_target(context, node[2][1][1])));
    return destination;
}

fn emit_dataset_fn(context, node, host_name) {
    assert(node[2][1][0] == 21, string_concat(host_name, " function must be a function name"));
    let function_reg = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(function_reg), " ", call_target(context, node[2][1][1])));
    let values = array_new(0);
    array_push(values, emit_expression(context, node[2][0]));
    array_push(values, function_reg);
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL ", host_name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_grad_vjp(context, node, host_name) {
    assert(node[2][0][0] == 21, string_concat(host_name, " function must be a function name"));
    let function_reg = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(function_reg), " ", call_target(context, node[2][0][1])));
    let values = array_new(0);
    array_push(values, function_reg);
    let index = 1;
    while (index < array_length(node[2])) {
        array_push(values, emit_expression(context, node[2][index]));
        index = index + 1;
    }
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL ", host_name, " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_train(context, node) {
    assert(node[2][0][0] == 21, "train model must be a function name");
    assert(node[2][2][0] == 21, "train loss must be a function name");
    let model_reg = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(model_reg), " ", call_target(context, node[2][0][1])));
    let loss_reg = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(loss_reg), " ", call_target(context, node[2][2][1])));
    let values = array_new(0);
    array_push(values, model_reg);
    array_push(values, emit_expression(context, node[2][1]));
    array_push(values, loss_reg);
    let index = 3;
    while (index < array_length(node[2])) {
        array_push(values, emit_expression(context, node[2][index]));
        index = index + 1;
    }
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL train ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_infer(context, node) {
    assert(node[2][1][0] == 21, "infer model must be a function name");
    let model_reg = new_register(context);
    array_push(context[0], string_concat("LOAD_FUNCTION ", reg(model_reg), " ", call_target(context, node[2][1][1])));
    let values = array_new(0);
    array_push(values, emit_expression(context, node[2][0]));
    array_push(values, model_reg);
    array_push(values, emit_expression(context, node[2][2]));
    array_push(values, emit_expression(context, node[2][3]));
    let packed = pack_registers(context, values);
    let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL infer ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination)));
    return destination;
}

fn emit_force_all(context, source_node) {
    let source = emit_expression(context, source_node);
    let result = new_register(context);
    array_push(context[0], string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    let index = new_register(context);
    array_push(context[0], string_concat("LOAD_CONST ", reg(index), " 0"));
    let one = new_register(context);
    array_push(context[0], string_concat("LOAD_CONST ", reg(one), " 1"));
    let bound_base = context[2]; let bound = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(bound), " ", reg(source)));
    bound = new_register(context);
    array_push(context[0], string_concat("HOST_CALL lazy_bound ", reg(bound_base), " 1 ", reg(bound)));
    let start = new_label(context, "force_all"); let end = new_label(context, "endforce_all");
    array_push(context[0], string_concat(start, ":"));
    let condition = new_register(context);
    array_push(context[0], string_concat("COMPARE ", reg(index), " < ", reg(bound), " ", reg(condition)));
    array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(condition), " ", end));
    let element = new_register(context);
    array_push(context[0], string_concat("FORCE ", reg(element), " ", reg(source), " ", reg(index)));
    let push_base = context[2]; let push = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(push), " ", reg(result)));
    push = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(push), " ", reg(element)));
    let ignored = new_register(context);
    array_push(context[0], string_concat("HOST_CALL array_push ", reg(push_base), " 2 ", reg(ignored)));
    let next = new_register(context);
    array_push(context[0], string_concat("BINARY ", reg(index), " + ", reg(one), " ", reg(next)));
    array_push(context[0], string_concat("MOVE ", reg(index), " ", reg(next)));
    array_push(context[0], string_concat("JUMP ", start));
    array_push(context[0], string_concat(end, ":"));
    return result;
}

fn emit_append(context, arguments) {
    let left = emit_expression(context, arguments[0]); let right = emit_expression(context, arguments[1]); let destination = new_register(context);
    array_push(context[0], string_concat("APPEND ", reg(left), " ", reg(right), " ", reg(destination))); return destination;
}

fn emit_append_relationship(context, opcode, arguments) {
    let left = emit_expression(context, arguments[0]); let right = emit_expression(context, arguments[1]); let destination = new_register(context);
    if (array_length(arguments) > 2) {
        let strength = emit_expression(context, arguments[2]);
        array_push(context[0], string_concat(opcode, " ", reg(left), " ", reg(right), " ", reg(destination), " ", reg(strength)));
    } else {
        array_push(context[0], string_concat(opcode, " ", reg(left), " ", reg(right), " ", reg(destination)));
    }
    return destination;
}

fn emit_joint_refinement(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "project") { array_push(context[0], string_concat("JOINT_PROJECT ", reg(source), " ", reg(destination), " ", replace_commas(arguments[1][2]))); return destination; }
    if (operation == "condition") {
        if (array_length(arguments) == 2) { let evidence_value = emit_expression(context, arguments[1]); array_push(context[0], string_concat("JOINT_CONDITION_MAP ", reg(source), " ", reg(destination), " ", reg(evidence_value))); context[11][0] = true; return destination; }
        let evidence_value = emit_expression(context, arguments[2]); array_push(context[0], string_concat("JOINT_CONDITION ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", reg(evidence_value))); return destination;
    }
    if (operation == "rename") { array_push(context[0], string_concat("JOINT_RENAME ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", arguments[2][2])); return destination; }
    if (array_length(arguments) == 2) { let evidence_value = emit_expression(context, arguments[1]); array_push(context[0], string_concat("OBSERVE_MAP ", reg(source), " ", reg(destination), " ", reg(evidence_value))); context[11][0] = true; return destination; }
    let evidence_value = emit_expression(context, arguments[2]); array_push(context[0], string_concat("OBSERVE ", reg(source), " ", reg(destination), " ", arguments[1][2], " ", reg(evidence_value))); return destination;
}

fn emit_information_read(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "possibility") { array_push(context[0], string_concat("POSSIBILITY_BUILD ", reg(source), " ", reg(destination))); return destination; }
    if (operation == "sample") {
        if (expression_is_information(context, arguments[0])) { array_push(context[0], string_concat("INFO_SAMPLE ", reg(source), " ", reg(destination))); }
        else { array_push(context[0], string_concat("SAMPLE_STATE_DIST ", reg(source), " ", reg(destination))); }
        return emit_sample_record(context, destination, "information", "sample");
    }
    array_push(context[0], string_concat("RESOLVE ", reg(source), " ", reg(destination))); return destination;
}

fn is_provenance_operation(operation) {
    if (operation == "evidence") { return true; } if (operation == "assume") { return true; }
    if (operation == "derivation") { return true; } return operation == "explain";
}

fn emit_provenance(context, operation, arguments) {
    let source = emit_expression(context, arguments[0]); let destination = new_register(context);
    if (operation == "evidence") { array_push(context[0], string_concat("EVIDENCE ", reg(source), " ", reg(destination), " ", arguments[1][2])); return destination; }
    if (operation == "assume") { array_push(context[0], string_concat("ASSUME ", reg(source), " ", reg(destination), " ", arguments[1][2])); return destination; }
    if (operation == "derivation") { array_push(context[0], string_concat("DERIVATION ", reg(source), " ", reg(destination))); return destination; }
    array_push(context[0], string_concat("EXPLAIN ", reg(source), " ", reg(destination))); return destination;
}

fn emit_information(context, node) {
    if (node[1] == "append") { return emit_append(context, node[2]); }
    if (node[1] == "append_redundant") { return emit_append_relationship(context, "APPEND_REDUNDANT", node[2]); }
    if (node[1] == "append_full_redundancy") { return emit_append_relationship(context, "APPEND_FULL_REDUNDANCY", node[2]); }
    if (node[1] == "append_complementary") { return emit_append_relationship(context, "APPEND_COMPLEMENTARY", node[2]); }
    if (node[1] == "project") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "condition") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "rename") { return emit_joint_refinement(context, node[1], node[2]); }
    if (node[1] == "observe") { return emit_joint_refinement(context, node[1], node[2]); }
    if (is_provenance_operation(node[1])) { return emit_provenance(context, node[1], node[2]); }
    return emit_information_read(context, node[1], node[2]);
}

fn emit_measure(context, node) {
    let destination = new_register(context); let source = emit_expression(context, node[1]);
    if (node[2] == "") { array_push(context[0], string_concat("MEASURE ", reg(source), " ", node[3], " ", reg(destination))); }
    else { array_push(context[0], string_concat("MEASURE_BASIS ", reg(source), " ", reg(destination), " ", node[2], " ", node[3])); }
    if (node[3] == "sample") { return emit_sample_record(context, destination, "measure", "measure"); }
    return destination;
}

fn emit_estimate_measure(context, node) {
    let opcode = "ESTIMATE_MEASURE_DISTRIBUTION"; if (node[3] == "probability") { opcode = "ESTIMATE_MEASURE_PROBABILITY"; }
    let destination = new_register(context); array_push(context[0], string_concat(opcode, " ", reg(symbol_find(context, node[1])), " ", reg(destination), " ", node[2], " ", node[4]));
    return emit_sample_record(context, destination, node[1], "estimate_measure");
}

fn emit_task_expression(context, node) {
    if (node[0] == 35) {
        let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
        array_push(context[0], string_concat("FORK ", call_target(context, node[1]), " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination))); return destination;
    }
    if (node[0] == 36) {
        let task = emit_expression(context, node[2]); let destination = new_register(context);
        let opcode = "JOIN"; if (node[1] == "join_all") { opcode = "JOIN_ALL"; }
        array_push(context[0], string_concat(opcode, " ", reg(task), " ", reg(destination))); return destination;
    }
    let task = emit_expression(context, node[1]); let timeout = emit_expression(context, node[2]); let destination = new_register(context);
    array_push(context[0], string_concat("JOIN_TIMEOUT ", reg(task), " ", reg(timeout), " ", reg(destination))); return destination;
}

fn emit_extended_expression(context, node) {
    let kind = node[0];
    if (kind == 27) {
        let source = emit_expression(context, node[1]); let opcode = "GET_FIELD";
        if (node[2] == "timestamp") { opcode = "GET_INDEX"; } if (node[2] == "source") { opcode = "GET_INDEX"; }
        if (node[2] == "weight") { opcode = "GET_INDEX"; } if (node[2] == "confidence") { opcode = "GET_INDEX"; }
        if (opcode == "GET_FIELD") {
            if (is_state_field(node[2]) == false) { return emit_map_field(context, source, node[2]); }
        }
        let destination = new_register(context);
        array_push(context[0], string_concat(opcode, " ", reg(source), " ", node[2], " ", reg(destination))); return destination;
    }
    if (kind == 28) { return emit_map(context, node); }
    if (kind == 29) { return emit_joint(context, node); }
    if (kind == 30) { return emit_finite_joint(context, node); }
    if (kind == 31) { return emit_information(context, node); }
    if (kind == 32) { return emit_measure(context, node); }
    if (kind == 33) { return emit_estimate_measure(context, node); }
    if (kind == 34) {
        let opcode = "PREVIOUS"; if (node[1] == "change") { opcode = "CHANGE"; } if (node[1] == "velocity") { opcode = "VELOCITY"; }
        let destination = new_register(context); array_push(context[0], string_concat(opcode, " ", reg(symbol_find(context, node[2])), " ", reg(destination))); return destination;
    }
    if (kind == 35) { return emit_task_expression(context, node); }
    if (kind == 36) { return emit_task_expression(context, node); }
    if (kind == 37) { return emit_task_expression(context, node); }
    if (kind == 38) { return emit_correlated(context, node); }
    assert(false, "unsupported expression in native emitter"); return 0;
}

fn emit_expression(context, node) {
    let kind = node[0];
    if (kind == 48) { return emit_object(context, node); }
    if (kind == 20) { return emit_literal(context, node); }
    if (kind == 21) {
        let variant = adt_variant_lookup(context[8], node[1]);
        if (variant != null) { return emit_adt_build(context, variant[1], array_new(0)); }
        return symbol_find(context, node[1]);
    }
    if (kind == 22) { return emit_binary(context, node); }
    if (kind == 23) { return emit_unary(context, node); }
    if (kind == 24) {
        if (call_target(context, node[1]) == "__core_distribution__") {
            let source = emit_expression(context, node[2][0]); let destination = new_register(context);
            array_push(context[0], string_concat("DISTRIBUTION_BUILD ", reg(source), " ", reg(destination)));
            context[11][0] = true;
            return destination;
        }
        return emit_call(context, node);
    }
    if (kind == 25) { return emit_array(context, node); }
    if (kind == 26) { return emit_index(context, node); }
    if (kind == 44) { return emit_comprehension(context, node); }
    if (kind == 40) { return emit_match(context, node); }
    if (kind == 43) { return emit_adt_build(context, 4294967295, array_new(0)); }
    if (kind == 45) {
        let source = emit_expression(context, node[1]);
        let destination = new_register(context);
        array_push(context[0], string_concat("AWAIT ", reg(source), " ", reg(destination)));
        return destination;
    }
    return emit_extended_expression(context, node);
}

fn emit_assignment(context, target, value, information) {
    if (target[0] == 48) {
        let receiver = emit_expression(context, target[3][0]); let source = emit_expression(context, value);
        array_push(context[0], string_concat("OO_SET ", reg(receiver), " ", reg(source), " ", context[8][3][target[2]]["hex"], " ", number_to_string(target[4]))); return null;
    }
    if (target[0] == 21) {
        let source = emit_expression(context, value); let destination = symbol_find(context, target[1]);
        map_set(context[5], target[1], information);
        array_push(context[0], string_concat("MOVE ", reg(destination), " ", reg(source))); return null;
    }
    if (target[0] == 26) {
        // Assignment goes through index_set, which takes one position:
// * slices and multi-position targets are read-only views.
        let positions = target[2];
        let position = 0; let sliced = false;
        while (position < array_length(positions)) {
            if (positions[position][0] == 39) { sliced = true; }
            position = position + 1;
        }
        assert(!sliced, "slices cannot be assigned");
        assert(array_length(positions) == 1, "assignment accepts a single index position");
        let arguments = [target[1], positions[0], value]; let packed = emit_contiguous(context, arguments); let ignored = new_register(context);
        array_push(context[0], string_concat("HOST_CALL index_set ", reg(packed[0]), " 3 ", reg(ignored))); return null;
    }
    assert(false, "invalid assignment target"); return null;
}

fn emit_if(context, node) {
    let otherwise = new_label(context, "else"); let end = new_label(context, "endif");
    let predicate = emit_expression(context, node[1]);
    let uncertain = node[4]; let opcode = "JUMP_IF_FALSE";
    if (uncertain) { opcode = "PATH_SPLIT"; }
