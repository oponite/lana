fn object_qualified_type(name, module, objects) {
    if (name == null) { return null; }
    if (string_length(name) > 13) { if (string_slice(name, 0, 12) == "Information<") {
        return string_concat("Information<", object_qualified_type(string_slice(name, 12, string_length(name) - 1), module, objects), ">");
    } }
    if (map_has(objects, name)) { let object = objects[name]; if (map_has(object, "imported")) { object = object["imported"]; } return object["qualified_name"]; }
    return name;
}
fn prepare_object_descriptors(modules, root_index) {
    let items = modules["items"];
    prepare_portable_modules(modules, root_index);
    let functions = map_new(); let next = 1; let module_index = 0; let has_objects = false;
    while (module_index < array_length(items)) {
        let module = items[module_index]; let index = 0;
        while (index < array_length(module[2][1])) { functions[string_concat(module[1], module[2][1][index][1])] = next; next = next + 1; index = index + 1; }
        let objects = module[2][4][3]; let names = map_keys(objects); index = 0;
        while (index < array_length(names)) { if (!map_has(objects[names[index]], "imported")) { objects[names[index]]["qualified_name"] = string_concat(module[4], "/", names[index]); } has_objects = true; index = index + 1; }
        module_index = module_index + 1;
    }
    module_index = 0;
    while (module_index < array_length(items)) {
        let module = items[module_index]; let objects = module[2][4][3]; let names = map_keys(objects); let index = 0;
        while (index < array_length(names)) {
            let object = objects[names[index]];
            if (!map_has(object, "imported")) {
            let fields = array_new(0); let methods = array_new(0); let interfaces = array_new(0); let member = 0;
            while (member < array_length(object["fields"])) {
                let field = object["fields"][member]; let function = null;
                if (field["function"] != null) { function = functions[string_concat(module[1], field["function"])]; }
                array_push(fields, {"name":field["name"],"type":object_qualified_type(field["type"], module, objects),"visibility":field["visibility"],"mutable":field["mutable"],"default_function":function}); member = member + 1;
            }
            member = 0;
            while (member < array_length(object["methods"])) {
                let method = object["methods"][member]; let function = null; let parameters = array_new(0); let parameter = 0;
                if (method["function"] != null) { function = functions[string_concat(module[1], method["function"])]; }
                while (parameter < array_length(method["parameter_types"])) { array_push(parameters, object_qualified_type(method["parameter_types"][parameter], module, objects)); parameter = parameter + 1; }
                array_push(methods, {"name":method["name"],"visibility":method["visibility"],"static":method["static"],"parameter_types":parameters,
                    "result_type":object_qualified_type(method["result_type"], module, objects),"effect_mask":object_effect_mask(method["inferred"]),"function_index":function,"is_init":method["is_init"]}); member = member + 1;
            }
            member = 0; while (member < array_length(object["implements"])) { array_push(interfaces, object_qualified_type(object["implements"][member], module, objects)); member = member + 1; }
            object["hex"] = string_hex(json_stringify({"schema_version":1,"kind":object["kind"],"qualified_name":object["qualified_name"],"fields":fields,"methods":methods,"implements":interfaces}));
            }
            index = index + 1;
        }
        module_index = module_index + 1;
    }
    module_index = 0;
    while (module_index < array_length(items)) {
        let objects = items[module_index][2][4][3]; let names = map_keys(objects); let index = 0;
        while (index < array_length(names)) {
            let object = objects[names[index]];
            if (map_has(object, "imported")) { object["hex"] = object["imported"]["hex"]; object["qualified_name"] = object["imported"]["qualified_name"]; }
            index = index + 1;
        }
        module_index = module_index + 1;
    }
    return has_objects;
}
fn object_effect_mask(effect) {
    let names = ["observation", "stochastic", "io", "mutation", "task", "external_call"]; let mask = 0; let bit = 1; let index = 0;
    while (index < 6) { let scan = 0; while (scan < array_length(effect[1])) { if (effect[1][scan] == names[index]) { mask = mask + bit; } scan = scan + 1; } bit = bit * 2; index = index + 1; }
    return mask;
}

fn emit_direct_host(context, node) {
    let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
    array_push(context[0], string_concat("HOST_CALL ", node[1], " ", reg(packed[0]), " ", number_to_string(packed[1]), " ", reg(destination))); return destination;
}

fn emit_direct_function(context, node) {
    let packed = emit_contiguous(context, node[2]); let destination = new_register(context);
    emit_generator_call(context, call_target(context, node[1]), packed, destination); return destination;
}

fn portable_parts(path) {
    let parts = array_new(0); let start = 0; let index = 0;
    while (index <= string_length(path)) {
        let split = index == string_length(path);
        if (!split) { split = string_byte_at(path, index) == 47; }
        if (split) { if (index > start) { array_push(parts, string_slice(path, start, index)); } start = index + 1; }
        index = index + 1;
    }
    return parts;
}
fn portable_directory(path) {
    let end = 0; let index = 0;
    while (index < string_length(path)) { if (string_byte_at(path, index) == 47) { end = index; } index = index + 1; }
    if (end == 0) { return "/"; } return string_slice(path, 0, end);
}
fn portable_relative(path, base) {
    let target = portable_parts(path); let root = portable_parts(base); let common = 0;
    let matching = true;
    while (matching) {
        if (common >= array_length(root)) { matching = false; }
        else { if (common >= array_length(target)) { matching = false; }
        else { if (root[common] != target[common]) { matching = false; } else { common = common + 1; } } }
    }
    let parts = array_new(0); let index = common;
    while (index < array_length(root)) { array_push(parts, ".."); index = index + 1; }
    index = common; while (index < array_length(target)) { array_push(parts, target[index]); index = index + 1; }
    return string_join(parts, "/");
}
fn portable_under(path, base) {
    let prefix = string_concat(base, "/");
    if (string_length(path) <= string_length(prefix)) { return false; }
    return string_slice(path, 0, string_length(prefix)) == prefix;
}
fn register_package_module(modules, imported, canonical) {
    if (string_length(imported) < 4) { return null; }
    if (string_slice(imported, 0, 4) != "pkg/") { return null; }
    let parts = portable_parts(imported); let suffix = array_new(0); let index = 3;
    while (index < array_length(parts)) { array_push(suffix, parts[index]); index = index + 1; }
    let length = string_length(string_join(suffix, "/"));
    let base = string_slice(canonical, 0, string_length(canonical) - length - 1);
    modules["package_roots"][base] = string_concat("pkg/", parts[1], "/", parts[2]); return null;
}
fn prepare_portable_modules(modules, root_index) {
    let items = modules["items"]; let base = portable_directory(items[root_index][0]); let prefix = "file";
    let directory = base; let search = true;
    while (search) {
        if (path_exists(string_concat(directory, "/lana.toml"))) { base = directory; prefix = "project"; search = false; }
        else { let parent = portable_directory(directory); if (parent == directory) { search = false; } else { directory = parent; } }
    }
    let standard = ""; if (path_exists(modules["stdlib_dir"])) { standard = path_resolve(modules["stdlib_dir"], ""); }
    let packages = modules["package_roots"]; let roots = map_keys(packages); let ids = map_new(); let index = 0;
    while (index < array_length(items)) {
        let path = items[index][0]; let id = string_concat(prefix, "/", portable_relative(path, base));
        if (standard != "") { if (portable_under(path, standard)) { id = string_concat("std/", portable_relative(path, standard)); } }
        let package = 0; while (package < array_length(roots)) {
            if (portable_under(path, roots[package])) { id = string_concat(packages[roots[package]], "/", portable_relative(path, roots[package])); }
            package = package + 1;
        }
        assert(!map_has(ids, id), "distinct modules have the same portable object identity"); ids[id] = path;
        array_push(items[index], id); index = index + 1;
    }
    return null;
}
