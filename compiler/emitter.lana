    return dest;
}

fn emit_index_get_const(context, arr_reg, index) {
    let idx = new_register(context);
    array_push(context[0], string_concat("LOAD_CONST ", reg(idx), " ", number_to_string(index)));
    return emit_index_get_reg(context, arr_reg, idx);
}

fn emit_for(context, node) {
    let iterable = emit_expression(context, node[2]);
    if (node[4]) {
        let it = new_register(context);
        let r = new_register(context);
        let binding = new_register(context);
        symbol_add(context, node[1], binding, false);
        array_push(context[0], string_concat("MOVE ", reg(it), " ", reg(iterable)));
        array_push(context[0], string_concat("NEXT ", reg(it), " ", reg(r)));
        let start = new_label(context, "for"); let end = new_label(context, "endfor");
        array_push(context[0], string_concat(start, ":"));
        let ok = emit_index_get_const(context, r, 0);
        array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(ok), " ", end));
        let value = emit_index_get_const(context, r, 1);
