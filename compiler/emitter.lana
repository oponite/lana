        array_push(context[0], string_concat("MOVE ", reg(arr), " ", reg(iterable)));
        array_push(context[0], string_concat("LOAD_CONST ", reg(i), " 0"));
        array_push(context[0], string_concat("MOVE ", reg(len_base), " ", reg(arr)));
        array_push(context[0], string_concat("HOST_CALL array_length ", reg(len_base), " 1 ", reg(len)));
        let start = new_label(context, "for"); let end = new_label(context, "endfor");
        array_push(context[0], string_concat(start, ":"));
        let cond = new_register(context);
        array_push(context[0], string_concat("COMPARE ", reg(i), " < ", reg(len), " ", reg(cond)));
        array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(cond), " ", end));
        let value = emit_index_get_reg(context, arr, i);
