import "./syntax.lana" as syntax;

fn emitter_new(namespace, registry, generators, asyncs) { return [array_new(0), map_new(), 0, 0, namespace, map_new(), map_new(), 0, registry, generators, asyncs]; }
fn emit(context, line) { array_push(context[0], line); return null; }
fn reg(number) { return string_concat("R", number_to_string(number)); }

fn sb_new() { return array_new(0); }
fn sb_push(sb, part) { array_push(sb, part); return null; }
fn sb_join(sb) { return string_join(sb, ""); }

fn new_register(context) {
    let value = context[2]; context[2] = value + 1;
    assert(context[2] <= 256,
           string_concat("function ", context[4], " requires more than 256 registers"));
    return value;
}

fn new_label(context, kind) {
    context[3] = context[3] + 1;
    return string_concat("__", context[4], "_", kind, "_", number_to_string(context[3]));
}

fn symbol_add(context, name, register, information) {
    map_set(context[1], name, register);
    map_set(context[5], name, information);
    if (register + 1 > context[7]) { context[7] = register + 1; }
    return register;
}

fn symbol_is_information(context, name) {
    if (!map_has(context[5], name)) { return false; }
    return map_get(context[5], name);
}

fn expression_is_information(context, node) {
    if (node[0] == 21) { return symbol_is_information(context, node[1]); }
    if (node[0] == 22) { if (expression_is_information(context, node[2])) { return true; } return expression_is_information(context, node[3]); }
    if (node[0] == 23) { return expression_is_information(context, node[2]); }
    if (node[0] == 25) {
        let index = 0; while (index < array_length(node[1])) { if (expression_is_information(context, node[1][index])) { return true; } index = index + 1; }
    }
    if (node[0] == 26) { return expression_is_information(context, node[1]); }
    if (node[0] == 27) { return expression_is_information(context, node[1]); }
    if (node[0] == 28) {
        let index = 0; while (index < array_length(node[1])) { if (expression_is_information(context, node[1][index][1])) { return true; } index = index + 1; }
    }
    if (node[0] == 29) { return true; } if (node[0] == 30) { return true; } if (node[0] == 38) { return true; }
    if (node[0] == 31) {
        if (node[1] == "append") { return false; } if (node[1] == "append_redundant") { return false; }
        if (node[1] == "append_full_redundancy") { return false; } if (node[1] == "append_complementary") { return false; }
        if (node[1] == "sample") { return false; }
        if (node[1] == "resolve") { return false; } return true;
    }
    return false;
}

fn field_find(fields, name) {
    let index = 0; while (index < array_length(fields)) { if (fields[index][0] == name) { return fields[index][1]; } index = index + 1; }
    return null;
}

fn replace_commas(text) {
    let pieces = array_new(0); let index = 0;
    while (index < string_length(text)) {
        if (string_byte_at(text, index) == 44) { array_push(pieces, ";"); }
        else { array_push(pieces, string_slice(text, index, index + 1)); }
        index = index + 1;
    }
    return string_join(pieces, "");
}

fn symbol_find(context, name) {
    assert(map_has(context[1], name), string_concat("unknown name ", name));
    return map_get(context[1], name);
}

fn call_target(context, name) {
    if (map_has(context[6], name)) { return map_get(context[6], name); }
    return name;
}

