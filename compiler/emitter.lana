fn emit_comprehension(context, node) {
    let kind = node[1];
    let iterable = emit_expression(context, node[6]);
    let result = new_register(context);
    if (kind == "list") {
        array_push(context[0], string_concat("ARRAY_NEW ", reg(result), " ", reg(context[2]), " 0"));
    }
    if (kind == "set") {
        array_push(context[0], string_concat("HOST_CALL set_new ", reg(result), " 0 ", reg(result)));
    }
    if (kind == "map") {
        array_push(context[0], string_concat("HOST_CALL map_new ", reg(result), " 0 ", reg(result)));
    }
    let state = emit_iter_prologue(context, iterable, node[10], "comp");
    let element_reg = state[4];
