    emit_statements(context, node[2]); array_push(context[0], string_concat("JUMP ", end)); array_push(context[0], string_concat(otherwise, ":"));
    emit_statements(context, node[3]); array_push(context[0], string_concat(end, ":")); if (uncertain) { array_push(context[0], "PATH_JOIN"); }
    let keys = map_keys(node[5]); let index = 0;
    while (index < array_length(keys)) {
        map_set(context[5], keys[index], map_get(node[5], keys[index])[0] == "information");
        index = index + 1;
    }
    return null;
}

fn emit_while(context, node) {
    let start = new_label(context, "while"); let end = new_label(context, "endwhile");
    assert(!expression_is_information(context, node[1]), "unresolved loop guards require a bounded execution form");
    array_push(context[0], string_concat(start, ":")); let predicate = emit_expression(context, node[1]);
    array_push(context[0], string_concat("JUMP_IF_FALSE ", reg(predicate), " ", end)); emit_statements(context, node[2]);
    array_push(context[0], string_concat("JUMP ", start)); array_push(context[0], string_concat(end, ":")); return null;
}

fn emit_index_get_reg(context, arr_reg, idx_reg) {
    let base = new_register(context);
    array_push(context[0], string_concat("MOVE ", reg(base), " ", reg(arr_reg)));
    let idx = new_register(context);
