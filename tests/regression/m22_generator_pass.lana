fn count(n) {
    let i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

let it = count(3);
let r1 = next(it);
let r2 = next(it);
let r3 = next(it);
let r4 = next(it);
assert(result_is_ok(r1), "first next was not ok");
assert(result_value(r1) == 0, "first yield was not 0");
assert(result_value(r2) == 1, "second yield was not 1");
assert(result_value(r3) == 2, "third yield was not 2");
assert(!result_is_ok(r4), "exhausted generator did not return error");
assert(result_error_value(r4) == "exhausted", "exhausted error was not 'exhausted'");
print("M22_GENERATOR_PASS");
