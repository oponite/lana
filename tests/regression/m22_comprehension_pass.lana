import "../../stdlib/collections.lana" as collections;

let xs = array_new(0);
array_push(xs, 1);
array_push(xs, 2);
array_push(xs, 3);

let doubled = [x * 2 for x in xs];
assert(doubled[0] == 2, "list 0");
assert(doubled[1] == 4, "list 1");
assert(doubled[2] == 6, "list 2");

let big = [x for x in xs if x > 1];
assert(array_length(big) == 2, "filter length");
assert(big[0] == 2, "filter 0");
assert(big[1] == 3, "filter 1");

let s = {x for x in xs};
assert(collections.set_contains(s, 1) == true, "set 1");
assert(collections.set_contains(s, 2) == true, "set 2");
assert(collections.set_contains(s, 3) == true, "set 3");
assert(collections.set_contains(s, 4) == false, "set no 4");

let m = {number_to_string(i): x for i, x in collections.enumerate(xs)};
assert(map_get(m, "0") == 1, "map 0");
assert(map_get(m, "1") == 2, "map 1");
assert(map_get(m, "2") == 3, "map 2");

print("M22_COMPREHENSION_PASS");
