import "std/core" as info;

let copy = joint correlated (t, x, y) with support:
    [[0, 0, 0, 0.25], [1, 0, 1, 0.25],
     [2, 1, 0, 0.25], [3, 1, 1, 0.25]];
let result = info.broja(copy, "t", "x", "y");
assert(result.status == "converged", "copy certificate");
assert(result.error_bound_bits <= 0.000001, "copy bound");
assert(result.shared == 0, "copy shared");
assert(result.unique_x == 1, "copy unique x");
assert(result.unique_y == 1, "copy unique y");
assert(result.synergy == 0, "copy synergy");
assert(result.total == 2, "copy total");
print("CORE_BROJA_COPY_PASS");
