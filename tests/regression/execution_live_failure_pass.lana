import "std/execution" as execution;

store_open("build/execution-live-failure-store");
let plan = execution.plan_webhook("/fail", {event: "rejected"});
let decision = policy_evaluate(
    {policy_id: "execution-test", rule_kind: 0, rule_field: "approved", rule_threshold: 0.5, rule_effect: "webhook"},
    {approved: 1},
    {decision_id: 43, target: "webhook", scope: "test", input_revision: 0, evaluation_time: 0, reason: "test"}
);
let capability = execution.capability();
let authorization = execution.authorize(capability, decision, plan);
let receipt = execution.execute(capability, authorization, plan);
assert(receipt.status == "Failed", "received non-2xx fails");
print("EXECUTION_FAILURE_PASS");
