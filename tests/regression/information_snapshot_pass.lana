import "std/core" as info;
let source = information(possibility([1, 2, 3]));
let narrowed = observe(source, possibility([1, 2]));
let saved = snapshot(source);
let before = inspect_information(saved);
assert(before.revision == inspect_information(source).revision, "snapshot retains captured revision");
assert(before.form == "possibility", "snapshot preserves form");
assert(before.remaining_alternatives == 2, "snapshot captures current law");
let definite = observe(source, 2);
assert(inspect_information(saved).remaining_alternatives == 2, "snapshot detached from live observations");
assert(inspect_information(saved).revision == before.revision, "snapshot revision stays fixed");
assert(resolve(source) == 2, "source still observes");
let weighted = info.distribution([[1, 0.25], [2, 0.75]]);
let captured = snapshot(weighted);
assert(inspect_information(captured).form == "distribution", "weighted snapshot form");
assert(map_get(inspect_information(captured).support[0], "weight") == 0.25, "weights retained");
let total = captured + captured;
assert(inspect_information(total).support[0].value == 2, "snapshot keeps shared alternatives aligned");
assert(inspect_information(total).support[1].value == 4, "snapshot does not invent independence");
let fields = {x: [1, 2]};
let immutable = snapshot(fields);
fields.x[0] = 9;
assert(immutable.x[0] == 1, "nested containers copied");
assert(resolve(snapshot(information(7))) == 7, "definite snapshot");
print("INFORMATION_SNAPSHOT_PASS");
