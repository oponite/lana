import "std/decision" as decision;

fn prior() {
    return [
        {state: "s1", probability: 0.5},
        {state: "s2", probability: 0.5}
    ];
}

fn utility_table() {
    return [
        {action: "a", state: "s1", value: 10},
        {action: "a", state: "s2", value: 0},
        {action: "b", state: "s1", value: 0},
        {action: "b", state: "s2", value: 10}
    ];
}

fn candidate_table() {
    return [
        {name: "perfect-1", joint: [
            {state: "s1", outcome: "left", probability: 0.5},
            {state: "s2", outcome: "right", probability: 0.5}
        ]},
        {name: "negative", joint: [
            {state: "s1", outcome: "same", probability: 0.5},
            {state: "s2", outcome: "same", probability: 0.5}
        ]},
        {name: "perfect-2", joint: [
            {state: "s1", outcome: "left", probability: 0.5},
            {state: "s2", outcome: "right", probability: 0.5}
        ]},
        {name: "zero-outcome", joint: [
            {state: "s1", outcome: "possible", probability: 0.5},
            {state: "s2", outcome: "possible", probability: 0.5},
            {state: "s1", outcome: "never", probability: 0},
            {state: "s2", outcome: "never", probability: 0}
        ]},
        {name: "unknown", joint: null},
        {name: "impossible", joint: []}
    ];
}

fn cost_table() {
    return [
        {observation: "perfect-1", value: 1},
        {observation: "negative", value: 1},
        {observation: "perfect-2", value: 1},
        {observation: "zero-outcome", value: 0},
        {observation: "unknown", value: 2},
        {observation: "impossible", value: 3}
    ];
}

fn check_ranking(plan) {
    assert(plan.baseline.expected_utility == 5, "baseline utility");
    assert(array_length(plan.baseline.actions) == 2, "baseline action tie");
    assert(plan.candidates[0].observation == "perfect-1", "first ranked observation");
    assert(plan.candidates[1].observation == "perfect-2", "stable tied observation");
    assert(plan.candidates[0].rank == 1, "first rank");
    assert(plan.candidates[1].rank == 1, "tied rank");
    assert(plan.candidates[0].expected_value == 5, "gross value");
    assert(plan.candidates[0].net_value == 4, "net value");
    assert(array_length(plan.candidates[0].policy) == 2, "outcome policy");
    assert(plan.candidates[2].observation == "zero-outcome", "zero-value observation rank");
    assert(plan.candidates[2].net_value == 0, "zero net value");
    assert(plan.candidates[2].impossible_outcomes[0] == "never", "impossible outcome retained");
    assert(plan.candidates[3].observation == "negative", "negative observation retained");
    assert(plan.candidates[3].net_value == -1, "negative net value");
    return null;
}

fn check_unscorable(plan) {
    assert(plan.candidates[4].status == "unknown_relationship", "unknown relationship retained");
    assert(plan.candidates[4].rank == null, "unknown relationship unranked");
    assert(plan.candidates[5].status == "impossible_observation", "impossible observation retained");
    assert(array_length(plan.recommended) == 2, "tied recommendations retained");
    assert(plan.recommended[0] == "perfect-1", "first recommendation");
    assert(plan.recommended[1] == "perfect-2", "second recommendation");
    assert(plan.exactness == "unknown", "mixed plan exactness");
    assert(map_has(derivation(plan), "id"), "plan provenance missing");
    return null;
}

fn check_negative() {
    let negative_only = decision.value_of_information(
    prior(),
    [{name: "negative", joint: [
        {state: "s1", outcome: "same", probability: 0.5},
        {state: "s2", outcome: "same", probability: 0.5}
    ]}],
    ["a", "b"],
    utility_table(),
    [{observation: "negative", value: 1}]
    );
    assert(array_length(negative_only.recommended) == 0, "negative VOI must not be recommended");
    return null;
}

let plan = decision.value_of_information(prior(), candidate_table(), ["a", "b"], utility_table(), cost_table());
check_ranking(plan);
check_unscorable(plan);
check_negative();
print(json_stringify(plan));
print("DECISION_VOI_PASS");
