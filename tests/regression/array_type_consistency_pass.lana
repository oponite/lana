fn values() { return [1, 2, 3]; }
let xs = [1, 2, 3];
xs = [4, 5];
let total = 0;
for x in xs { total = total + x; }
assert(total == 9, "literal iteration and reassignment");
let doubled = [x * 2 for x in [1, 2, 3]];
assert(doubled[2] == 6, "literal comprehension");
let nested = [[1, 2], [3, 4]];
nested = [[5, 6]];
assert(nested[0][1] == 6, "recursive array compatibility");
total = 0;
for x in values() { total = total + x; }
assert(total == 6, "function result iteration");
let dynamic = array_new(0);
array_push(dynamic, 7);
xs = dynamic;
assert(xs[0] == 7, "constructor and literal compatibility");
print("ARRAY_TYPE_CONSISTENCY_PASS");
