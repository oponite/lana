let path = args()[0];
store_open(path);
dataset_source("s");
let before = store_current_revision();
let add = [{"op": "add", "id": "r", "row": {"v": 1}}];
let added = dataset_apply("s", before, "add-r", add);
assert(added == before + 1, "add commits one source revision");
assert(dataset_apply("s", before, "add-r", add) == added, "identical retry returns prior revision");
assert(store_current_revision() == added, "retry does not commit");
let source = store_get("dataset/source/73");
assert(source.row_ids[0] == "r", "source row ID is separate from the payload");
let corrected = dataset_apply("s", added, "correct-r", [{"op": "correct", "id": "r", "row": {"v": 3}}]);
assert(corrected == added + 1, "correction commits one revision");
source = store_get("dataset/source/73");
assert(source.row_ids[0] == "r", "correction keeps row position");
let deleted = dataset_apply("s", corrected, "delete-r", [{"op": "delete", "id": "r"}]);
assert(deleted == corrected + 1, "deletion commits one revision");
source = store_get("dataset/source/73");
assert(array_length(source.row_ids) == 0, "deletion removes row ID");
print("DATASET_APPLY_PASS");
