import "std/evaluation" as evaluation;

fn fit_rows(training, validation, seed) {
    return {calculation_version: "v1", payload: seed};
}

fn predict_row(model, features) {
    return {value: 0};
}

let rows = array_new(0);
let index = 0;
while (index < 22) {
    array_push(rows, {id: string_concat("r", number_to_string(index)),
        observed_at: index, target_at: index,
        features: {x: {value: index, available_at: index}}, target: index});
    index = index + 1;
}
let report = evaluation.walk_forward(rows, {fit: fit_rows, predict: predict_row,
    kind: "regression", labels: [], calculation_version: "v1"},
    {initial_train: 20, test_size: 2, step_size: 2, gap: 0, seed: 0});
assert(report.status == "insufficient_evidence", "no training row after validation");
assert(report.aggregate == null, "no score");
print("EVALUATION_INSUFFICIENT_PASS");
