import "std/execution" as execution;

store_open("build/execution-live-success-store");
let plan = execution.plan_webhook("/ok", {event: "approved"});
let decision = policy_evaluate(
    {policy_id: "execution-test", rule_kind: 0, rule_field: "approved", rule_threshold: 0.5, rule_effect: "webhook"},
    {approved: 1},
    {decision_id: 42, target: "webhook", scope: "test", input_revision: 0, evaluation_time: 0, reason: "test"}
);
let capability = execution.capability();
let authorization = execution.authorize(capability, decision, plan);
let receipt = execution.execute(capability, authorization, plan);
assert(receipt.record_schema == 1, "receipt schema");
assert(receipt.kind == "execution_receipt", "receipt kind");
assert(receipt.status == "Succeeded", "2xx succeeds");
print("EXECUTION_SUCCESS_PASS");
