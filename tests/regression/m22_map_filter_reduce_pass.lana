import "../../stdlib/collections.lana" as collections;

fn double(x) { return x * 2; }
fn greater_than_one(x) { return x > 1; }
fn add(a, b) { return a + b; }

let xs = array_new(0);
array_push(xs, 1);
array_push(xs, 2);
array_push(xs, 3);

let doubled = map(double, xs);
assert(doubled[0] == 2, "map 0");
assert(doubled[1] == 4, "map 1");
assert(doubled[2] == 6, "map 2");

let big = filter(greater_than_one, xs);
assert(array_length(big) == 2, "filter length");
assert(big[0] == 2, "filter 0");
assert(big[1] == 3, "filter 1");

let total = reduce(add, xs, 0);
assert(total == 6, "reduce sum");

let doubled_gen = map(double, collections.iter(xs));
assert(doubled_gen[0] == 2, "map gen 0");
assert(doubled_gen[1] == 4, "map gen 1");
assert(doubled_gen[2] == 6, "map gen 2");

let total_gen = reduce(add, collections.iter(xs), 0);
assert(total_gen == 6, "reduce gen sum");

print("M22_MAP_FILTER_REDUCE_PASS");
