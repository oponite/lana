import "std/core" as info;

let source = information(possibility([1, 2, 3]));
let subset = condition(source, possibility([2, 3]));
assert(inspect_information(subset).form == "possibility", "condition form");
assert(inspect_information(subset).remaining_alternatives == 2, "subset support");
assert(inspect_information(source).remaining_alternatives == 3, "condition changed source");

let observed = observe(source, possibility([1, 3]));
assert(inspect_information(observed).revision == 1, "observation revision");
assert(inspect_information(source).remaining_alternatives == 2, "observation support");
assert(resolve(condition(source, 3)) == 3, "singleton resolution");

let weighted = info.distribution([[1, 0.25], [2, 0.75]]);
let narrowed = condition(weighted, 2);
let snapshot = inspect_information(narrowed);
assert(snapshot.form == "distribution", "distribution form");
assert(array_length(snapshot.support) == 1, "weighted support");
assert(sample_value(sample(narrowed)) == 2, "weighted sample");
assert(resolve(narrowed) == 2, "weighted singleton resolution");
print("CORE_REFINEMENT_FINITE_PASS");
