import "std/core" as info;

fn chances(input) {
    if (input[0] == 0) { return [[0, 1], [1, 0]]; }
    return [[0, 0.25], [1, 0.75]];
}

let kernel = info.kernel([[0, 1]], [0, 1], chances);
assert(type_of(kernel) == "kernel", "kernel type");
let identity = info.identity_kernel([0, 1]);
assert(type_of(info.compose_kernels(identity, kernel)) == "kernel", "kernel composition");
print("CORE_KERNEL_PASS");
