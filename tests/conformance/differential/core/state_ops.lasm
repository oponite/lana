.function main 0 16
STATE_NEW R0 0.4 0.2 0.0
GET_FIELD R0 p R1
PRINT R1
GET_FIELD R0 d R2
PRINT R2
GET_FIELD R0 d_im R3
PRINT R3
STATE_NEW R4 0.8 -0.1 0.0
LOAD_CONST R6 0.5
MIX R5 R0 R4 R6
PRINT R5
GET_FIELD R5 p R7
PRINT R7
GET_FIELD R5 d R8
PRINT R8
LOAD_CONST R9 0.3
LOAD_CONST R10 0.1
LOAD_CONST R11 0.0
STATE_BUILD R9 R10 R11 R12
PRINT R12
RETURN R0
