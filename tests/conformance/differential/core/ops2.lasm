.function main 0 16
STATE_NEW R0 0.4 0.2 0.0
STATE_NEW R1 0.8 -0.1 0.0
LOAD_CONST R2 0.5
ATTENUATE R3 R0 R2
PRINT R3
TRACE_DISTANCE R4 R0 R1
PRINT R4
APPEND_REDUNDANT R0 R1 R5 R2
MEASURE R5 probability R6
PRINT R6
APPEND_COMPLEMENTARY R0 R1 R7 R2
MEASURE R7 probability R8
PRINT R8
STATE_NEW R9 0.5 0.0 0.0
STATE_NEW R10 0.5 0.0 0.0
APPEND_FULL_REDUNDANCY R9 R10 R11
MEASURE R11 probability R12
PRINT R12
RETURN R0
