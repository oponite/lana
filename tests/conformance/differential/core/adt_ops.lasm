.function main 0 16
LOAD_CONST R0 5
ADT_BUILD R1 R0 1 0
ADT_CASE R1 0 some
JUMP end
some:
ADT_GET R2 R1 0
PRINT R2
end:
LOAD_CONST R3 7
ADT_BUILD R4 R3 0 1
ADT_CASE R4 1 none
JUMP end2
none:
PRINT R3
end2:
LOAD_CONST R5 9
ADT_BUILD R6 R5 0 4294967295
ADT_CASE R6 4294967295 unknown
JUMP end3
unknown:
PRINT R5
end3:
RETURN R0
