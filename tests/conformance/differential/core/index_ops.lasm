.function main 0 16
STATE_NEW R0 0.4 0.2 0.0
LOAD_CONST R1 100
SET_INDEX R0 timestamp R1
GET_INDEX R0 timestamp R2
PRINT R2
LOAD_CONST R3 sensor
SET_INDEX R0 source R3
GET_INDEX R0 source R4
PRINT R4
LOAD_CONST R5 0.7
SET_INDEX R0 weight R5
GET_INDEX R0 weight R6
PRINT R6
LOAD_CONST R7 0.9
SET_INDEX R0 confidence R7
GET_INDEX R0 confidence R8
PRINT R8
RETURN R0
