.function main 0 16
LOAD_CONST R0 5
LAZY R1 gen R0
HOST_CALL dataset R1 1 R2
LOAD_FUNCTION R3 is_gt1
HOST_CALL dataset_filter R2 2 R4
LOAD_FUNCTION R5 times10
HOST_CALL dataset_map R4 2 R6
HOST_CALL dataset_materialize R6 1 R7
PRINT R7
HOST_CALL dataset_materialize R4 1 R8
PRINT R8
LOAD_CONST R5 2
HOST_CALL dataset_limit R4 2 R10
HOST_CALL dataset_materialize R10 1 R11
PRINT R11
HOST_CALL dataset_explain R4 1 R12
PRINT R12
RETURN R0
.function gen 1 3
RETURN R0
.function is_gt1 1 3
LOAD_CONST R1 1
COMPARE R0 > R1 R2
RETURN R2
.function times10 1 3
LOAD_CONST R1 10
BINARY R0 mul R1 R2
RETURN R2
