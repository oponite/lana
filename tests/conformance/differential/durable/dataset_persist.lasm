.function main 0 16
LOAD_CONST R0 store.db
HOST_CALL store_open R0 1 R1
LOAD_CONST R2 x
LOAD_CONST R3 10
LOAD_CONST R4 g
LOAD_CONST R5 1
HOST_CALL map_new R2 4 R6
LOAD_CONST R7 x
LOAD_CONST R8 20
LOAD_CONST R9 g
LOAD_CONST R10 2
HOST_CALL map_new R7 4 R11
MOVE R7 R11
ARRAY_NEW R12 R6 2
HOST_CALL dataset R12 1 R13
HOST_CALL dataset_materialize R13 1 R14
PRINT R14
LOAD_CONST R15 rows
MOVE R16 R14
HOST_CALL store_put R15 2 R17
HOST_CALL store_commit R17 0 R18
PRINT R18
HOST_CALL store_get R15 1 R19
PRINT R19
HOST_CALL dataset R19 1 R20
HOST_CALL dataset_materialize R20 1 R21
PRINT R21
RETURN R0
