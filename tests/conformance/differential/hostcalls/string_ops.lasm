.function main 0 16
LOAD_CONST R0 hello
HOST_CALL string_length R0 1 R1
PRINT R1
LOAD_CONST R2 hello
LOAD_CONST R3 1
HOST_CALL string_byte_at R2 2 R4
PRINT R4
LOAD_CONST R5 hello
LOAD_CONST R6 1
LOAD_CONST R7 3
HOST_CALL string_slice R5 3 R8
PRINT R8
LOAD_CONST R9 foo
LOAD_CONST R10 bar
HOST_CALL string_concat R9 2 R11
PRINT R11
LOAD_CONST R12 3.5
HOST_CALL number_to_string R12 1 R13
PRINT R13
LOAD_CONST R14 hello
HOST_CALL string_hex R14 1 R15
PRINT R15
RETURN R0
