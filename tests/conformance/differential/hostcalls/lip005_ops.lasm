.function main 0 16
# rho = I/2 = [[0.5, 0], [0, 0.5]] (maximally mixed 1-qubit state).
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 0.5
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0.5
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R10
HOST_CALL density_operator R10 1 R10
# sigma = |0><0| = [[1, 0], [0, 0]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R11
HOST_CALL density_operator R11 1 R11
# Z = [[1, 0], [0, -1]] (Pauli Z observable).
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 -1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R12
HOST_CALL observable R12 1 R12
# E0 = [[1, 0], [0, 0]] and E1 = [[0, 0], [0, 1]] (computational POVM).
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R13
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R14
# I = [[1, 0], [0, 1]] (identity channel Kraus operator).
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R15
# tensor_product(rho, rho) = I/4 (2-qubit maximally mixed).
MOVE R1 R10
MOVE R2 R10
HOST_CALL tensor_product R1 2 R3
PRINT R3
# partial_trace(rho ⊗ rho, 1) = rho.
MOVE R1 R3
LOAD_CONST R2 1
HOST_CALL partial_trace R1 2 R4
PRINT R4
# is_separable(rho ⊗ rho, 1) = "separable" (product state).
MOVE R1 R3
LOAD_CONST R2 1
HOST_CALL is_separable R1 2 R4
PRINT R4
# measure_with(rho, povm) = [0.5, 0.5].
LOAD_CONST R1 0
HOST_CALL array_new R1 1 R2
MOVE R3 R13
HOST_CALL array_push R2 2 R2
MOVE R3 R14
HOST_CALL array_push R2 2 R2
HOST_CALL povm R2 1 R3
MOVE R1 R10
MOVE R2 R3
HOST_CALL measure_with R1 2 R4
PRINT R4
# apply_to(identity channel, rho) = rho.
LOAD_CONST R1 0
HOST_CALL array_new R1 1 R2
MOVE R3 R15
HOST_CALL array_push R2 2 R2
HOST_CALL channel R2 1 R3
MOVE R1 R3
MOVE R2 R10
HOST_CALL apply_to R1 2 R4
PRINT R4
# expect(rho, Z) = 0.
MOVE R1 R10
MOVE R2 R12
HOST_CALL expect R1 2 R3
PRINT R3
# mix(rho, sigma, 0.5) = [[0.75, 0], [0, 0.25]].
MOVE R1 R10
MOVE R2 R11
LOAD_CONST R3 0.5
HOST_CALL mix R1 3 R4
PRINT R4
# trace_distance(rho, sigma) = 0.5.
MOVE R1 R10
MOVE R2 R11
HOST_CALL trace_distance R1 2 R3
PRINT R3
RETURN R0
