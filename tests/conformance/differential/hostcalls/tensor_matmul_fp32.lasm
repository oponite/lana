# fp32 accumulator discriminator: [[16777216, 1]] . [[1],[1]] = 16777216
# (2^24 + 1 rounds to 2^24 in binary32; fp64 would give 16777217)
LOAD_CONST R0 0
HOST_CALL array_new R0 1 R1
LOAD_CONST R2 16777216
HOST_CALL array_push R1 2 R1
LOAD_CONST R2 1
HOST_CALL array_push R1 2 R1
LOAD_STRING R2 663332
HOST_CALL tensor R1 2 R8
HOST_CALL array_new R0 1 R1
LOAD_CONST R2 1
