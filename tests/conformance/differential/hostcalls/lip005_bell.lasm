.function main 0 16
# Bell state |Phi+> = (|00> + |11>)/sqrt(2): a 2-qubit entangled state.
# rho = [[0.5, 0, 0, 0.5], [0, 0, 0, 0], [0, 0, 0, 0], [0.5, 0, 0, 0.5]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 0.5
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0.5
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
LOAD_CONST R9 0
HOST_CALL array_push R8 2 R8
LOAD_CONST R9 0
HOST_CALL array_push R8 2 R8
LOAD_CONST R9 0
HOST_CALL array_push R8 2 R8
LOAD_CONST R9 0
HOST_CALL array_push R8 2 R8
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R10
LOAD_CONST R11 0.5
HOST_CALL array_push R10 2 R10
LOAD_CONST R11 0
HOST_CALL array_push R10 2 R10
LOAD_CONST R11 0
HOST_CALL array_push R10 2 R10
LOAD_CONST R11 0.5
HOST_CALL array_push R10 2 R10
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R12
MOVE R13 R4
HOST_CALL array_push R12 2 R12
MOVE R13 R6
HOST_CALL array_push R12 2 R12
MOVE R13 R8
HOST_CALL array_push R12 2 R12
MOVE R13 R10
HOST_CALL array_push R12 2 R12
HOST_CALL tensor R12 1 R14
HOST_CALL density_operator R14 1 R14
# is_separable(Bell, 1) = "entangled" (PPT criterion finds a negative eigenvalue).
MOVE R1 R14
LOAD_CONST R2 1
HOST_CALL is_separable R1 2 R3
PRINT R3
RETURN R0
