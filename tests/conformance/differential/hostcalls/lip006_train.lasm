.version 3
.function main 0 48
# capability("train") -> admin token, then grant "use" -> read token
LOAD_CONST R0 train
HOST_CALL shared_information R0 1 R1
LOAD_CONST R2 use
HOST_CALL grant R1 2 R3
# s = sgd(0.1, 0.0)
LOAD_CONST R4 0.1
LOAD_CONST R5 0.0
HOST_CALL sgd R4 2 R6
PRINT R6
# a = adam(0.001, 0.9, 0.999, 0.00000001)
LOAD_CONST R7 0.001
LOAD_CONST R8 0.9
LOAD_CONST R9 0.999
LOAD_CONST R10 0.00000001
HOST_CALL adam R7 4 R11
PRINT R11
# x = tensor([1.0])
LOAD_CONST R12 0
HOST_CALL array_new R12 1 R13
LOAD_CONST R14 1.0
HOST_CALL array_push R13 2 R13
HOST_CALL tensor R13 1 R15
# target = tensor([2.0])
LOAD_CONST R16 0
HOST_CALL array_new R16 1 R17
LOAD_CONST R18 2.0
HOST_CALL array_push R17 2 R17
HOST_CALL tensor R17 1 R19
# pair = [x, target]
LOAD_CONST R20 0
HOST_CALL array_new R20 1 R21
MOVE R22 R15
HOST_CALL array_push R21 2 R21
MOVE R22 R19
HOST_CALL array_push R21 2 R21
# data = [pair]
LOAD_CONST R23 0
HOST_CALL array_new R23 1 R24
MOVE R25 R21
HOST_CALL array_push R24 2 R24
# init = tensor([0.0])
LOAD_CONST R26 0
HOST_CALL array_new R26 1 R27
LOAD_CONST R28 0.0
HOST_CALL array_push R27 2 R27
HOST_CALL tensor R27 1 R29
# r = train(model, data, loss, s, init, 1, 1)
LOAD_FUNCTION R30 model
LOAD_FUNCTION R31 loss
LOAD_CONST R32 1
LOAD_CONST R33 1
MOVE R34 R30
MOVE R35 R24
MOVE R36 R31
MOVE R37 R6
MOVE R38 R29
MOVE R39 R32
MOVE R40 R33
HOST_CALL train R34 7 R41
# print r.params[0]
GET_FIELD R41 params R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
PRINT R44
# print r.steps[0].parameters[0]
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 parameters
HOST_CALL map_get R44 2 R46
LOAD_CONST R47 0
HOST_CALL index_get R46 2 R48
PRINT R48
# print r.steps[0].gradient[0]
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 gradient
HOST_CALL map_get R44 2 R46
LOAD_CONST R47 0
HOST_CALL index_get R46 2 R48
PRINT R48
# print r.steps[0].epoch
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 epoch
HOST_CALL map_get R44 2 R46
PRINT R46
# print r.steps[0].batch
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 batch
HOST_CALL map_get R44 2 R46
PRINT R46
# ar = train(model, data, loss, a, init, 1, 1)
LOAD_FUNCTION R30 model
LOAD_FUNCTION R31 loss
LOAD_CONST R32 1
LOAD_CONST R33 1
MOVE R34 R30
MOVE R35 R24
MOVE R36 R31
MOVE R37 R11
MOVE R38 R29
MOVE R39 R32
MOVE R40 R33
HOST_CALL train R34 7 R41
# print ar.params[0]
GET_FIELD R41 params R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
PRINT R44
# print ar.steps[0].optimizer_state.t
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 optimizer_state
HOST_CALL map_get R44 2 R46
LOAD_CONST R47 t
HOST_CALL map_get R46 2 R48
PRINT R48
# print ar.steps[0].optimizer_state.m[0]
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 optimizer_state
HOST_CALL map_get R44 2 R46
LOAD_CONST R47 m
HOST_CALL map_get R46 2 R48
LOAD_CONST R49 0
HOST_CALL index_get R48 2 R50
PRINT R50
# print ar.steps[0].optimizer_state.v[0]
GET_FIELD R41 steps R42
LOAD_CONST R43 0
HOST_CALL index_get R42 2 R44
LOAD_CONST R45 optimizer_state
HOST_CALL map_get R44 2 R46
LOAD_CONST R47 v
HOST_CALL map_get R46 2 R48
LOAD_CONST R49 0
HOST_CALL index_get R48 2 R50
PRINT R50
HALT
.function model 2 4
BINARY R0 mul R1 R2
RETURN R2
.function loss 2 8
BINARY R0 sub R1 R2
BINARY R0 sub R1 R3
BINARY R2 mul R3 R4
MOVE R5 R4
HOST_CALL tensor_sum R5 1 R6
RETURN R6
