.function main 0 16
# povm: computational-basis measurement {|0><0|, |1><1|}.
# E0 = [[1, 0], [0, 0]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R10
# E1 = [[0, 0], [0, 1]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R11
# povm([E0, E1]).
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R12
MOVE R13 R10
HOST_CALL array_push R12 2 R12
MOVE R13 R11
HOST_CALL array_push R12 2 R12
HOST_CALL povm R12 1 R14
PRINT R14
# channel: identity channel with a single Kraus operator I = [[1, 0], [0, 1]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R10
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R12
MOVE R13 R10
HOST_CALL array_push R12 2 R12
HOST_CALL channel R12 1 R14
PRINT R14
# observable: Pauli Z = [[1, 0], [0, -1]].
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R4
LOAD_CONST R5 1
HOST_CALL array_push R4 2 R4
LOAD_CONST R5 0
HOST_CALL array_push R4 2 R4
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R6
LOAD_CONST R7 0
HOST_CALL array_push R6 2 R6
LOAD_CONST R7 -1
HOST_CALL array_push R6 2 R6
LOAD_CONST R3 0
HOST_CALL array_new R3 1 R8
MOVE R9 R4
HOST_CALL array_push R8 2 R8
MOVE R9 R6
HOST_CALL array_push R8 2 R8
HOST_CALL tensor R8 1 R10
HOST_CALL observable R10 1 R14
PRINT R14
RETURN R0
