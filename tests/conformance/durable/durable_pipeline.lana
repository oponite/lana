// Durable-pipeline host-call fixture: exercises the store, policy engine, and
// event ledger end-to-end on the Rust VM. These host calls are Rust-only (the
// C11 VM is frozen at 52 host calls), so this fixture is not part of the
// differential conformance suite.

let path = "/tmp/lana_durable_pipeline";
store_open(path);
store_put("answer", 42);
store_commit();
let answer = store_get("answer");
assert(answer == 42, "store roundtrip");

let policy = map_new();
map_set(policy, "policy_id", "p1");
map_set(policy, "rule_kind", 0);
map_set(policy, "rule_field", "p");
map_set(policy, "rule_threshold", 0.5);
map_set(policy, "rule_effect", "grant");

let input = map_new();
map_set(input, "p", 0.75);

let evaluation = map_new();
map_set(evaluation, "decision_id", 1);
map_set(evaluation, "target", "t");
map_set(evaluation, "scope", "s");
map_set(evaluation, "input_revision", 0);
map_set(evaluation, "evaluation_time", 0);
map_set(evaluation, "reason", "r");

let decision = policy_evaluate(policy, input, evaluation);
assert(map_get(decision, "outcome") == 0, "policy authorizes");

let event = map_new();
map_set(event, "entity", "e1");
map_set(event, "actor", "a1");
map_set(event, "action", "grant");
map_set(event, "reason", "approved");
map_set(event, "timestamp", 100);
map_set(event, "correction_of", 0);

let stored = ledger_append(event);
assert(map_get(stored, "entity") == "e1", "ledger append");

let query = map_new();
map_set(query, "entity", "e1");
map_set(query, "start_timestamp", 0);
map_set(query, "end_timestamp", 0);

let events = ledger_query(query);
assert(array_length(events) == 1, "ledger query");
