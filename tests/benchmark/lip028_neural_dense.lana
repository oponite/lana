import "std/ml" as ml;
import "std/datetime" as datetime;
let x = cast(ones([96, 24]), "f32"); let y = cast(ones([96]), "f32");
let admin = capability("gpu"); let token = grant(admin, "use");
fn elapsed(device_name, x, y, token) { let start = datetime.now(); let fitted = ml.fit("neural_dense", {x: x, y: y}, {device: device_name, gpu_token: token, epochs: 3, hidden: 16}); assert(fitted[0], "neural benchmark"); return datetime.now() - start; }
elapsed("cpu", x, y, token); elapsed("metal", x, y, token);
print({cpu: [elapsed("cpu", x, y, token), elapsed("cpu", x, y, token), elapsed("cpu", x, y, token)], metal: [elapsed("metal", x, y, token), elapsed("metal", x, y, token), elapsed("metal", x, y, token)]});
