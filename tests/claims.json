{
  "schema": 1,
  "scope": "Executable evidence for bounded claims. Passing tests are not a proof for all programs or environments.",
  "claims": [
    {
      "id": "http-tls-boundary",
      "claim": "The checked HTTP responses retain provenance, invalid framing fails, self-signed TLS requires an explicit opt-out, and C rejects a trusted certificate for the wrong hostname.",
      "authority": ["stdlib/http.lana", "spec/SPEC.md"],
      "evidence": ["tests/test_net_live.py", "tests/conformance/differential/net_live/http_pass.lana"],
      "ctest": ["net_live_conformance"],
      "requires": ["native", "net-live", "rust-no-tls"],
      "limitation": "These are loopback tests, not a guarantee for every remote server, certificate chain, or network failure. Transfer-coded responses are currently rejected, not decoded."
    },
    {
      "id": "state-semantics",
      "claim": "Construction, measurement, invert, neutralize, and independent append obey the checked numerical cases.",
      "authority": [
        "papers/semantics.md",
        "spec/SPEC.md"
      ],
      "evidence": [
        "tests/test_oracles.py",
        "tests/unit/test_runtime.c",
        "vm/rust/lana-vm/src/state.rs"
      ],
      "ctest": [
        "lana_independent_oracles",
        "lana_runtime_tests",
        "lana_mix_tests"
      ],
      "requires": [
        "native",
        "rust",
        "oracles-rust"
      ]
    },
    {
      "id": "tensor-numerics",
      "claim": "The checked tensor dtypes, shapes, matmul, and reductions agree with independent scalar arithmetic.",
      "authority": [
        "spec/SPEC.md",
        "spec/VM.md"
      ],
      "evidence": [
        "tests/test_oracles.py",
        "tests/unit/test_tensor.c",
        "tests/unit/test_linalg.c",
        "vm/rust/lana-vm/src/tensor.rs"
      ],
      "ctest": [
        "lana_tensor_tests",
        "lana_linalg_tests",
        "lana_independent_oracles"
      ],
      "requires": [
        "native",
        "rust",
        "differential",
        "oracles-rust"
      ]
    },
    {
      "id": "compiler-self-hosting",
      "claim": "Both VMs regenerate the checked compiler assembly twice within the fixed compiler budgets.",
      "authority": [
        "AGENTS.md",
        "spec/SYNTAX.md"
      ],
      "evidence": [
        "cmake/VerifyNativeBootstrap.cmake",
        "compiler/bootstrap/compiler.lasm"
