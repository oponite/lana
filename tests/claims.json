        "native_array_type_consistency_pass",
        "native_guarded_rebinding_pass"
      ],
      "requires": [
        "native",
        "bootstrap-rust"
      ]
    },
    {
      "id": "guarded-effects",
      "claim": "The checked unresolved branches reject mutation and effects without publishing partial output.",
      "authority": [
        "papers/semantics.md",
        "spec/SPEC.md"
      ],
      "evidence": [
        "tests/test_guarded_source.py",
