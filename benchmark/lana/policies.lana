// Hand-authored policy surface used for core-language complexity metrics.
// Data expansion is generated separately from the shared CSV.

fn minimal() {
    state belief = state { p: 0.50, d: 0.20 };
    state evidence = state { p: 0.72, d: 0.42, timestamp: 1, source: "alpha", weight: 1.0, confidence: 0.84 };
    apply evidence -> belief;
    return measure belief as probability;
}

fn intermediate() {
    state belief = state { p: 0.50, d: 0.20, timestamp: 1 };
    history belief latest 64;
    transform belief with decay(0.015);
    state alpha = state { p: 0.72, d: 0.42, timestamp: 1, source: "alpha", weight: 1.0, confidence: 0.84 };
    state beta = state { p: 0.61, d: 0.30, timestamp: 1, source: "beta", weight: 0.75, confidence: 0.68 };
    state gamma = state { p: 0.38, d: 0.36, timestamp: 1, source: "gamma", weight: 0.90, confidence: 0.78 };
    transform beta with decay(0.25);
    apply [alpha, beta, gamma] -> belief using weighted;
    let delta = change(belief);
    return measure belief as probability;
}

fn complex() {
    state a = state { p: 0.50, d: 0.35, weight: 1.0, confidence: 0.84 };
    state b = state { p: 0.50, d: 0.25, weight: 0.75, confidence: 0.68 };
    state c = state { p: 0.50, d: 0.30 };
    state target = state { p: 0.50, d: 0.15, timestamp: 1 };
    history target latest 64;
    state first = state { p: 0.72, d: 0.42 };
    state second = state { p: 0.61, d: 0.30 };
    state conditional = state { p: 0.38, d: 0.36 };
    transform a with decay(0.01);
    transform b with decay(0.01);
    transform c with decay(0.01);
    transform target with decay(0.01);
    apply first -> a;
    apply second -> b;
    apply [a, b] -> c using weighted;
    apply c -> target;
    if (c.p > 0.55) {
        apply conditional -> target;
    }
    return measure target as probability;
}

print(minimal());
print(intermediate());
print(complex());
