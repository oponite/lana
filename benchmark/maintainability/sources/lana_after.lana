state belief = state { p: 0.50, d: 0.20 };
state alpha = state { p: 0.80, d: 0.40, weight: 1.0, confidence: 0.80 };
state beta = state { p: 0.65, d: 0.30, weight: 0.7, confidence: 0.70 };
state gamma = state { p: 0.30, d: 0.35, weight: 0.9, confidence: 0.75 };
apply [alpha, beta, gamma] -> belief using weighted;
print(measure belief as probability);
