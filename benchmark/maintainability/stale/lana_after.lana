state belief = state { p: 0.50, d: 0.20 };
state evidence = state { p: 0.80, d: 0.40, timestamp: 0, confidence: 0.80 };
let now = 31;
if (now - evidence.timestamp > 30) {
    if (evidence.confidence <= 0.90) {
        transform evidence with decay(0.50);
    }
}
apply evidence -> belief;
print(measure belief as probability);
