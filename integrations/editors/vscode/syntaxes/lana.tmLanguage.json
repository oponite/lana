{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lana",
  "scopeName": "source.lana",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lana",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lana",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lana",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lana",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lana",
          "match": "\\b(?:if|else|while|for|match|return|yield|async|await|fork|join|cancel|taskgroup|import|as|in|with|history|transform|measure|estimate_measure|evidence|assume|observe|resolve|new|copies|implements|effects)\\b"
        },
        {
          "name": "storage.type.lana",
          "match": "\\b(?:let|fn|type|state|information|claim|planned_effect|value|class|interface|public|private|mutable|static|replace|Self|self|true|false|null)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)(\\s+)([a-z_][a-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.lana"
            },
            "3": {
              "name": "entity.name.function.lana"
            }
          }
        }
      ]
    }
  }
}
