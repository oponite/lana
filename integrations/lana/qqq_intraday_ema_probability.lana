import "./bridge.lana" as bridge;

// qqq_intraday_ema_probability — same-day directional signal for QQQ close
// above the prior close, derived from 15-minute EMA state. The logistic score
// is compared against a break-even threshold (where the isotonic up-rate
// crosses 0.5) to produce a bullish/bearish direction and a confidence tier.
// Advisory only; never authorizes an order.

// --- local numeric helpers (Lana's math module has no transcendentals) ---

fn abs_number(value) {
    if (value < 0) { return -value; }
    return value;
}

fn exp_approx(value) {
    if (value > 40) { value = 40; }
    if (value < -40) { value = -40; }
    let negative = value < 0;
    if (negative) { value = -value; }
    let halvings = 0;
    while (value > 0.5) {
        value = value / 2;
        halvings = halvings + 1;
    }
    let term = 1.0;
    let total = 1.0;
    let i = 1;
    while (i <= 14) {
        term = term * value / i;
        total = total + term;
        i = i + 1;
    }
    i = 0;
    while (i < halvings) {
        total = total * total;
        i = i + 1;
    }
    if (negative) { return 1.0 / total; }
    return total;
}

fn sigmoid(score) {
    return 1.0 / (1.0 + exp_approx(-score));
}

fn validate_model(model, order) {
    assert(array_length(order) == array_length(model["feature_order"]), "feature count mismatch");
    assert(array_length(order) == array_length(model["center"]), "model center mismatch");
    assert(array_length(order) == array_length(model["scale"]), "model scale mismatch");
    assert(array_length(order) == array_length(model["coefficients"]), "model coefficient mismatch");
    let index = 0;
    while (index < array_length(order)) {
        assert(order[index] == model["feature_order"][index], "feature order mismatch");
        assert(model["scale"][index] > 0, "model scale must be positive");
        index = index + 1;
    }
    return true;
}

fn infer_direction(request) {
    let model = request["model"];
    let order = request["feature_order"];
    validate_model(model, order);
    let score = model["intercept"];
    let index = 0;
    while (index < array_length(order)) {
        let value = request["features"][order[index]];
        assert(value == value, "feature is not a number");
        score = score + ((value - model["center"][index]) / model["scale"][index]) * model["coefficients"][index];
        index = index + 1;
    }
    let threshold = request["direction_threshold"];
    let reference_probability = sigmoid(score);
    let direction = "bearish";
    if (score > threshold) { direction = "bullish"; }
    let distance = abs_number(score - threshold);
    let confidence = "weak";
    if (distance >= 0.4) { confidence = "moderate"; }
    if (distance >= 1.0) { confidence = "strong"; }
    return {
        "direction": direction,
        "confidence": confidence,
        "reference_probability": reference_probability
    };
}

fn forecast(request) {
    assert(request["schema"] == 1, "unsupported schema");
    assert(request["kind"] == "qqq_intraday_ema_probability_request", "invalid request kind");
    assert(request["symbol"] == "QQQ", "request symbol must be QQQ");
    assert(request["historical_provider"] == "massive", "historical provider must be Massive");
    assert(request["live_provider"] == "yfinance", "live provider must be yfinance");
    assert(request["advisory_only"] == true, "forecast must be advisory-only");
    let signal = infer_direction(request);
    return {
        "schema": 1,
        "kind": "qqq_intraday_ema_probability_forecast",
        "symbol": "QQQ",
        "session_date": request["session_date"],
        "slot": request["slot"],
        "direction": signal["direction"],
        "confidence": signal["confidence"],
        "reference_probability": signal["reference_probability"],
        "historical_provider": "massive",
        "live_provider": "yfinance",
        "advisory_only": true
    };
}

let request = bridge.read_request();
bridge.write_response(forecast(request));
