fn read_request() {
    let argv = args();
    assert(array_length(argv) == 2, "bridge expects request and response paths");
    let parsed = json_parse(read_text(argv[0]));
    assert(parsed[0], "bridge request is invalid JSON");
    return parsed[1];
}

fn write_response(value) {
    let argv = args();
    assert(array_length(argv) == 2, "bridge expects request and response paths");
    write_text(argv[1], json_stringify(value));
    return true;
}
