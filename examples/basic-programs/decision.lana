import "std/decision" as decision;

let states = [{state: "rain", probability: 0.5}, {state: "dry", probability: 0.5}];
let actions = ["carry", "leave"];
let utility = [
    {action: "carry", state: "rain", value: 0},
    {action: "carry", state: "dry", value: 0},
    {action: "leave", state: "rain", value: -10},
    {action: "leave", state: "dry", value: 4}
];
let relationship = [
    {state: "rain", outcome: "wet", probability: 0.5},
    {state: "dry", outcome: "clear", probability: 0.5}
];
let observations = [
    {name: "forecast", joint: relationship},
    {name: "expensive", joint: relationship},
    {name: "unknown", joint: null}
];
let costs = [
    {observation: "forecast", value: 0.5},
    {observation: "expensive", value: 3},
    {observation: "unknown", value: 0}
];
let result = decision.value_of_information(states, observations, actions, utility, costs);
assert(array_length(result.recommended) == 1, "only positive net value is recommended");
assert(result.recommended[0] == "forecast", "declared forecast is recommended");
assert(result.candidates[0].net_value == 1.5, "positive net value");
assert(result.candidates[1].net_value == -1, "nonpositive candidate remains visible");
assert(result.candidates[2].status == "unknown_relationship", "missing joint is unscorable");
print("DECISION_PASS");
