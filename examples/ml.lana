let features = [[1, 2], [2, 4], [3, 6], [4, 8], [5, 10]];
let targets = [3, 5, 7, 9, 11];
let model = ml_fit_ridge(features, targets, 0.01);
let predictions = ml_predict(model, [[6, 12]]);
print(predictions[0]);
let expanded = ml_polynomial_features(features, 2);
print(expanded[0][3]);
let ignored = ml_model_write(model, "build-ml/test-model.ssml");
let restored = ml_model_read("build-ml/test-model.ssml");
let restored_prediction = ml_predict(restored, [[6, 12]]);
print(restored_prediction[0]);
