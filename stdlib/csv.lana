// std/csv — CSV text codecs (LIP-023 §5) plus file read/write.
// `parse(text)` returns Result<array<array<string>>, E> as a tagged pair
// `[true, rows]` / `[false, error]`; `stringify(rows)` returns deterministic
// text. `read`/`write` are the file-backed host calls.

fn read(path) {
    return csv_read(path);
}

fn write(path, rows) {
    return csv_write(path, rows);
}

// Quote a single field: wrap in double quotes when it contains a comma,
// quote, or newline, doubling any internal quote.
fn quote_field(field) {
    let needs_quote = false;
    let i = 0;
    let n = string_length(field);
    while (i < n) {
        let c = string_byte_at(field, i);
        if (c == 44) { needs_quote = true; }
        if (c == 34) { needs_quote = true; }
        if (c == 10) { needs_quote = true; }
        if (c == 13) { needs_quote = true; }
        i = i + 1;
    }
    if (!needs_quote) { return field; }
    let result = "\"";
    i = 0;
    while (i < n) {
        let c = string_byte_at(field, i);
        if (c == 34) { result = string_concat(result, "\"\""); }
        else { result = string_concat(result, string_slice(field, i, i + 1)); }
        i = i + 1;
    }
    return string_concat(result, "\"");
}

fn stringify(rows) {
    let result = "";
    let r = 0;
    while (r < array_length(rows)) {
        if (r > 0) { result = string_concat(result, "\n"); }
        let row = rows[r];
        let f = 0;
        while (f < array_length(row)) {
            if (f > 0) { result = string_concat(result, ","); }
            result = string_concat(result, quote_field(row[f]));
            f = f + 1;
        }
        r = r + 1;
    }
    return result;
}

fn parse(text) {
    let rows = array_new(0);
    let row = array_new(0);
    let field = "";
    let i = 0;
    let n = string_length(text);
    let in_quotes = false;
    while (i < n) {
        let c = string_byte_at(text, i);
        if (in_quotes) {
            if (c == 34) {
                if (i + 1 < n) {
                    if (string_byte_at(text, i + 1) == 34) {
                        field = string_concat(field, "\"");
                        i = i + 2;
                    } else {
                        in_quotes = false;
                        i = i + 1;
                    }
                } else {
                    in_quotes = false;
                    i = i + 1;
                }
            } else {
                field = string_concat(field, string_slice(text, i, i + 1));
                i = i + 1;
            }
        } else {
            if (c == 34) {
                in_quotes = true;
                i = i + 1;
            } else {
                if (c == 44) {
                    array_push(row, field);
                    field = "";
                    i = i + 1;
                } else {
                    if (c == 10) {
                        array_push(row, field);
                        array_push(rows, row);
                        row = array_new(0);
                        field = "";
                        i = i + 1;
                    } else {
                        if (c == 13) {
                            i = i + 1;
                        } else {
                            field = string_concat(field, string_slice(text, i, i + 1));
                            i = i + 1;
                        }
                    }
                }
            }
        }
    }
    if (in_quotes) { return result_error("unterminated quoted field"); }
    if (string_length(field) > 0) {
        array_push(row, field);
        array_push(rows, row);
    } else {
        if (array_length(row) > 0) { array_push(rows, row); }
    }
    return result_ok(rows);
}
